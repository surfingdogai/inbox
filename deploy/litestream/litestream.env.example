# Litestream's settings, apart from the inbox's own so its keys never reach the inbox's container.
# Any S3-compatible storage: a bucket of its own, and a key that can read and write only that bucket.
LITESTREAM_BUCKET=
# For storage other than AWS, its S3 endpoint, like https://<account>.r2.cloudflarestorage.com.
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
