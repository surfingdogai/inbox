# The inbox's settings, read by docker-compose.yml. The installer writes this file for you, readable
# by root only. Keep a copy of it somewhere safe, apart from the server: INBOX_SECRET_KEY opens what
# the database keeps sealed, and a backup restores fully only with it.

# The address the inbox answers at, like inbox.yourbusiness.com. Its DNS record points at this server.
INBOX_DOMAIN=
# Only this address can sign in the first time. Several, comma-separated: the first to sign in is the owner.
INBOX_OWNER_EMAIL=
# Seals stored secrets and signs receipts. Generate it, never invent it: openssl rand -base64 32
INBOX_SECRET_KEY=
# The version to run; `inbox update` changes it. Pinned, so a restart never moves to another version.
INBOX_VERSION=0.2.0

# Email out, optional. Without it, the sign-in email is written to the inbox's log
# (`sudo inbox sign-in` shows it) and no other email is sent. `sudo inbox email` sets these for you.
# MAIL_FROM=inbox@yourbusiness.com
# Through Cloudflare Email Service, from a domain onboarded there:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_TOKEN=
# Or through Resend, from a domain verified there:
# RESEND_API_KEY=
