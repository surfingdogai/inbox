{
  "$schema": "apps/inbox/node_modules/wrangler/config-schema.json",
  "name": "surfingdog-inbox",
  "main": "apps/inbox/src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // The SPA and public files. API, MCP and discovery paths are answered by the Worker first.
  "assets": {
    "directory": "apps/inbox/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/v1/*",
      "/mcp",
      "/mcp/*",
      "/auth/*",
      "/oauth/*",
      "/openapi.json",
      "/.well-known/*",
      "/healthz",
      "/c/*",
      "/demo/*"
    ]
  },
  // This file is a template. The Deploy to Cloudflare button creates the database and the queue from
  // the names below and writes the new database's id in place of the zeros; by hand, `wrangler d1
  // create` prints the id to paste. One business = one database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "surfingdog-inbox",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "apps/inbox/migrations"
    }
  ],
  // Email out through Cloudflare Email Sending. It sends from MAIL_FROM, which must be on a domain
  // onboarded to Email Sending on the same account. Without that, sign-in links go to the logs.
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "surfingdog-inbox-jobs" }],
    "consumers": [{ "queue": "surfingdog-inbox-jobs", "max_batch_size": 10, "max_retries": 3 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "INBOX_ENV": "development" }
}
