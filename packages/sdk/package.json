{
  "name": "@surfingdog/sdk",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Verify Surfing Dog Inbox webhooks and type their events. Standard Webhooks over WebCrypto: no dependencies, runs unchanged on Node, Workers, Deno, Bun and in the browser.",
  "keywords": [
    "webhook",
    "webhooks",
    "standard-webhooks",
    "webhook-verification",
    "hmac",
    "signature",
    "surfingdog",
    "inbox",
    "bookings",
    "orders",
    "agents"
  ],
  "homepage": "https://surfingdog.ai/docs/webhooks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surfingdogai/inbox.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/surfingdogai/inbox/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
