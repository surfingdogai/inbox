    },
    "AU": {
      "name": "Australia",
      "law": "Food Standards Code, Standard 1.2.3 (section 1.2.3-4), required names under plain English allergen labelling from 25 February 2024",
      "source": "https://www.safefood.qld.gov.au/?p=24592"
    },
    "NZ": {
      "name": "New Zealand",
      "law": "Food Standards Code, Standard 1.2.3 (section 1.2.3-4), required names under plain English allergen labelling from 25 February 2024",
      "source": "https://www.foodstandards.gov.au/peal"
    },
    "JP": {
      "name": "Japan",
      "law": "Consumer Affairs Agency: 特定原材料 (nine to be declared) and 特定原材料に準ずるもの (twenty asked for), as of April 2026; possibility statements such as \"may contain\" are not allowed on packaged food",
