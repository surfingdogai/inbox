{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfingdog.ai/spec/schemas/receipt-v1.json",
  "title": "Receipt claims, v1 (ADR-016)",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "format": "uri"
    },
    "sub": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64
    },
    "itm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "typ": {
      "type": "string",
      "enum": ["message", "quote_request", "booking", "order", "refund", "stay"]
    },
    "knd": {
      "type": "string",
      "enum": ["confirmed", "paid"]
    },
    "iat": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Issued at, Unix seconds."
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "amt": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Minor units of the currency's own ISO 4217 exponent (minorUnits): 4500 is CA$45.00 or ₹45.00, ¥4,500 in JPY, 4.500 in KWD."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        }
      },
      "required": ["value", "currency"]
    },
    "pay": {
      "description": "How it was paid, when the instance knows.",
      "type": "string",
      "maxLength": 40
    }
  },
  "required": ["iss", "sub", "itm", "typ", "knd", "iat", "nonce"]
}
