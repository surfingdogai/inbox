{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP get_business: structuredContent",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "description": "The business's own domain, where its inbox is."
    },
    "name": {
      "type": "string",
      "description": "As the business wrote it."
    },
    "description": {
      "description": "As the business wrote it.",
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "description": "ISO 3166-1 alpha-2.",
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "distance_km": {
      "description": "Searches near a point only.",
      "type": "number",
      "minimum": 0
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Slugs of the categories list."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other words the business gave for what it does."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "takes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What its inbox takes: booking, order, quote_request, message, refund."
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": ["booking", "order", "quote_request"]
          }
        },
        "required": ["name", "type"]
      },
      "description": "Names and how each is taken; prices, durations and free times are at its inbox."
    },
    "open_now": {
      "description": "Open at the moment of the answer by the hours it published, in its own time zone; null when it published none.",
      "type": ["boolean", "null"]
    },
    "hours_today": {
      "description": "Today's hours in its own time zone, like \"09:00–13:00, 14:00–19:00\", or \"closed today\"; null when it published none.",
      "type": ["string", "null"]
    },
    "answering": {
      "type": "boolean",
      "description": "Its inbox answered this network within the last day."
    },
    "inbox": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "mcp": {
          "description": "Where an assistant books, orders or asks.",
          "type": "string",
          "format": "uri"
        },
        "rest": {
          "type": "string",
          "format": "uri"
        },
        "openapi": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["url"],
      "description": "The business's own inbox: go there to book, order or ask. This directory takes nothing."
    },
    "standing": {
      "description": "From the last nightly count of the promises it kept; absent while the directory's order is neutral.",
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["new", "building", "trusted"]
        },
        "ranked": {
          "type": "boolean",
          "description": "Its record puts it before the daily shuffle."
        },
        "in_words": {
          "type": "string",
          "description": "The tier in one plain sentence; never a mark against the business."
        }
      },
      "required": ["tier", "ranked", "in_words"]
    },
    "listing_url": {
      "type": "string",
      "format": "uri",
      "description": "Its full listing on this network (GET /v1/businesses/{domain})."
    },
    "address": {
      "description": "The street only when the business published one.",
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "locality": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      }
    },
    "hours": {
      "description": "The whole week, and the closures that have not ended.",
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string"
        },
        "weekly": {
          "type": "object",
          "properties": {
            "mon": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "tue": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "wed": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "thu": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "fri": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "sat": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "sun": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "closures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "to": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": ["from", "to"]
          }
        }
      },
      "required": ["timezone", "weekly", "closures"]
    },
    "outcomes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "booking.completed",
          "order.fulfilled",
          "booking.cancelled_by_business",
          "order.not_fulfilled",
          "booking.no_show_business",
          "order.not_received",
          "promise.unclosed",
          "booking.no_show_customer",
          "booking.cancelled_late_by_customer",
          "order.payment_failed",
          "order.charged_back",
          "booking.cancelled_by_customer",
          "order.cancelled_by_customer",
          "order.lapsed"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "description": "How many of the promises made at this business closed with each outcome (ADR-017 §3)."
    }
  },
  "required": [
    "domain",
    "name",
    "categories",
    "tags",
    "languages",
    "takes",
    "services",
    "open_now",
    "hours_today",
    "answering",
    "inbox",
    "listing_url",
    "outcomes"
  ]
}
