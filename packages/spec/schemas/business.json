{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfingdog.ai/spec/schemas/business.json",
  "title": "GET /v1/businesses/{domain}",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "description": "ISO 3166-1 alpha-2.",
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "locality": {
          "type": "string"
        },
        "postal_code": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Slugs of the categories list (GET /v1/categories)."
    },
    "tags": {
      "description": "What the profile named that is not in the categories list (A2.5).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "item_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protocols": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Protocol name → entry URL."
    },
    "hours": {
      "description": "Absent when the business published none, or none the network could read.",
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string"
        },
        "weekly": {
          "type": "object",
          "properties": {
            "mon": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "tue": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "wed": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "thu": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "fri": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "sat": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "sun": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|24:00)$"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "closures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "to": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": ["from", "to"]
          }
        }
      },
      "required": ["timezone", "weekly", "closures"]
    },
    "open_now": {
      "description": "Open at the moment of the answer by the hours it published, in its own zone, a closure winning; null when it published none. A cached answer may be minutes old.",
      "type": ["boolean", "null"]
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": ["booking", "order", "quote_request"]
          }
        },
        "required": ["name", "type"]
      }
    },
    "geo": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "required": ["lat", "lng"]
    },
    "distance_km": {
      "description": "Near searches only.",
      "type": "number",
      "minimum": 0
    },
    "url": {
      "type": "string"
    },
    "manifest_url": {
      "description": "Always present for a member.",
      "type": "string",
      "format": "uri"
    },
    "verified_at": {
      "description": "Always present for a member.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "last_ping_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "software": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      }
    },
    "receipts": {
      "type": "object",
      "properties": {
        "issued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Promises only."
        },
        "acknowledged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Promises an acknowledgement came with; from rules version 8, receipts an acknowledgement the network verified backs."
        },
        "customers": {
          "description": "On the detail: the distinct subs its promises name. From rules version 8 absent when self_reported.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["issued", "acknowledged"]
    },
    "answering": {
      "type": "boolean",
      "description": "A ping, signed or not, within 24 h and no failed manifest sweep since."
    },
    "online": {
      "type": "boolean",
      "description": "An alias of answering."
    },
    "not_answering_since": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rank_pos": {
      "description": "Position in the hourly snapshot's order.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rank_shuffle": {
      "description": "The first 16 hex digits of SHA-256(\"<YYYY-MM-DD>:<business uuid>\"): a string, never a number.",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "reputation": {
      "type": "object",
      "properties": {
        "ranked": {
          "type": "boolean",
          "description": "score ≥ 0.40 (building): sorts before the daily shuffle; from rules version 8 only with verified_kept_share ≥ 0.2, as shown."
        },
        "score": {
          "description": "Absent from rules version 8 when self_reported: a record that rests on the business's own word alone has no score.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tier": {
          "type": "string",
          "enum": ["new", "building", "trusted"]
        },
        "kept": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "broken": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "open": {
          "description": "From rules version 8: its v2 promises still open (issued, not yet closed by an outcome and not unclosed). Never scored.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "customers": {
          "description": "Distinct customers (§5.3). From rules version 8 absent when self_reported: the business chooses them.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "verified_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The share of weight from verified evidence, reports included."
        },
        "verified_kept_share": {
          "description": "From rules version 8: the share of weight from kept outcomes a verified acknowledgement backs. Ranked and scored from 0.2, as shown (four decimals).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "self_reported": {
          "description": "From rules version 8, true when the record rests on the business's own word (verified_kept_share below 0.2): not ranked, tier new, no score, no customers, and its counts are the business's own word.",
          "type": "boolean"
        },
        "rules": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The rules version that ordered this listing."
        },
        "rules_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["ranked", "tier", "kept", "broken", "verified_share", "rules"]
    },
    "track_record": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["held", "none", "pending", "gathering", "shown"],
          "description": "held: a new member's 30 days after it joins, when nothing is counted; none: no receipts yet; pending: receipts the next nightly count reaches; gathering: fewer closed promises, or customers, than threshold; shown: the record."
        },
        "in_words": {
          "type": "string",
          "description": "The record in one or two plain sentences, with how many of its closed promises the customer's side confirmed; the rest are the business's own word."
        },
        "as_of": {
          "description": "The nightly count it is from (00:00 UTC).",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "held_until": {
          "description": "held: the night its record is counted from.",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "self_reported": {
          "description": "gathering and shown, from rules version 8: the record rests on the business's own word (less than a fifth of it is kept outcomes a verified acknowledgement backs, as its reputation's self_reported), so it has no customers, and its threshold none.",
          "type": "boolean"
        },
        "closed": {
          "description": "gathering and shown: kept plus broken.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "customers": {
          "description": "gathering and shown, unless self_reported: the distinct customers the closed promises came from, as its receipts name them (the customer's mailbox when known, else, before rules version 8, the receipt's sub; from rules version 8 a sub that names no person is never a customer, and every receipt at a business that names nobody is one anonymous customer). Not reputation.customers, which counts only customers this network can tell apart.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kept": {
          "description": "shown.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "broken": {
          "description": "shown: closed as not kept by the business or by a customer's report that stands, left open 9 days past due, or a refund paid late.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "open": {
          "description": "shown, from rules version 8: its v2 promises still open (reputation.open).",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unclosed": {
          "description": "shown, of broken: left open 9 days past due (promise.unclosed).",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "refunds_late": {
          "description": "shown, of broken: refunds paid late (refund.late).",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "from": {
          "description": "shown: the earliest day of the evidence counted, at 00:00 UTC (a day, never the moment of a promise).",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "to": {
          "description": "shown: the latest day of the evidence counted, at 00:00 UTC (a day, never the moment of a promise).",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "confirmed": {
          "description": "shown: how many of the closed are kept outcomes a verified acknowledgement backs, confirmed by the customer's side (a customer's report is not a confirmation); the rest are the business's own word.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "confirmable": {
          "description": "shown: whether this network can verify any acknowledgement yet (a recognised platform's agent key, or an established person's).",
          "type": "boolean"
        },
        "threshold": {
          "description": "What a record shows from: closed promises, from customers distinct customers; a self_reported record is not asked for customers, and has none here.",
          "type": "object",
          "properties": {
            "closed": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "customers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["closed"]
        },
        "rules_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["state", "in_words"],
      "description": "A member's track record, from the same nightly count as its standing and shown under the same rules: the promises it kept and broke, and when. From rules version 8, one that rests on the business's own word is self_reported: its counts, with no score and no count of customers. Only what its state can say is present; a business that is not a member has none."
    },
    "source": {
      "description": "member: through its inbox; registered: by the business, with a proof; found: by the network's crawler.",
      "type": "string",
      "enum": ["member", "registered", "found"]
    },
    "claimed": {
      "type": "boolean"
    },
    "proof": {
      "type": "string",
      "enum": ["domain", "key", "platform", "code"]
    },
    "level": {
      "description": "The highest level of its live doors (§4.9).",
      "type": "string",
      "enum": ["listed", "readable", "askable", "bookable", "orderable", "payable"]
    },
    "has_inbox": {
      "description": "It has an inbox door: ours or any compatible inbox.",
      "type": "boolean"
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^(inbox|mcp|a2a|openapi|api|ucp|acp|nlweb|webhook|other|platform:[a-z0-9-]{1,40})$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "level": {
            "type": "string",
            "enum": ["listed", "readable", "askable", "bookable", "orderable", "payable"],
            "description": "What this door alone reaches, from the network's own probe."
          },
          "status": {
            "type": "string",
            "enum": ["live", "failing"],
            "description": "failing: 3 failures in 7 days; it counts for nothing until it works."
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["ask", "quote", "book", "order", "pay"]
            }
          },
          "src": {
            "type": "string",
            "enum": ["declared", "seen"],
            "description": "declared: the business said so; seen: read from the door's own tools."
          },
          "protocol": {
            "description": "The protocol it speaks, for type \"other\" only.",
            "type": "string",
            "maxLength": 40
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "checked": {
            "description": "A member's inbox door, on its detail: what the network's own reads last found in the past 24 hours (§4.8). answered; failing; could_not_check, the door refused the read (403, 429, a challenge page), so the business's signed ping alone says it answers. Absent when the network made no read.",
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["answered", "failing", "could_not_check"]
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "by": {
                "type": "string",
                "const": "network"
              }
            },
            "required": ["status", "at", "by"]
          }
        },
        "required": ["type", "url", "level", "status", "kinds", "src"]
      }
    },
    "requestable": {
      "description": "The kinds a live door declared it answers; never from what the crawler saw alone.",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ask", "quote"]
      }
    },
    "accepts": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ask", "quote", "book", "order", "pay"]
          }
        },
        "pay": {
          "description": "Payment tokens of GET /v1/attributes' payments.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["kinds"]
    },
    "category": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "src": {
              "type": "string",
              "enum": ["declared", "seen", "probably"]
            }
          },
          "required": ["id", "label", "src"]
        },
        "alternates": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "src": {
                "type": "string",
                "enum": ["declared", "seen", "probably"]
              }
            },
            "required": ["id", "label", "src"]
          }
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ancestor ids of the primary, root first, the primary last."
        },
        "group": {
          "description": "Its group: a slug of GET /v1/categories.",
          "type": "string"
        }
      },
      "required": ["primary", "alternates", "path"]
    },
    "attributes": {
      "description": "Keys of GET /v1/attributes.",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "v": {
            "type": ["boolean", "string", "number"]
          },
          "src": {
            "type": "string",
            "enum": ["declared", "seen", "probably"]
          }
        },
        "required": ["v", "src"]
      }
    },
    "place": {
      "description": "For entries that are not members; a member keeps city, country and address.",
      "type": "object",
      "properties": {
        "locality": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "country": {
          "description": "ISO 3166-1 alpha-2.",
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["storefront", "service_area", "online"]
          }
        },
        "service_area": {
          "type": "object",
          "properties": {
            "radius_km": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 300
            },
            "countries": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              }
            }
          }
        },
        "ships_to": {
          "description": "ISO 3166-1 alpha-2 codes, or [\"*\"] for anywhere.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["kind"]
    },
    "why": {
      "description": "Why it is in this place of the list, in plain words.",
      "type": "string"
    },
    "found": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string",
          "description": "\"found on its own website · not a member · checked <YYYY-MM-DD>\""
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "about_url": {
          "type": "string",
          "format": "uri",
          "description": "The network's page for businesses: why it is here, and how to correct it or opt out."
        }
      },
      "required": ["note", "checked_at", "about_url"]
    },
    "outcomes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "booking.completed",
          "order.fulfilled",
          "booking.cancelled_by_business",
          "order.not_fulfilled",
          "booking.no_show_business",
          "order.not_received",
          "promise.unclosed",
          "booking.no_show_customer",
          "booking.cancelled_late_by_customer",
          "order.payment_failed",
          "order.charged_back",
          "booking.cancelled_by_customer",
          "order.cancelled_by_customer",
          "order.lapsed",
          "refund.honoured",
          "refund.late",
          "refund.cancelled_by_customer",
          "order.refund_refused"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "facts": {
      "description": "Every displayed value of an entry that is not a member, with its source and date (§4.11).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "v": {},
          "src": {
            "type": "string",
            "enum": ["declared", "seen", "probably"]
          },
          "url": {
            "description": "The page or door it was read from.",
            "type": "string",
            "format": "uri"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "via": {
            "type": "string"
          }
        },
        "required": ["field", "v", "src", "at"]
      }
    },
    "door_history": {
      "description": "The history of the doors this listing shows (§4.8).",
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "description": "The UTC day it was read on."
        },
        "doors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^(inbox|mcp|a2a|openapi|api|ucp|acp|nlweb|webhook|other|platform:[a-z0-9-]{1,40})$"
              },
              "host": {
                "type": "string",
                "description": "The door's host, lower case."
              },
              "first_seen": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "The first UTC day a read of the network's found a door of this type at this host answering."
              },
              "last_seen": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                "description": "The last such day."
              },
              "days_seen": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "On how many days a read of the network's found it answering: a door read about once a month is seen on few days, and nothing is said of the days between."
              },
              "current": {
                "type": "boolean",
                "description": "Whether a door of this type is at this host now (not gone)."
              },
              "checks": {
                "description": "A door the network reads every day (a member's, a claimed listing's), from 14 checked days.",
                "type": "object",
                "properties": {
                  "first_checked": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                    "description": "The first day checked."
                  },
                  "last_checked": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                    "description": "The last day checked."
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991,
                    "description": "Days checked: days on which the network's daily read of the door concluded. A read an agent's report or the business asked for is no check."
                  },
                  "answered": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Of them, days on which every check answered: one missed check (failed, or blocked while the door is down by the network's reads) makes the day missed, and one refused check (blocked otherwise) makes it refused."
                  },
                  "refused": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Of them, days on which a check was refused and none was missed: never answered days."
                  },
                  "recent": {
                    "type": "string",
                    "pattern": "^[axb.]{90}$",
                    "description": "The last 90 days ending on as_of, oldest first: a every check answered, x one was missed, b one was refused and none missed, . no check that day."
                  }
                },
                "required": ["first_checked", "last_checked", "days", "answered", "refused", "recent"]
              },
              "summary": {
                "description": "With checks, in English: \"Answered every check on 41 of 42 days checked since 3 Oct 2026 (97%).\", the share floored, the days refused after it (\"(75%; refused our check on 5)\"), \"from … to …\" when the last check is more than 7 days old. Informative: another network may word it its own way.",
                "type": "string"
              }
            },
            "required": ["type", "host", "first_seen", "last_seen", "days_seen", "current"]
          }
        }
      },
      "required": ["as_of", "doors"]
    },
    "report": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "description": "The MCP tool that takes door reports: report_door."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The same over REST: POST <network>/v1/door-reports."
        },
        "guide": {
          "type": "string",
          "format": "uri",
          "description": "How to report, for an agent: <network>/report.md."
        },
        "reward": {
          "type": "string",
          "description": "What the agent gets for reporting, in one sentence."
        }
      },
      "required": ["tool", "url", "guide", "reward"],
      "description": "Report how each use of a door went, done or not: see the guide."
    }
  },
  "required": [
    "domain",
    "name",
    "categories",
    "languages",
    "item_types",
    "protocols",
    "receipts",
    "answering",
    "online",
    "not_answering_since",
    "outcomes"
  ]
