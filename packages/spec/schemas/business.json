{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /v1/businesses/{domain}",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "country": {
      "description": "ISO 3166-1 alpha-2.",
      "type": "string",
      "minLength": 2,
      "maxLength": 2
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "item_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protocols": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Protocol name → entry URL."
    },
    "geo": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "required": ["lat", "lng"]
    },
    "distance_km": {
      "description": "Near searches only.",
      "type": "number",
      "minimum": 0
    },
    "url": {
      "type": "string"
    },
    "manifest_url": {
      "type": "string",
      "format": "uri"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "last_ping_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "software": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      }
    },
    "receipts": {
      "type": "object",
      "properties": {
        "issued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Promises only."
        },
        "acknowledged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "customers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["issued", "acknowledged"]
    },
    "answering": {
      "type": "boolean",
      "description": "A ping, signed or not, within 24 h and no failed manifest sweep since."
    },
    "online": {
      "type": "boolean",
      "description": "An alias of answering."
    },
    "not_answering_since": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "rank_pos": {
      "description": "Position in the hourly snapshot's order.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rank_shuffle": {
      "description": "The first 16 hex digits of SHA-256(\"<YYYY-MM-DD>:<business uuid>\"): a string, never a number.",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "reputation": {
      "type": "object",
      "properties": {
        "ranked": {
          "type": "boolean",
          "description": "score ≥ 0.40 (building): sorts before the daily shuffle."
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tier": {
          "type": "string",
          "enum": ["new", "building", "trusted"]
        },
        "kept": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "broken": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "customers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Distinct customers (§5.3)."
        },
        "verified_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The share of weight from verified evidence."
        },
        "rules": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The rules version that ordered this listing."
        },
        "rules_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["ranked", "score", "tier", "kept", "broken", "customers", "verified_share", "rules"]
    },
    "outcomes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "booking.completed",
          "order.fulfilled",
          "booking.cancelled_by_business",
          "order.not_fulfilled",
          "booking.no_show_business",
          "order.not_received",
          "promise.unclosed",
          "booking.no_show_customer",
          "booking.cancelled_late_by_customer",
          "order.payment_failed",
          "order.charged_back",
          "booking.cancelled_by_customer",
          "order.cancelled_by_customer",
          "order.lapsed"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "domain",
    "name",
    "categories",
    "languages",
    "item_types",
    "protocols",
    "manifest_url",
    "verified_at",
    "receipts",
    "answering",
    "online",
    "not_answering_since",
    "outcomes"
  ]
}
