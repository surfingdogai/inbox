{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acknowledgement claims (ADR-016)",
  "type": "object",
  "properties": {
    "rcp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The receipt's id on the issuing instance."
    },
    "sha": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url(SHA-256(receipt JWS))."
    },
    "iat": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["rcp", "sha", "iat"]
}
