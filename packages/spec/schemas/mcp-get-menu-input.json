{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP get_menu: arguments",
  "type": "object",
  "properties": {
    "daypart": {
      "description": "Only what is served in this daypart.",
      "type": "string",
      "maxLength": 40
    },
    "section": {
      "description": "Only this section, by its id or name.",
      "type": "string",
      "maxLength": 120
    },
    "at": {
      "description": "What is available at this instant; default now.",
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
