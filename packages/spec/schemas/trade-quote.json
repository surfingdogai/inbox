{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfingdog.ai/spec/schemas/trade-quote.json",
  "title": "A trade's quote: kind, stages, call-out and visit fees, tax",
  "type": "object",
  "properties": {
    "kind": {
      "default": "fixed",
      "type": "string",
      "enum": ["estimate", "fixed"]
    },
    "stages": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "type": {
            "type": "string",
            "enum": ["immediate", "deferred", "at_property"]
          },
          "amount": {
            "type": "object",
            "properties": {
              "value": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Minor units of the currency's own ISO 4217 exponent (minorUnits): 4500 is 45.00 KES, ¥4,500 JPY, 4.500 KWD."
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3
              }
            },
            "required": ["value", "currency"]
          },
          "due_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": ["id", "type", "amount"]
      }
    },
    "callOutFee": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Minor units of the currency's own ISO 4217 exponent (minorUnits): 4500 is 45.00 KES, ¥4,500 JPY, 4.500 KWD."
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            }
          },
          "required": ["value", "currency"]
        },
        "creditedIfAccepted": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": ["amount"]
    },
    "visitFee": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Minor units of the currency's own ISO 4217 exponent (minorUnits): 4500 is 45.00 KES, ¥4,500 JPY, 4.500 KWD."
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            }
          },
          "required": ["value", "currency"]
        },
        "creditedIfAccepted": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": ["amount"]
    },
    "tax": {
      "type": "object",
      "properties": {
        "included": {
          "type": "boolean"
        },
        "lines": {
          "description": "When included is false: the tax on top of the prices, at least one line; part of the total.",
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "amount": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "description": "Minor units of the currency's own ISO 4217 exponent (minorUnits): 4500 is 45.00 KES, ¥4,500 JPY, 4.500 KWD."
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                  }
                },
                "required": ["value", "currency"]
              }
            },
            "required": ["name", "amount"]
          }
        }
      },
      "required": ["included"]
    }
  }
}
