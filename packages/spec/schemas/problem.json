{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RFC 9457 problem with a code",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "code": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string"
    }
  },
  "required": ["type", "title", "status"]
}
