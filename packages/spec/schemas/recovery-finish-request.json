{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfingdog.ai/spec/schemas/recovery-finish-request.json",
  "title": "POST /v1/recovery/finish",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "maxLength": 320
    },
    "code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "purpose": {
      "type": "string",
      "enum": ["recover", "sign_in"]
    }
  },
  "required": ["email", "code", "purpose"]
}
