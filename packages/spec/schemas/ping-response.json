{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/instances/{domain}/ping: a signed ping's 200",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "rules": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "effective_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["version", "effective_at"],
      "description": "The rules in force."
    },
    "next_rules": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "effective_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": ["version", "effective_at", "url"]
        },
        {
          "type": "null"
        }
      ],
      "description": "Rules announced and not yet in force, or null."
    },
    "reports": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "receipt_sha": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "out": {
            "type": "string",
            "enum": ["booking.no_show_business", "order.not_received", "order.refund_refused"]
          },
          "why": {
            "type": "string",
            "enum": [
              "closed",
              "no_one_there",
              "not_delivered",
              "other",
              "withdrawal_refused",
              "faulty_refused",
              "goods_disputed_unpaid"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "respond_by": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "receipt_sha", "out", "why", "created_at", "respond_by"]
      }
    },
    "contests": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          },
          "out": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "respond_by": {
            "description": "The last moment the business may dispute it: 14 days after it was filed, or after rules version 5 took effect for one filed before. A network before Amendment 2 sends none.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "evidence_id", "out", "created_at"]
      }
    },
    "standing": {
      "description": "The business's standing in the last nightly snapshot; absent from a directory-level network (§10), which keeps none.",
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "What its record scores, its own word included."
        },
        "tier": {
          "type": "string",
          "enum": ["new", "building", "trusted"]
        },
        "ranked": {
          "type": "boolean",
          "description": "score_int ≥ 4000 (building): sorts before the newcomers' shuffle; from rules version 8 only with verified evidence."
        }
      },
      "required": ["score", "tier", "ranked"]
    },
    "listing": {
      "description": "Whether the business is in the directory (A2.3–A2.4).",
      "type": "object",
      "properties": {
        "listed": {
          "type": "boolean"
        },
        "delisted_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ],
          "description": "When it left the directory, or null."
        },
        "dormant_since": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ],
          "description": "When it was set aside because its inbox had not answered for 90 days, or null."
        }
      },
      "required": ["listed", "delisted_at", "dormant_since"]
    },
    "doors": {
      "description": "How agents got on at the business's own doors, and what the network's own reads saw (§4.15); absent from a network that takes no door reports.",
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "description": "The last day the counts include, in UTC."
        },
        "doors": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["live", "failing", "gone"],
                "description": "From the network's own reads only."
              },
              "checked": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "result": {
                        "type": "string",
                        "enum": ["good", "failed", "blocked"]
                      },
                      "at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                        "description": "To the hour."
                      }
                    },
                    "required": ["result", "at"]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The network's own last read of this door; blocked: its read was refused (403, 429, a challenge)."
              },
              "reports": {
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string"
                    },
                    "tool": {
                      "type": "string"
                    },
                    "proof": {
                      "type": "string",
                      "enum": ["token", "none"],
                      "description": "token: signed by your door; none: agents the network cannot tell apart."
                    },
                    "result": {
                      "type": "string",
                      "enum": ["ok", "refused", "invalid", "fail", "info"]
                    },
                    "class": {
                      "type": "string"
                    },
                    "d7": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "In the 7 days to as_of."
                    },
                    "d30": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "In the 30 days to as_of."
                    }
                  },
                  "required": ["op", "proof", "result", "d7", "d30"]
                }
              },
              "platforms": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Agent platforms' origins with 5 or more distinct sources reporting here in 30 days."
              }
            },
            "required": ["type", "url", "status", "checked", "reports", "platforms"]
          }
        },
        "incidents": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "class": {
                "type": "string"
              },
              "opened_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "description": "To the hour."
              },
              "reproduced": {
                "type": "boolean",
                "description": "Whether the network's own read saw it too."
              },
              "public_from": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "When it may first show publicly, if it still holds then; null when it never will."
              }
            },
            "required": ["id", "type", "url", "class", "opened_at", "reproduced", "public_from"]
          },
          "description": "Open incidents, from the network's own reads or from door-signed failures of independent sources."
        },
        "trouble": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "since": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "description": "To the hour."
              }
            },
            "required": ["type", "url", "since"]
          },
          "description": "Doors agents report trouble at that the network's own reads do not see."
        },
        "fixes": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "class": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": ["class", "text"]
          },
          "description": "One plain line per class there is trouble with: what to fix."
        }
      },
      "required": ["as_of", "doors", "incidents", "trouble", "fixes"]
    }
  },
  "required": ["ok", "rules", "next_rules", "reports", "contests"]
}
