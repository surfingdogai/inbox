{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfingdog.ai/spec/schemas/census-edition.json",
  "title": "GET /v1/census/{edition}: one month of the census, as counts (ODbL)",
  "type": "object",
  "properties": {
    "edition": {
      "type": "string",
      "pattern": "^20\\d\\d-(0[1-9]|1[0-2])$",
      "description": "The month the edition records, YYYY-MM."
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "withdrawn"],
      "description": "A draft is served to the network's operators only; a published or withdrawn one to everyone."
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "When the counts were taken."
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ],
      "description": "Why a withdrawn edition was withdrawn, or anything a reader must know; null when there is nothing."
    },
    "method": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The method in words, with the edition."
        },
        "min_sample": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "A country, kind of business, platform or city is published only with at least this many checked."
        }
      },
      "required": ["version", "url", "min_sample"]
    },
    "vocabulary": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["version", "url"],
      "description": "The capability vocabulary counted."
    },
    "score_rules": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "The score rules version the capabilities' states were read under."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "find",
          "catalogue",
          "availability",
          "message",
          "negotiate",
          "book",
          "order",
          "signup",
          "pay",
          "change",
          "cancel",
          "track",
          "return",
          "receipt",
          "feedback",
          "subscription",
          "vouchers",
          "waitlist",
          "support",
          "policies"
        ]
      },
      "description": "The capabilities counted, in vocabulary order."
    },
    "doors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The door types counted."
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The readiness levels counted, lowest first."
    },
    "left_out": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["all", "country", "group", "platform", "city"]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "description": "How many keys of each scope had fewer checked than min_sample, and are not in rows."
    },
    "licence": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "ODbL-1.0"
        },
        "url": {
          "type": "string",
          "const": "https://opendatacommons.org/licenses/odbl/1-0/"
        },
        "attribution": {
          "type": "string",
          "description": "How to credit it: \"Surfing Dog (surfingdog.ai)\"."
        }
      },
      "required": ["name", "url", "attribution"]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": ["all", "country", "group", "platform", "city"]
          },
          "key": {
            "type": "string",
            "maxLength": 64,
            "description": "The scope's key: empty for all."
          },
          "metric": {
            "type": "string",
            "pattern": "^(checked|agent_ready|places|can:[a-z]+|door:[a-z0-9_]+|level:[a-z]+)$",
            "description": "checked, agent_ready, can:<capability>, door:<door type>, level:<level name>, or for a city places."
          },
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["scope", "key", "metric", "value"]
      }
    }
  },
  "required": [
    "edition",
    "title",
    "status",
    "as_of",
    "published_at",
    "note",
    "method",
    "vocabulary",
    "score_rules",
    "capabilities",
    "doors",
    "levels",
    "left_out",
    "licence",
    "rows"
  ]
}
