{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /leaderboard.json",
  "type": "object",
  "properties": {
    "scope": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "can": {
          "description": "A home-page list: the agent-ready businesses that can do this.",
          "type": "string",
          "enum": [
            "message",
            "book",
            "order",
            "signup",
            "cancel",
            "change",
            "negotiate",
            "catalogue",
            "availability",
            "pay",
            "track",
            "return"
          ]
        },
        "ready": {
          "description": "A home-page list: the agent-ready businesses.",
          "type": "boolean"
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["version", "url"]
    },
    "order": {
      "type": "string",
      "description": "The order in words."
    },
    "order_by": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["can_book_order_or_sign_up", "score", "checked_at", "domain"]
      },
      "description": "The order, field by field."
    },
    "not_search_order": {
      "type": "string"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unnamed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "next_page": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "named": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "domain": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "can_book_order_or_sign_up": {
            "type": "string",
            "enum": ["yes", "partly", "no"],
            "description": "Whether an agent can book, order or sign up here; no when none of them applies to its kind."
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "grade": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E"]
          },
          "answers": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": ["message", "book", "order", "signup", "cancel", "negotiate"]
            },
            "additionalProperties": {
              "type": "string",
              "enum": ["yes", "partly", "no", "not_applicable"]
            }
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "result_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "position",
          "domain",
          "name",
          "can_book_order_or_sign_up",
          "score",
          "grade",
          "answers",
          "checked_at",
          "result_url"
        ]
      }
    },
    "software_and_ai": {
      "description": "On a board of every kind: the software, API and AI companies it leaves out, ranked on their own board.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "scope",
    "rules",
    "order",
    "order_by",
    "not_search_order",
    "total",
    "unnamed",
    "page",
    "next_page",
    "named"
  ]
}
