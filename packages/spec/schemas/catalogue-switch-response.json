{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfingdog.ai/spec/schemas/catalogue-switch-response.json",
  "title": "POST /v1/instances/{domain}/catalogue: 200",
  "type": "object",
  "properties": {
    "domain": {
      "description": "Spec 0.15.1: the domain the switch is for.",
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "listed": {
      "type": "boolean"
    },
    "offers_live": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["listed", "offers_live"]
}
