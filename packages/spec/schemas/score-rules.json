{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfingdog.ai/spec/schemas/score-rules.json",
  "title": "GET /v1/score-rules: the agentic score's rules",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["in_force", "announced", "retired"]
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "summary": {
      "type": "string"
    },
    "vocabulary": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "find",
              "catalogue",
              "availability",
              "message",
              "negotiate",
              "book",
              "order",
              "signup",
              "pay",
              "change",
              "cancel",
              "track",
              "return",
              "receipt",
              "feedback",
              "subscription",
              "vouchers",
              "waitlist",
              "support",
              "policies"
            ]
          },
          "journey": {
            "type": "string",
            "enum": ["before", "doing", "after", "ongoing", "policies"]
          },
          "label": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": ["core", "after", "state", "negotiate", "readable", "find", "unscored"]
          }
        },
        "required": ["id", "journey", "label", "question", "group"]
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": ["core", "after", "state", "negotiate", "readable", "find", "unscored"]
          },
          "weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "find",
                "catalogue",
                "availability",
                "message",
                "negotiate",
                "book",
                "order",
                "signup",
                "pay",
                "change",
                "cancel",
                "track",
                "return",
                "receipt",
                "feedback",
                "subscription",
                "vouchers",
                "waitlist",
                "support",
                "policies"
              ]
            }
          }
        },
        "required": ["id", "weight", "members"]
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": ["appointments", "classes", "food", "trades", "shop", "stay", "memberships", "venues", "general"]
          },
          "label": {
            "type": "string"
          },
          "noun": {
            "type": "string",
            "description": "What \"scored as\" says: \"a shop\"."
          },
          "applicable": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "find",
                "catalogue",
                "availability",
                "message",
                "negotiate",
                "book",
                "order",
                "signup",
                "pay",
                "change",
                "cancel",
                "track",
                "return",
                "receipt",
                "feedback",
                "subscription",
                "vouchers",
                "waitlist",
                "support",
                "policies"
              ]
            }
          },
          "either": {
            "description": "Version 2: sets of applicable capabilities of one group that count as one member of it, met by the best state any of them has (book, order or sign up, for a business of a kind not known).",
            "type": "array",
            "items": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "find",
                  "catalogue",
                  "availability",
                  "message",
                  "negotiate",
                  "book",
                  "order",
                  "signup",
                  "pay",
                  "change",
                  "cancel",
                  "track",
                  "return",
                  "receipt",
                  "feedback",
                  "subscription",
                  "vouchers",
                  "waitlist",
                  "support",
                  "policies"
                ]
              }
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The directory's category groups this profile covers."
          }
        },
        "required": ["id", "label", "noun", "applicable", "groups"]
      }
    },
    "follows": {
      "description": "Version 2 as amended on 8 October 2026: when `if` applies to a business's profile and is yes or partial, the capabilities it `adds` count for it too (where an agent can book, changing and cancelling the booking count).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "if": {
            "type": "string",
            "enum": [
              "find",
              "catalogue",
              "availability",
              "message",
              "negotiate",
              "book",
              "order",
              "signup",
              "pay",
              "change",
              "cancel",
              "track",
              "return",
              "receipt",
              "feedback",
              "subscription",
              "vouchers",
              "waitlist",
              "support",
              "policies"
            ]
          },
          "adds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "find",
                "catalogue",
                "availability",
                "message",
                "negotiate",
                "book",
                "order",
                "signup",
                "pay",
                "change",
                "cancel",
                "track",
                "return",
                "receipt",
                "feedback",
                "subscription",
                "vouchers",
                "waitlist",
                "support",
                "policies"
              ]
            }
          },
          "goods": {
            "description": "Only for a business that sells goods (`goods`).",
            "type": "boolean"
          }
        },
        "required": ["if", "adds"]
      }
    },
    "goods": {
      "description": "Who sells goods, for a follow marked `goods`: a business of one of `profiles`, or one whose signals say so (a live checkout door, a catalogue of products) and whose profile is not one of `never`.",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["appointments", "classes", "food", "trades", "shop", "stay", "memberships", "venues", "general"]
          },
          "description": "Profiles whose businesses sell goods by their kind."
        },
        "never": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["appointments", "classes", "food", "trades", "shop", "stay", "memberships", "venues", "general"]
          },
          "description": "Profiles whose businesses never do, whatever their signals."
        }
      },
      "required": ["summary", "profiles", "never"]
    },
    "credit": {
      "type": "object",
      "properties": {
        "yes": {
          "type": "number"
        },
        "partial": {
          "type": "number"
        },
        "no": {
          "type": "number"
        }
      },
      "required": ["yes", "partial", "no"]
    },
    "requests": {
      "description": "Version 2 as amended on 12 October 2026: a request an agent files to change, cancel or return something, with a reference it can follow to the answer, counts as yes, the same as a door that carries it out at once.",
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "declared": {
          "type": "number"
        },
        "tested": {
          "type": "number"
        },
        "proven": {
          "type": "number"
        },
        "produced": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["declared", "tested", "proven"]
          }
        }
      },
      "required": ["declared", "tested", "proven", "produced"]
    },
    "formula": {
      "type": "string"
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grade": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E"]
          },
          "min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["grade", "min"]
      }
    },
    "rank": {
      "type": "string"
    },
    "named": {
      "type": "string"
    },
    "listing": {
      "description": "Version 3 as amended on 19 October 2026 (0.8.2): who the directory lists and a leaderboard names. A local business a network found when it is a real business (a member, registered or claimed, or a site its crawler matched to its entry on public maps or in a business register); none whose site was found parked, empty or taken over, unless a member's; online shops and software companies on their doors; real businesses labelled, and since the amendment of 21 October 2026 no longer ordered above the rest (rank).",
      "type": "string"
    },
    "pay": {
      "description": "Version 4: paying (pay, and the level payable) counts only for a way to pay the business declared itself or the network's read tested. A name whose only payment word is checkout orders; a platform's standard handlers do not pay.",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "words": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A name takes a payment only with one of these words: pay, payment, payments."
        },
        "platform_handlers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string"
              },
              "marker": {
                "description": "A namespace only that platform's profiles use, among the profile's handlers or capabilities. Without one, the handlers are the platform's in the profile of a site built on it (a UCP profile among platform.doors).",
                "type": "string"
              },
              "handlers": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The payment handlers its profile gives the stores it hosts."
              }
            },
            "required": ["platform", "handlers"]
          },
          "description": "A website platform's standard payment handlers: the platform's word, not the business's."
        }
      },
      "required": ["summary", "words", "platform_handlers"]
    },
    "a2a": {
      "description": "Version 4: an A2A agent card is a door that takes requests only once a harmless test call to its endpoint (tasks/get for a made-up task id) got an A2A JSON-RPC answer; any other card is readable.",
      "type": "string"
    },
    "platform": {
      "description": "Version 4: the doors a website platform gives every site it hosts. They count for what an agent can do; every count says how many get there only through one (platform) and how many through a door of the business's own.",
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "doors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "description": "The door's type as a network stores it (mcp, ucp, shopify_mcp)."
              },
              "path": {
                "description": "Its path on the site, the same on every site the platform hosts.",
                "type": "string"
              },
              "tools": {
                "description": "Tools the platform's server always lists: it is the platform's when it lists every one.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "site_platform": {
                "description": "On a site built on this platform: another door of the site is one only this platform serves, the site's homepage says so, or for Shopify the marks only its storefronts leave. For a UCP profile, for an address several platforms serve (/api/ucp/mcp), and for a door with no tools listed (Wix's /_api/mcp: any door at that path on a Wix site); a door there on a site no read ties to a platform is the business's own.",
                "type": "string"
              },
              "marker": {
                "description": "For a profile: a namespace only that platform's profiles use. A profile that names a payment handler or a capability under it is the platform's, whatever the site.",
                "type": "string"
              },
              "counts_as": {
                "type": "string",
                "description": "The door type it is counted as; platform: none of the protocols' (as Shopify's storefront)."
              }
            },
            "required": ["platform", "type", "counts_as"]
          }
        },
        "answer_tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A platform's question-answering tools (ask_business): on a platform's door no message reaches the business, so they are not message; a tool of that name on a door the business published itself counts as before."
        }
      },
      "required": ["summary", "doors", "answer_tools"]
    },
    "directory": {
      "type": "string"
    },
    "not_certification": {
      "type": "string"
    },
    "fixes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "find",
          "catalogue",
          "availability",
          "message",
          "negotiate",
          "book",
          "order",
          "signup",
          "pay",
          "change",
          "cancel",
          "track",
          "return",
          "receipt",
          "feedback",
          "subscription",
          "vouchers",
          "waitlist",
          "support",
          "policies"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "how": {
            "type": "string",
            "description": "\"<door>\" stands for \" on your <door label> door at <url>\" when the business has a live agent door."
          },
          "by_profile": {
            "description": "Another how, and title, for a kind of business.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": ["appointments", "classes", "food", "trades", "shop", "stay", "memberships", "venues", "general"]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "Another title for a kind of business.",
                  "type": "string"
                },
                "how": {
                  "type": "string",
                  "description": "\"<door>\" stands for \" on your <door label> door at <url>\" when the business has a live agent door."
                }
              },
              "required": ["how"]
            }
          },
          "protocol": {
            "description": "The how when the business's preferred door is an agent commerce protocol (UCP, ACP).",
            "type": "string"
          }
        },
        "required": ["title", "how"]
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "published": {
            "description": "The day a version was published.",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "amended": {
            "description": "The day a version was amended without a new number.",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": ["version", "summary"]
      }
    }
  },
  "required": [
    "version",
    "name",
    "status",
    "published_at",
    "effective_at",
    "summary",
    "vocabulary",
    "capabilities",
    "groups",
    "profiles",
    "credit",
    "evidence",
    "formula",
    "grades",
    "rank",
    "named",
    "directory",
    "not_certification",
    "fixes",
    "changelog"
  ]
}
