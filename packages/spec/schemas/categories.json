{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /v1/categories",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "labels": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            },
            "description": "Language → label."
          }
        },
        "required": ["slug", "labels"]
      }
    },
    "place_categories": {
      "description": "With ?group: every place category of that group; parent is null at the taxonomy's top.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "parent": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "label", "parent"]
      }
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "\"Overture Place Categories\""
        },
        "release": {
          "type": "string"
        },
        "licence": {
          "type": "string",
          "description": "\"CC BY 4.0\""
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["name", "release", "licence", "url"]
    }
  },
  "required": ["version", "categories"]
}
