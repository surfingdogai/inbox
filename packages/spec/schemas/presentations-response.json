{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/presentations: 200",
  "type": "object",
  "properties": {
    "presentation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "ppid": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "The person's pairwise id at this business: stable here, different at every other business."
    },
    "person": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["new", "building", "trusted"]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Stored to 6 decimals; compared as floor(score × 10⁴ + 0.5)."
        },
        "kept": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "broken": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "businesses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Mutually unrelated businesses with kept outcomes of this person's."
        },
        "email_proven": {
          "type": "boolean",
          "description": "The person proved the address with an emailed code."
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "unusual_use": {
          "type": "boolean",
          "description": "The pass was seen at over 10 businesses in 24 h, or has two signing keys."
        },
        "rules": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The rules version in force, as GET /v1/ranking publishes it."
        },
        "scored": {
          "description": "false while the network scores no customer (ADR-017 A2.10): the rest is then as for a person with no record and says nothing about the person's outcomes. A network before Amendment 2 sends none.",
          "type": "boolean"
        }
      },
      "required": ["tier", "score", "kept", "broken", "businesses", "email_proven", "since", "unusual_use", "rules"]
    },
    "pass": {
      "description": "The pass a key was exchanged for.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^sdpass1_(?:[a-z0-9-]|[a-z0-9-][a-z0-9.-]{0,251}[a-z0-9-])_[a-z2-7]{16}_[a-z2-7]{32}$"
    },
    "email_match": {
      "description": "proven: the person's, proven by code; unproven; no.",
      "type": "string",
      "enum": ["proven", "unproven", "no"]
    }
  },
  "required": ["presentation", "ppid", "person"]
}
