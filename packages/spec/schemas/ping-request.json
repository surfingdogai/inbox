{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/instances/{domain}/ping",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "runtime": {
      "type": "string",
      "maxLength": 32
    },
    "counts": {
      "type": "object",
      "properties": {
        "bookings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "orders": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "quotes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": ["bookings", "orders", "quotes", "messages"]
    },
    "manifest_sha256": {
      "description": "SHA-256 of the manifest as the inbox serves it, lowercase hex. Read on a signed ping only: when it is not what the network holds, the network fetches the manifest at once (A2.5).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": ["version", "runtime"]
}
