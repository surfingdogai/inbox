{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfingdog.ai/spec/schemas/ping-request.json",
  "title": "POST /v1/instances/{domain}/ping",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "runtime": {
      "type": "string",
      "maxLength": 32
    },
    "counts": {
      "type": "object",
      "properties": {
        "bookings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "orders": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "quotes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": ["bookings", "orders", "quotes", "messages"]
    },
    "manifest_sha256": {
      "description": "SHA-256 of the manifest as the inbox serves it, lowercase hex. Read on a signed ping only: when it is not what the network holds, the network fetches the manifest at once (A2.5).",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalogue": {
      "description": "The business's products on networks (§4.18, spec 0.9): listed, with the count and rev a network compares to know whether to read the feed again, or {\"listed\": false} once to a network last told they were. Signed pings only.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "listed": {
              "type": "boolean",
              "const": true
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "updated_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rev": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            }
          },
          "required": ["listed", "count", "updated_at", "rev"]
        },
        {
          "type": "object",
          "properties": {
            "listed": {
              "type": "boolean",
              "const": false
            }
          },
          "required": ["listed"]
        }
      ]
    }
  },
  "required": ["version", "runtime"]
}
