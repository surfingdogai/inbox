{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acknowledgement claims with pas",
  "type": "object",
  "properties": {
    "rcp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The receipt's id on the issuing instance."
    },
    "sha": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "base64url(SHA-256(receipt JWS))."
    },
    "iat": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pas": {
      "description": "A pass reference of the acknowledging person.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^sdpass1_(?:[a-z0-9-]|[a-z0-9-][a-z0-9.-]{0,251}[a-z0-9-])_[a-z2-7]{16}$"
    }
  },
  "required": ["rcp", "sha", "iat"]
}
