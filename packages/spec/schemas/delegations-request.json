{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /v1/delegations",
  "type": "object",
  "properties": {
    "pass": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200,
          "pattern": "^sdpass1_(?:[a-z0-9-]|[a-z0-9-][a-z0-9.-]{0,251}[a-z0-9-])_[a-z2-7]{16}_[a-z2-7]{32}$",
          "description": "A pass: sdpass1_<network host>_<id>_<secret>. What an agent presents for its person."
        },
        {
          "type": "string",
          "maxLength": 200,
          "pattern": "^sdpass1_(?:[a-z0-9-]|[a-z0-9-][a-z0-9.-]{0,251}[a-z0-9-])_[a-z2-7]{16}$",
          "description": "A pass reference: sdpass1_<network host>_<id>. Only valid with a signature by a delegated key."
        }
      ]
    }
  },
  "required": ["pass"]
}
