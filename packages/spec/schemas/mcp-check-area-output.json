{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP check_area: structuredContent",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "enum": ["inside", "outside", "on_request"]
    },
    "within_km": {
      "anyOf": [
        {
          "type": "number",
          "const": 5
        },
        {
          "type": "number",
          "const": 10
        },
        {
          "type": "number",
          "const": 25
        },
        {
          "type": "number",
          "const": 50
        }
      ]
    },
    "area": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["radius", "postal", "anywhere"]
        },
        "radius_km": {
          "description": "For radius: how far the business goes.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "postal": {
          "description": "For postal: the prefixes it covers.",
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "description": "ISO 3166-1 alpha-2, in capitals."
              },
              "prefix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "pattern": "^[A-Z0-9]+$",
                "description": "The start of the postal code, in capitals, with no spaces or dashes."
              }
            },
            "required": ["country", "prefix"]
          }
        },
        "outside": {
          "type": "string",
          "enum": ["decline", "on_request"],
          "description": "A request from outside: declined, or taken for the business to decide."
        }
      },
      "required": ["mode", "outside"]
    },
    "words": {
      "type": "string",
      "maxLength": 500,
      "description": "What to tell your person, in the business's words."
    }
  },
  "required": ["answer", "area", "words"]
}
