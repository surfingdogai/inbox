{
  "_about": "Booking sessions transcribed from the UCP Lodging draft's own examples (Apache-2.0, the UCP Authors), at the pinned commit, with `{{ ucp_version }}` written as 2026-08-25. They are the reference the inbox's mapping and its checks are held to.",
  "examples": [
    {
      "name": "Property-Collected Taxes & Fees",
      "source": "https://github.com/Universal-Commerce-Protocol/ucp/blob/f2626c28b8288976eee5bda77f3a9b1ddc0132b1/docs/specification/lodging/booking/index.md#pricing-examples",
