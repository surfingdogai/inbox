---
/**
 * The product, shown rather than told: what an AI agent can do with one business, as a check reads
 * it (an example on a .example domain), beside the ladder of how far an AI can go. The example's
 * numbers are the spec's vector, so the card shows what the published rules give.
 */
import { exampleCard } from "../lib/agent-example";
import AgentCard from "./AgentCard.astro";
import Ladder from "./Ladder.astro";

const card = exampleCard();
---

<section class="section" id="listing" aria-labelledby="listing-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">The check</p>
        <h2 class="h-section" id="listing-h">What an AI can do, at a glance.</h2>
        <p class="lede">
          Can an agent message, book, order, cancel or negotiate here? Through which door? Each answer, and a score
          by published rules.
        </p>
      </div>
    </div>
    <div class="cols">
      <AgentCard example {...card} />
      <Ladder />
    </div>
    <p class="fine">
      An example. Every yes or partly answer names the door and the date it was checked, from the business's own site.
    </p>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: var(--gap-grid);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
