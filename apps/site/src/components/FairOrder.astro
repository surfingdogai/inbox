---
/**
 * The order, as trust: ranked by receipts, never by payment, with the rule version in force read
 * from the network at build time. If the network cannot be read the line says "The rules in force"
 * and nothing else, rather than a version it cannot vouch for.
 *
 * The drawing is one gesture, played once when it scrolls in: a receipt drops onto the second row,
 * that row's meter gains a notch, and the two rows trade places. Its resting frame is the finished
 * order, so a page that never arms the reveal (above the fold, reduced motion, no script) shows the
 * end of the story. Nothing loops, so nothing runs off screen.
 */
import { shortDate, stateOf } from "../lib/status";
import StatusPill from "./StatusPill.astro";

const RANKING = "https://network.surfingdog.ai/v1/ranking";

let rulesLine = "The rules in force";
try {
  const res = await fetch(RANKING, { headers: { accept: "application/json" }, signal: AbortSignal.timeout(4000) });
  if (res.ok) {
    const r = (await res.json()) as { version?: unknown; effective_at?: unknown; status?: unknown };
    if (typeof r.version === "number" && typeof r.effective_at === "string" && r.status === "in_force") {
      rulesLine = `Rules version ${r.version} · in force since ${shortDate(r.effective_at)}`;
    }
  }
} catch {
  // Unreachable at build time: keep the neutral line.
}

const lines = [
  { title: "Answering first.", text: "Businesses whose inbox answered in the last day come first." },
  {
    title: "Promises kept.",
    text: "A record of kept promises moves you up. Everyone else, newcomers included, follows in a daily shuffle anyone can reproduce.",
  },
  { title: "No paid places.", text: "Not now, not later." },
];
const live = stateOf("ranking");
---

<section class="section" id="order" aria-labelledby="order-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">The order</p>
        <h2 class="h-section" id="order-h">Ranked by receipts, never by payment.</h2>
        <p class="lede">
          When a business keeps a booking or delivers an order, its inbox signs a receipt. The order is built from those.
        </p>
      </div>
    </div>

    <div class="cols">
      <ul class="glass panel rules" data-reveal="stagger">
        {
          lines.map((l) => (
            <li class="fo-rule">
              <div class="fo-rule-head">
                <h3 class="h-card">{l.title}</h3>
                <StatusPill state={live} />
              </div>
              <p class="card-text">{l.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="side">
        <div class="glass card viz" data-reveal aria-hidden="true">
          <div class="fo-rows">
            <div class="fo-row r-a">
              <i class="av"></i><i class="bar"></i>
              <span class="meter"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i></i><i></i></span>
            </div>
            <div class="fo-row r-b">
              <i class="av"></i><i class="bar short"></i>
              <span class="meter"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i><i class="on new"></i><i></i></span>
              <span class="receipt"><svg viewBox="0 0 12 14"><path d="M1.5 1h9v12l-1.5-1-1.5 1-1.5-1-1.5 1-1.5-1-1.5 1z"></path><path class="tk" d="M3.8 7.2l1.6 1.6 3-3.4"></path></svg></span>
            </div>
            <div class="fo-row r-c">
              <i class="av"></i><i class="bar shorter"></i>
              <span class="meter"><i></i><i></i><i></i><i></i><i></i><i></i></span>
            </div>
          </div>
        </div>
        <p class="mono version">{rulesLine}</p>
        <p class="more">
          <a class="link" href={RANKING} rel="noopener">Read the rules</a>
        </p>
        <p class="fine">Changes are announced 15 days before they count.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: var(--gap-grid);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .rules {
    margin: 0;
    padding-block: var(--sp-1);
    list-style: none;
  }
  .fo-rule {
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .fo-rule:first-child {
    border-top: 0;
  }
  .fo-rule-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-bottom: var(--sp-1);
  }
  .version {
    margin: var(--sp-4) 0 0;
    color: var(--ink-2);
  }
  .more {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-card);
  }
  .side .fine {
    margin-top: var(--sp-2);
  }

  /* The drawing: three rows on fixed slots, so trading places is a transform, not a reflow. */
  .viz {
    padding: var(--sp-4);
  }
  .fo-rows {
    position: relative;
    height: 112px;
  }
  .fo-row {
    --slot: 0;
    position: absolute;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    height: 32px;
    padding: 0 var(--sp-3);
    border-radius: var(--radius-control);
    background: var(--row-bg);
    transform: translateY(calc(var(--slot) * 40px));
    transition: transform 0.6s var(--ease);
    transition-delay: 1.3s;
  }
  .r-b {
    --slot: 0;
    border: 1px solid color-mix(in srgb, var(--c-success) 40%, transparent);
  }
  .r-a {
    --slot: 1;
  }
  .r-c {
    --slot: 2;
  }
  .av {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink-3) 18%, transparent);
    flex: none;
  }
  .bar {
    width: 64px;
    height: 5px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--ink-3) 24%, transparent);
  }
  .bar.short {
    width: 52px;
  }
  .bar.shorter {
    width: 40px;
  }
  .meter {
    display: inline-flex;
    gap: 3px;
    margin-left: auto;
  }
  .meter i {
    width: 8px;
    height: 4px;
    border-radius: 2px;
    background: var(--hairline-strong);
    transition: background-color var(--dur) var(--ease);
    transition-delay: 0.9s;
  }
  .meter i.on {
    background: var(--ink-3);
  }
  .receipt {
    position: absolute;
    top: -14px;
    right: 60px;
    width: 12px;
    height: 14px;
    opacity: 0;
    transition:
      opacity 0.3s var(--ease),
      transform 0.5s var(--ease);
  }
  .receipt svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--ground);
    stroke: var(--c-success);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .receipt .tk {
    fill: none;
    stroke: var(--c-success-ink);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  /* Armed, before it is seen: the old order, the receipt held above, the new notch still empty.
     In view: the receipt drops and fades, the notch fills, then the rows trade places. */
  .viz.reveal-armed:not(.reveal-in) .r-a {
    --slot: 0;
  }
  .viz.reveal-armed:not(.reveal-in) .r-b {
    --slot: 1;
    border-color: transparent;
  }
  .viz.reveal-armed:not(.reveal-in) .meter i.new {
    background: var(--hairline-strong);
  }
  .viz.reveal-armed:not(.reveal-in) .receipt {
    opacity: 1;
    transform: translateY(-10px);
  }
  .viz.reveal-armed.reveal-in .receipt {
    animation: fo-drop 1.2s var(--ease) 0.2s both;
  }
  @keyframes fo-drop {
    0% {
      opacity: 1;
      transform: translateY(-10px);
    }
    45% {
      opacity: 1;
      transform: translateY(8px);
    }
    100% {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fo-row,
    .meter i,
    .receipt {
      transition: none;
      animation: none;
    }
  }
</style>
