---
/**
 * A topic guide's body (src/lib/topics.ts): its lede where it has one, the answer in short, its sections with the source of each
 * line about another company's product, the check, the questions (shown, and given as FAQPage data in
 * the same words by its page, with topicLd), the pages it builds on, and its sources. The same quiet
 * styles as a guide. Its page gives the layout. A guide in Spanish or Portuguese has the frame's
 * words in its language (TOPIC_WORDS), and every link to a page that is in English says so.
 */
import { inline, linksIn } from "../lib/inline";
import { WOO_NOTICE } from "../lib/integrations";
import { namesWoo, TOPIC_WORDS, type Topic, topicLang } from "../lib/topics";
import Faqs from "./Faqs.astro";
import GuideAnswer from "./GuideAnswer.astro";
import GuideCheck from "./GuideCheck.astro";

interface Props {
  topic: Topic;
}
const { topic: t } = Astro.props;
const lang = topicLang(t);
const w = TOPIC_WORDS[lang];
const blocks = t.sections.flatMap((s) => [...s.paras, ...(s.list ?? [])]);
/** In a page in another language, the links of ours that go to a page in English, marked as such. */
const english = new Set(
  lang === "en"
    ? []
    : [...blocks.flatMap((b) => linksIn(b.text)), ...t.related.map((r) => r.href)].filter(
        (h) => h.startsWith("/") && !h.startsWith(`/${lang}/`),
      ),
);
/** Its words with their marks: `code`, [links](/path) and **bold**, everything else escaped. */
const rich = (text: string) => inline(text, english).replace(/\*\*([^*]+)\*\*/g, "<b>$1</b>");
const sources = [...new Map(blocks.flatMap((b) => b.sources ?? []).map((s) => [s.href, s])).values()];
/** Automattic's notice, on a page that names its mark. */
const woo = namesWoo(t);
---

<article class="wrap wrap-read section is-head guide" aria-labelledby="t-title">
  <p class="eyebrow"><a href={w.hub.href}>{w.hub.label}</a></p>
  <h1 class="h-page" id="t-title">{t.heading}</h1>
  {t.lede && <p class="lede" set:html={rich(t.lede)} />}
  <GuideAnswer text={t.answer} label={w.inShort} />

  <div class="prose t-body">
    {
      t.sections.map((s) => (
        <>
          <h2 id={s.id}>{s.heading}</h2>
          {s.paras.map((b) => (
            <p>
              <span set:html={rich(b.text)} />
              {b.sources && b.sources.length > 0 && (
                <>
                  {" "}
                  <span class="src">
                    ({b.sources.map((x, i) => <>{i > 0 && "; "}<a href={x.href} rel="noopener">{x.label}</a></>)})
                  </span>
                </>
              )}
            </p>
          ))}
          {s.list && (
            <ul>
              {s.list.map((b) => (
                <li>
                  <span set:html={rich(b.text)} />
                  {b.sources && b.sources.length > 0 && (
                    <>
                      {" "}
                      <span class="src">
                        ({b.sources.map((x, i) => <>{i > 0 && "; "}<a href={x.href} rel="noopener">{x.label}</a></>)})
                      </span>
                    </>
                  )}
                </li>
              ))}
            </ul>
          )}
        </>
      ))
    }
  </div>
  {woo && <p class="fine">{WOO_NOTICE}</p>}

  {
    w.check ? (
      <GuideCheck examples={[]} title={w.check.title} words={w.check} />
    ) : (
      <GuideCheck examples={[]} title="Check your website" />
    )
  }
  <Faqs faqs={t.faqs} title={w.questions} />

  <nav class="t-more" aria-labelledby="t-more-h">
    <h2 class="t-more-h" id="t-more-h">{w.readNext}</h2>
    <p>
      {
        t.related.map((r, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a class="link" href={r.href} hreflang={english.has(r.href) ? "en" : undefined}>
              {r.label}
            </a>
            {english.has(r.href) && <span lang="en"> (EN)</span>}
          </>
        ))
      }
      <span aria-hidden="true"> · </span>
      <a class="link" href={w.hub.href}>{lang === "en" ? "All guides" : w.hub.label}</a>
    </p>
  </nav>

  <details class="sources">
    <summary>{w.sources}</summary>
    <ul>
      {
        sources.map((s) => (
          <li>
            <a class="link" href={s.href} rel="noopener">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</article>

<style>
  .guide {
    padding-bottom: var(--section-y);
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover,
  .eyebrow a:focus-visible {
    text-decoration: underline;
  }
  .t-body {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .t-body h2 {
    font-size: var(--fs-section);
  }
  .t-body ul {
    list-style: disc;
  }
  .t-body li::marker {
    color: var(--ink-3);
  }
  .t-body :global(b) {
    font-weight: 600;
  }
  .t-body :global(:not(pre) > code) {
    padding: 0 4px;
    border-color: transparent;
    background: var(--row-bg);
    font-size: var(--fs-mono);
  }
  .src {
    font-size: var(--fs-fine);
    color: var(--ink-3);
  }
  .t-more {
    padding-top: var(--sp-5);
    border-top: 1px solid var(--hairline);
  }
  .t-more-h {
    margin: 0;
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .t-more p {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-ui);
    line-height: 1.7;
    color: var(--ink-3);
  }
  .sources summary {
    width: fit-content;
    font-size: var(--fs-fine);
    color: var(--ink-3);
    cursor: pointer;
  }
  .sources summary:hover {
    color: var(--ink-2);
  }
  .sources ul {
    display: grid;
    gap: var(--sp-1);
    margin: var(--sp-2) 0 0;
    padding-left: 1.25rem;
    list-style: disc;
    font-size: var(--fs-fine);
  }
</style>
