---
import Shot from "./Shot.astro";

/**
 * Four trades, one build. `rule` is the line that differs between them; `what` is the day that
 * line produces. Keeping the rule first is the whole point of the section.
 */
const cases = [
  {
    who: "A bike shop",
    rule: "Confirm a service booking when the slot is free and the time is inside opening hours.",
    what: "An agent asks for a full service on Tuesday. The booking is confirmed and answered before the owner has looked at a screen.",
  },
  {
    who: "A bakery",
    rule: "Accept an order under €80. Send anything larger to a person.",
    what: "Small orders go through the moment they arrive. A large one waits, and the customer is told that it is waiting.",
  },
  {
    who: "A plumber",
    rule: "Ask every quote request for the address, the job and the access before it reaches the owner.",
    what: "The answers arrive as fields rather than a paragraph. The owner's AI drafts the quote from them, and the owner sends it.",
  },
  {
    who: "A studio",
    rule: "Leave messages to the owner's own AI, inside the prices and hours the owner wrote down.",
    what: "Claude is connected over MCP and reads the real availability before it answers. It cannot invent a price that is not there.",
  },
];
---

<section class="section" id="use-cases" aria-labelledby="cases-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">In practice</p>
        <h2 class="h-section" id="cases-h">The same inbox, four sets of rules</h2>
        <p class="lede">
          A bike shop, a bakery, a plumber and a studio. The software is identical in all four. Only the rules differ,
          and each set takes an afternoon to write.
        </p>
      </div>
    </div>
    <div class="cols">
      <ol class="glass panel flows">
        {
          cases.map((c) => (
            <li class="flow">
              <h3 class="h-card">{c.who}</h3>
              <p class="does">{c.rule}</p>
              <p class="card-text">{c.what}</p>
            </li>
          ))
        }
      </ol>
      <Shot
        src="/shots/item-day.png"
        alt="An item in the inbox: a booking with its typed fields, its state, and the next actions as buttons"
        title="What lands in the inbox"
        caption="The typed item, its state, the conversation, and the valid next actions as the buttons."
      />
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: var(--gap-grid);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .flows {
    margin: 0;
    padding-block: var(--sp-1);
    list-style: none;
  }
  .flow {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .flow:first-child {
    border-top: 0;
  }
  /* The rule itself, in full ink: it is the sentence that changes from trade to trade. */
  .does {
    margin: 0;
    max-width: var(--measure-card);
    font-size: var(--fs-card);
    line-height: var(--lh-body);
    color: var(--ink);
  }
</style>
