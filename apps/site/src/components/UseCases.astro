---
import { CASES, caseHref } from "../lib/cases";
import Marked from "./Marked.astro";
import Shot from "./Shot.astro";

/**
 * Five kinds of business, each on the system it already runs (src/lib/cases.ts): what reaches the
 * owner, then what the inbox does with that system, in one sentence. Examples, and labelled so; each
 * links to its own short page, which keeps the detail.
 */
---

<section class="section" id="use-cases" aria-labelledby="cases-h" data-reveal>
  <div class="wrap">
    <div class="cases-head">
      <div>
        <p class="eyebrow">Examples</p>
        <h2 class="h-section" id="cases-h">On the systems they already run</h2>
        <p class="lede">
          Five kinds of business, one inbox. These are examples of what it does today, not customers.
        </p>
      </div>
      <Shot
        src="/shots/item-day.png"
        alt="A booking in the inbox with its details, its state and buttons for the next step"
        title="What lands in the inbox"
        caption="The booking, where it stands, the conversation and the next steps."
      />
    </div>
    <ol class="glass panel flows">
      {
        CASES.map((c) => (
          <li class="flow">
            <h3 class="h-card">
              <a class="case-link" href={caseHref(c)}>
                <Marked text={c.label} />
              </a>
            </h3>
            <p class="arrives">{c.arrives}</p>
            <p class="card-text">{c.short}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* The heading beside the print of what lands; under them, one line per example. */
  .cases-head {
    display: grid;
    gap: var(--gap-grid);
    align-items: center;
    margin-bottom: var(--space-head);
  }
  @media (min-width: 900px) {
    .cases-head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--sp-8);
    }
  }
  .flows {
    margin: 0;
    padding-block: var(--sp-1);
    list-style: none;
  }
  .flow {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .flow:first-child {
    border-top: 0;
  }
  /* Wide, each example is a row: the business, what reaches it, what the inbox does. */
  @media (min-width: 900px) {
    .flow {
      grid-template-columns: 224px minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--sp-6);
      align-items: baseline;
    }
  }
  .flow > * {
    margin: 0;
  }
  .case-link {
    color: inherit;
    text-decoration: none;
  }
  .case-link:hover,
  .case-link:focus-visible {
    color: var(--violet-ink);
  }
  .case-link::after {
    content: " →";
    color: var(--ink-3);
  }
  /* What reaches the owner, in full ink: the line that changes from business to business. */
  .arrives {
    max-width: var(--measure-card);
    font-size: var(--fs-card);
    line-height: var(--lh-body);
    color: var(--ink);
  }
</style>
