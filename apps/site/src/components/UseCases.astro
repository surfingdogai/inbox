---
import Shot from "./Shot.astro";

/**
 * Four trades, one build. `rule` is the line that differs between them; `what` is the day that
 * line produces. Keeping the rule first is the whole point of the section.
 */
const cases = [
  {
    who: "A bike shop",
    rule: "Confirm a service booking when the slot is free and the shop is open.",
    what: "An agent books a full service for Tuesday. It's confirmed before the owner looks at a screen.",
  },
  {
    who: "A bakery",
    rule: "Accept orders under €80. Send bigger ones to a person.",
    what: "Small orders go straight through. Big ones wait, and the customer is told so.",
  },
  {
    who: "A plumber",
    rule: "Send every quote request to the owner. Put leaks and anything urgent at the top.",
    what: "The job, the address and the date arrive as fields, ready to price.",
  },
  {
    who: "A studio",
    rule: "Let the owner's own AI answer messages, using the owner's prices and hours.",
    what: "It connects over MCP and checks the real availability before it replies.",
  },
];
---

<section class="section" id="use-cases" aria-labelledby="cases-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">In practice</p>
        <h2 class="h-section" id="cases-h">Four businesses, four sets of rules</h2>
        <p class="lede">
          They all run the same inbox. Only the rules differ.
        </p>
      </div>
    </div>
    <div class="cols">
      <ol class="glass panel flows">
        {
          cases.map((c) => (
            <li class="flow">
              <h3 class="h-card">{c.who}</h3>
              <p class="does">{c.rule}</p>
              <p class="card-text">{c.what}</p>
            </li>
          ))
        }
      </ol>
      <Shot
        src="/shots/item-day.png"
        alt="A booking in the inbox with its details, its state and buttons for the next step"
        title="What lands in the inbox"
        caption="The booking, where it stands, the conversation and the next steps."
      />
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: var(--gap-grid);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .flows {
    margin: 0;
    padding-block: var(--sp-1);
    list-style: none;
  }
  .flow {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .flow:first-child {
    border-top: 0;
  }
  /* The rule itself, in full ink: it is the sentence that changes from trade to trade. */
  .does {
    margin: 0;
    max-width: var(--measure-card);
    font-size: var(--fs-card);
    line-height: var(--lh-body);
    color: var(--ink);
  }
</style>
