---
/** Reputation on the network, told from the front page: earned on both sides, never bought. */
const sides = [
  {
    title: "Businesses earn it.",
    body: "Every booking that happens and every order delivered will count. So will a broken promise. Recent months will count most.",
  },
  {
    title: "Customers earn it too.",
    body: "Customers who turn up and pay will build their own record, whatever agent they use. You'll be able to reward them.",
  },
  {
    title: "Nobody can buy it.",
    body: "No ads and no paid places. We'll publish every rule before it counts.",
  },
];
---

<section class="section" id="reputation" aria-labelledby="reputation-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Reputation <span class="pill">Being built</span></p>
        <h2 class="h-section" id="reputation-h">Reputation you earn, on both sides.</h2>
        <p class="lede">
          Your inbox can join a network that agents search. Today it is a simple directory. Soon, businesses that keep
          their promises will be found first.
        </p>
      </div>
    </div>
    <ul class="grid-cards sides" data-reveal="stagger">
      {
        sides.map((s) => (
          <li class="glass card side">
            <h3 class="h-card">{s.title}</h3>
            <p class="card-text">{s.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="more">
      <a class="link" href="/network/">How the network works</a>
    </p>
  </div>
</section>

<style>
  .sides {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .sides {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .side .card-text {
    margin-top: var(--sp-2);
  }
  .eyebrow .pill {
    margin-left: var(--sp-2);
    vertical-align: middle;
  }
  .more {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-card);
  }
</style>
