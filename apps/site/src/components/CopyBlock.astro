---
/**
 * One thing to copy into your AI: a heading, one line of what it does, the text itself (plain and
 * selectable, so it works with no script), and a copy button that appears only where the clipboard
 * is there to use (src/lib/copy.ts). An address is set in monospace; words to say to an AI are set
 * in the body font, as words. An optional second way to say it waits behind a small disclosure.
 * Every button is named for what it copies, so three "Copy" buttons never sound the same.
 */
interface Props {
  title: string;
  what: string;
  value: string;
  /** true when the value is an address (monospace); words to say to an AI are not. */
  address?: boolean;
  /** A second way to say it, copied on its own, behind a disclosure. */
  alt?: { label: string; value: string };
  more?: { href: string; label: string };
}

const { title, what, value, address = false, alt, more } = Astro.props;
---

<div class="cb">
  <h2 class="cb-title">{title}</h2>
  <p class="cb-what">{what}</p>
  <div class="cb-row">
    {address ? <code class="cb-text cb-addr">{value}</code> : <p class="cb-text cb-words">{value}</p>}
    <button class="cb-copy" type="button" data-copy={value} aria-label={`Copy: ${title}`} hidden>Copy</button>
  </div>
  {
    alt && (
      <details class="cb-alt">
        <summary>{alt.label}</summary>
        <div class="cb-row cb-row-alt">
          <p class="cb-text cb-words">{alt.value}</p>
          <button class="cb-copy" type="button" data-copy={alt.value} aria-label={`Copy: ${title}, in plain words`} hidden>
            Copy
          </button>
        </div>
      </details>
    )
  }
  {
    more && (
      <p class="cb-more">
        <a class="link" href={more.href}>
          {more.label}
        </a>
      </p>
    )
  }
</div>

<style>
  .cb {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    min-width: 0;
    text-align: left;
  }
  .cb-title {
    margin: 0;
    line-height: 1.3;
    font-family: var(--font-display);
    font-size: var(--fs-ui);
    font-weight: 600;
    color: var(--ink);
  }
  .cb-what {
    margin: 0;
    font-size: var(--fs-fine);
    line-height: 1.5;
    color: var(--ink-3);
  }
  .cb-alt summary {
    width: fit-content;
    min-height: 24px;
    font-size: var(--fs-fine);
    line-height: 24px;
    color: var(--ink-3);
    cursor: pointer;
  }
  .cb-alt summary:hover {
    color: var(--ink-2);
  }
  .cb-alt[open] summary {
    margin-bottom: var(--sp-2);
  }
  .cb-row {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: 8px 8px 8px 12px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--ground) 40%, transparent);
  }
  .cb-text {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding-top: 3px;
    line-height: 1.55;
    color: var(--ink);
    overflow-wrap: anywhere;
    user-select: all;
  }
  .cb-addr {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
    font-size: var(--fs-mono);
  }
  .cb-words {
    font-size: var(--fs-fine);
    color: var(--ink-2);
  }
  .cb-copy {
    flex: none;
    height: 26px;
    padding: 0 10px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    font: inherit;
    font-size: var(--fs-fine);
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
  }
  .cb-copy:hover,
  .cb-copy:focus-visible {
    background: var(--pill-bg-hover);
    color: var(--ink);
  }
  .cb-more {
    margin: 0;
    font-size: var(--fs-fine);
  }
</style>
