---
import Shot from "./Shot.astro";

const shots = [
  {
    src: "/shots/rules-detail.png",
    alt: "The rules screen of the inbox, listing plain rules with their triggers, conditions and actions",
    title: "Rules",
    caption:
      "Plain rules, read back in English, run the moment an item arrives or changes state. Turn one off, test it, or change the number in it.",
  },
  {
    src: "/shots/availability-detail.png",
    alt: "The availability and services screen: opening hours, services with duration and capacity, products with prices",
    title: "Availability and services",
    caption:
      "Opening hours, services with duration and capacity, products with prices: exactly what an agent may check, book or order.",
  },
  {
    src: "/shots/settings-detail.png",
    alt: "The settings screen: cancellation window, approval limit, email, test mode and the network the instance reports to",
    title: "Settings",
    caption:
      "Cancellation windows, approval limits, email and test mode: one versioned document, edited by you or by your AI.",
  },
];
---

<section class="section" id="rules" aria-labelledby="rules-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Your rules</p>
        <h2 class="h-section" id="rules-h">Set your rules once. Let any agent do the rest.</h2>
        <p class="lede">
          A business does not need to build agent tooling. It needs its opening hours, its services and its limits
          written down once, so that any agent can book, order or ask within them, and its own AI can answer inside
          them.
        </p>
      </div>
    </div>
    <div class="shots" data-reveal="stagger">
      {shots.map((s) => <Shot src={s.src} alt={s.alt} title={s.title} caption={s.caption} />)}
    </div>
  </div>
</section>

<style>
  .shots {
    display: grid;
    gap: var(--gap-grid);
  }
  @media (min-width: 900px) {
    .shots {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
