---
import Shot from "./Shot.astro";

const shots = [
  {
    src: "/shots/rules-detail.png",
    alt: "The rules screen, listing rules with their triggers, conditions and actions",
    title: "Rules",
    caption: "Each rule reads back in plain English. Test it before it goes live.",
  },
  {
    src: "/shots/availability-detail.png",
    alt: "The availability screen: opening hours, services with duration and capacity, products with prices",
    title: "Availability and services",
    caption: "Your hours, services and prices. Agents book and order from these.",
  },
  {
    src: "/shots/settings-detail.png",
    alt: "The settings screen: cancellation window, approval limit, email, test mode and the network",
    title: "Settings",
    caption: "Cancellation window, approval limit, email and test mode, changed by you or by your AI.",
  },
];
---

<section class="section" id="rules" aria-labelledby="rules-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Your rules</p>
        <h2 class="h-section" id="rules-h">Write your rules once. Agents work inside them.</h2>
        <p class="lede">
          You don't build anything for agents. Write down your hours, services and limits, and agents book and order
          within them.
        </p>
      </div>
    </div>
    <div class="shots" data-reveal="stagger">
      {shots.map((s) => <Shot src={s.src} alt={s.alt} title={s.title} caption={s.caption} />)}
    </div>
  </div>
</section>

<style>
  .shots {
    display: grid;
    gap: var(--gap-grid);
  }
  @media (min-width: 900px) {
    .shots {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
