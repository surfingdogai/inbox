---
import Mark from "./Mark.astro";

/**
 * The main navigation is about the business. Docs and GitHub are developer material,
 * so they sit at the end of the menu rather than in the bar.
 */
const links = [
  { href: "/try/", label: "Try it" },
  { href: "/how-it-works/", label: "How it works" },
  { href: "/network/", label: "Network" },
  { href: "/requests/", label: "Requests" },
  { href: "/blog/", label: "Blog" },
  { href: "/technical/", label: "Technical" },
  { href: "/sponsors/", label: "Sponsors" },
];

const more = [
  { href: "/docs/", label: "Docs" },
  { href: "https://github.com/surfingdogai/inbox", label: "GitHub", external: true },
];

const trim = (path: string) => path.replace(/\/+$/, "") || "/";
const here = trim(Astro.url.pathname);
/** A blog post is still the blog, so a section matches its children too. */
const current = (href: string) => {
  const target = trim(href);
  return here === target || here.startsWith(`${target}/`);
};
/** Shown beside the wordmark once the link strip has folded into the menu. */
const section = links.find((l) => current(l.href))?.label ?? "";
---

<div id="nav-top" aria-hidden="true"></div>
<header class="nav-shell" data-nav>
  <div class="wrap">
    <nav class="glass navbar" aria-label="Site">
      <div class="side lead">
        <a class="brand" href="/" aria-current={here === "/" ? "page" : undefined}>
          <Mark size={26} />
          <span class="word">Surfing Dog</span>
        </a>
        {
          section && (
            <span class="where">
              <span class="where-slash" aria-hidden="true">
                /
              </span>
              {section}
            </span>
          )
        }
      </div>

      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>
                <span class="lbl">{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="side actions">
        <button class="btn btn-secondary btn-icon btn-sm tt" type="button" data-theme-toggle aria-label="Switch theme">
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
          </svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"></path>
          </svg>
        </button>
        <a class="btn btn-primary btn-sm cta" href="/#run">
          <span class="cta-long">Get your inbox</span>
          <span class="cta-short">Get it</span>
        </a>
        <button
          class="menu"
          type="button"
          data-menu-button
          aria-expanded="false"
          aria-controls="nav-sheet"
          aria-label="Menu"
        >
          <span class="bars" aria-hidden="true"><i></i><i></i></span>
        </button>
      </div>
    </nav>

    <div class="sheet glass-strong" id="nav-sheet" data-menu-sheet>
      <nav class="sheet-nav" aria-label="All pages">
        <ul>
          {
            links.map((l) => (
              <li>
                <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>
                  <span class="tick" aria-hidden="true" />
                  {l.label}
                </a>
              </li>
            ))
          }
          <li class="rule" role="presentation"></li>
          {
            more.map((l) => (
              <li>
                <a
                  href={l.href}
                  rel={l.external ? "noopener" : undefined}
                  aria-current={!l.external && current(l.href) ? "page" : undefined}
                >
                  <span class="tick" aria-hidden="true" />
                  {l.label}
                  {l.external && (
                    <svg class="out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="theme-row">
        <span class="theme-label">Theme</span>
        <div class="seg" role="group" aria-label="Theme">
          <button type="button" data-theme-set="light" aria-pressed="false">Day</button>
          <button type="button" data-theme-set="dark" aria-pressed="false">Night</button>
          <button type="button" data-theme-set="auto" aria-pressed="false">Auto</button>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* A 1px marker at the top of the document. Once it leaves the viewport the bar
     firms up. An observer watching it costs nothing per frame. */
  #nav-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }
  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-top: 10px;
  }
  /* The pill floats clear of the top edge, so page text would otherwise scroll
     through that gap at full sharpness and be sliced by the pill's edge. This
     fades the page out through the gap, with the tail of the fade hidden behind
     the pill. Same blur as the pill, so it reads as one piece of glass. */
  .nav-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    backdrop-filter: blur(26px) saturate(150%);
    -webkit-backdrop-filter: blur(26px) saturate(150%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    pointer-events: none;
  }
  .navbar {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    height: 52px;
    padding: 0 6px 0 8px;
    border-radius: 9999px;
    transition:
      box-shadow 0.25s var(--ease-out-soft),
      background-color 0.25s var(--ease-out-soft),
      border-color 0.25s var(--ease-out-soft);
  }
  /* At rest over the hero the bar is the lighter glass. Once anything is scrolling
     under it, it takes on more body so it separates from the page. */
  .nav-shell.is-scrolled .navbar {
    background: var(--glass-bg-strong);
    border-color: var(--glass-border-strong);
    box-shadow: var(--glass-shadow-hover);
  }

  /* Brand and actions take equal slack, so the link strip sits in the middle of
     the pill rather than being pushed against the wordmark. */
  .side {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .actions {
    justify-content: flex-end;
    gap: 6px;
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 9px;
    padding: 6px 8px 6px 4px;
    border-radius: 9999px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-ui);
    letter-spacing: -0.005em;
    color: var(--ink);
    text-decoration: none;
  }
  .brand :global(.mark) {
    transition: transform 0.35s var(--ease-out-soft);
  }
  /* The sun rises a hair when you reach for home. */
  .brand:hover :global(.mark),
  .brand:focus-visible :global(.mark) {
    transform: translateY(-1px);
  }
  .word {
    white-space: nowrap;
  }
  /* Where am I: the section name lives in the bar itself once the strip folds away. */
  .where {
    display: none;
    min-width: 0;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-ui);
    font-weight: 600;
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .where-slash {
    color: var(--ink-3);
    opacity: 0.6;
  }

  .links {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 11px;
    border-radius: 9999px;
    font-size: var(--fs-ui);
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 0.15s var(--ease-out-soft);
  }
  /* The fill arrives from the left rather than snapping on. */
  .links a::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--pill-bg-hover);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.15s var(--ease-out-soft);
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--ink);
  }
  .links a:hover::before,
  .links a:focus-visible::before {
    transform: scaleX(1);
  }
  .lbl {
    position: relative;
  }
  /* The current page is marked, not merely darkened: a short line in the brand
     gradient that draws itself once when the page arrives. */
  .links a[aria-current="page"] {
    color: var(--ink);
  }
  .links a[aria-current="page"] .lbl::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -7px;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--tangerine), var(--flamingo), var(--violet));
    transform-origin: left center;
    animation: draw 0.5s var(--ease-out-soft) both;
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  .tt {
    flex: none;
  }
  .tt svg {
    width: 16px;
    height: 16px;
    transition: transform 0.4s var(--ease-out-soft);
  }
  /* Day and night trade places with a half turn. */
  .tt[data-spun="1"] svg {
    transform: rotate(180deg);
  }
  .tt .i-sun {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .tt .i-sun {
      display: block;
    }
    :root:not([data-theme="light"]) .tt .i-moon {
      display: none;
    }
  }
  :root[data-theme="dark"] .tt .i-sun {
    display: block;
  }
  :root[data-theme="dark"] .tt .i-moon {
    display: none;
  }

  .cta {
    flex: none;
  }
  .cta-short {
    display: none;
  }

  /* The menu button only exists where the strip does not. */
  .menu {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid transparent;
    border-radius: 9999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.15s var(--ease-out-soft);
  }
  .menu:hover,
  .menu:focus-visible {
    background: var(--pill-bg-hover);
  }
  .bars {
    display: block;
    position: relative;
    width: 17px;
    height: 11px;
  }
  .bars i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.22s var(--ease-out-soft),
      width 0.22s var(--ease-out-soft);
  }
  .bars i:first-child {
    top: 1px;
  }
  .bars i:last-child {
    top: 8px;
    width: 72%;
  }
  .menu[aria-expanded="true"] .bars i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu[aria-expanded="true"] .bars i:last-child {
    width: 100%;
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* The sheet. Closed it is invisible and out of the tab order; nothing is display:none,
     so it can move. */
  .sheet {
    position: absolute;
    right: 24px;
    left: 24px;
    margin-top: 8px;
    padding: 6px;
    border-radius: var(--radius-panel);
    /* A menu covers the page, so it owns its area: the card veil is for a card
       sitting in the page, and through it the headline behind stayed readable. */
    background-color: var(--veil-sheet);
    box-shadow: var(--glass-shadow-hover);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 0.18s var(--ease-out-soft),
      transform 0.18s var(--ease-out-soft),
      visibility 0.18s;
  }
  .sheet.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .sheet-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sheet-nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 10px;
    border-radius: var(--radius-md);
    font-size: var(--fs-ui);
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      background-color 0.15s var(--ease-out-soft),
      color 0.15s var(--ease-out-soft);
  }
  .sheet-nav a:hover,
  .sheet-nav a:focus-visible {
    background: var(--pill-bg-hover);
    color: var(--ink);
  }
  .sheet-nav a[aria-current="page"] {
    color: var(--ink);
  }
  .tick {
    width: 3px;
    height: 16px;
    border-radius: 2px;
    background: transparent;
    flex: none;
  }
  .sheet-nav a[aria-current="page"] .tick {
    background: linear-gradient(180deg, var(--tangerine), var(--flamingo), var(--violet));
  }
  .out {
    width: 13px;
    height: 13px;
    margin-left: auto;
    color: var(--ink-3);
  }
  .rule {
    height: 1px;
    margin: 6px 10px;
    background: var(--hairline);
  }
  .theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 6px;
    padding: 10px 10px 6px;
    border-top: 1px solid var(--hairline);
  }
  .theme-label {
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .seg {
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 9999px;
    background: var(--row-bg);
  }
  .seg button {
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    font-family: inherit;
    font-size: var(--fs-fine);
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    transition:
      background-color 0.15s var(--ease-out-soft),
      color 0.15s var(--ease-out-soft);
  }
  .seg button:hover,
  .seg button:focus-visible {
    color: var(--ink);
  }

  /* One focus ring for the whole bar, the same one the rest of the system uses. */
  .navbar a:focus-visible,
  .navbar button:focus-visible,
  .sheet a:focus-visible,
  .sheet button:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }
  .seg button[aria-pressed="true"] {
    background: var(--pill-bg-hover);
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .sheet {
      right: 40px;
      left: 40px;
    }
  }
  /* Below this the strip folds into the menu. Nothing is dropped. */
  @media (max-width: 899px) {
    .links {
      display: none;
    }
    .menu {
      display: inline-flex;
    }
    .where {
      display: flex;
    }
    .navbar {
      height: 56px;
      gap: 6px;
    }
    /* Named through .navbar so these beat .btn-sm / .btn-icon rather than tying with them. */
    .navbar .cta {
      height: 40px;
    }
    .navbar .tt {
      width: 40px;
      height: 40px;
    }
  }
  /* A finger gets 44px even where the control is drawn smaller. */
  @media (max-width: 899px) and (pointer: coarse) {
    .navbar .cta::before,
    .navbar .tt::before {
      content: "";
      position: absolute;
      top: 50%;
      right: 0;
      left: 0;
      height: 44px;
      transform: translateY(-50%);
    }
  }
  @media (max-width: 560px) {
    /* The choice does not disappear on a phone, it moves into the sheet. */
    .navbar .tt {
      display: none;
    }
    .cta-long {
      display: none;
    }
    .cta-short {
      display: inline;
    }
  }
  /* On a narrow phone the bar says one of two things: the brand, or where you are.
     Never both at once, and never neither. */
  @media (max-width: 430px) {
    .lead:has(.where) .word {
      display: none;
    }
    .lead:has(.where) .brand {
      padding-right: 2px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .links a[aria-current="page"] .lbl::after {
      animation: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const shell = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const sheet = document.querySelector<HTMLElement>("[data-menu-sheet]");
  const segments = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-theme-set]"));

  /* ---- theme -------------------------------------------------------- */
  const stored = () => {
    try {
      const t = localStorage.getItem("starlight-theme");
      return t === "light" || t === "dark" ? t : "auto";
    } catch {
      return "auto";
    }
  };
  const paint = () => {
    const now = stored();
    for (const b of segments) b.setAttribute("aria-pressed", String(b.dataset.themeSet === now));
  };
  const apply = (choice: "light" | "dark" | "auto") => {
    if (choice === "auto") {
      root.removeAttribute("data-theme");
      try {
        localStorage.removeItem("starlight-theme");
      } catch {
        // Private mode: the choice lasts for this page only.
      }
    } else {
      root.setAttribute("data-theme", choice);
      try {
        localStorage.setItem("starlight-theme", choice);
      } catch {
        // As above.
      }
    }
    paint();
  };
  paint();

  if (toggle) {
    toggle.addEventListener("click", () => {
      const explicit = root.getAttribute("data-theme");
      const dark = explicit ? explicit === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
      apply(dark ? "light" : "dark");
      // Half a turn on every press, so the icon answers the click.
      toggle.dataset.spun = toggle.dataset.spun === "1" ? "0" : "1";
    });
  }
  for (const b of segments) {
    b.addEventListener("click", () => apply((b.dataset.themeSet as "light" | "dark" | "auto") ?? "auto"));
  }

  /* ---- menu --------------------------------------------------------- */
  const setMenu = (open: boolean) => {
    if (!menuButton || !sheet) return;
    menuButton.setAttribute("aria-expanded", String(open));
    sheet.classList.toggle("is-open", open);
  };
  const isOpen = () => menuButton?.getAttribute("aria-expanded") === "true";

  menuButton?.addEventListener("click", () => setMenu(!isOpen()));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) {
      setMenu(false);
      menuButton?.focus();
    }
  });
  document.addEventListener("pointerdown", (e) => {
    if (!isOpen()) return;
    const t = e.target as Node;
    if (sheet?.contains(t) || menuButton?.contains(t)) return;
    setMenu(false);
  });
  // Focus leaving the sheet closes it, so a keyboard walks straight out of the menu.
  if (sheet) {
    sheet.addEventListener("focusout", (e) => {
      const next = e.relatedTarget as Node | null;
      if (!next || sheet.contains(next) || menuButton?.contains(next)) return;
      setMenu(false);
    });
  }
  // Widening the window brings the strip back; the sheet should not be left open behind it.
  window.matchMedia("(min-width: 900px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

  /* ---- the bar firms up past the first screen ----------------------- */
  const sentinel = document.getElementById("nav-top");
  if (shell && sentinel && "IntersectionObserver" in window) {
    new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (entry) shell.classList.toggle("is-scrolled", !entry.isIntersecting);
      },
      { threshold: 0 },
    ).observe(sentinel);
  }
</script>
