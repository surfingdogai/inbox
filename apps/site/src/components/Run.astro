---
const DEPLOY = "https://deploy.workers.cloudflare.com/?url=https://github.com/surfingdogai/inbox";
const WAITLIST = "https://network.surfingdog.ai/account/waitlist";
---

<section class="section" id="run" aria-labelledby="run-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Run it</p>
        <h2 class="h-section" id="run-h">Three ways to run</h2>
        <p class="lede">
          On Cloudflare or your own server, your data stays in your account or on your machine. Joining the network
          is optional.
        </p>
      </div>
    </div>

    <div class="grid-cards ways" data-reveal="stagger">
      <article class="glass card lift way">
        <h3 class="h-card">Deploy to Cloudflare</h3>
        <p class="card-text">
          One click on your Cloudflare account sets it up and asks for three values. You can start free.
          Sending email needs Workers Paid or a Resend key.
        </p>
        <div class="foot">
          <a class="btn btn-primary" href={DEPLOY} rel="noopener">Deploy to Cloudflare</a>
        </div>
      </article>

      <article class="glass card lift way">
        <h3 class="h-card">Your own server</h3>
        <p class="card-text">One process and one SQLite file, on Node 22.16 or newer. A one-line install is coming.</p>
        <pre class="cmd mono"><code>npx surfingdog-inbox</code><span class="pill">Coming</span></pre>
        <div class="foot">
          <a class="btn btn-secondary" href="/docs/quickstart/#your-own-server">Build it from the repo today</a>
        </div>
      </article>

      <article class="glass card lift way">
        <div class="way-head">
          <h3 class="h-card">Hosted by us</h3>
          <span class="pill">Coming</span>
        </div>
        <p class="card-text">
          We'll run it for you, with email and backups included. Leave your address and we'll write when it opens.
        </p>
        <form class="foot wait" method="post" action={WAITLIST} data-waitlist>
          <label class="label" for="wait-email">Email</label>
          <div class="wait-row">
            <input
              class="input"
              id="wait-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="you@yourbusiness.pt"
            />
            <button class="btn btn-primary" type="submit">Join the waitlist</button>
          </div>
          <p class="hint" data-waitlist-status aria-live="polite"></p>
        </form>
      </article>
    </div>
  </div>
</section>

<style>
  /* The grid and its gap come from .grid-cards; only the column count is local. */
  @media (min-width: 900px) {
    .ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .way {
    display: flex;
    flex-direction: column;
  }
  .way-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .way .card-text {
    margin-top: var(--sp-2);
  }
  .foot {
    margin-top: auto;
    padding-top: var(--sp-5);
  }
  .cmd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin: var(--sp-3) 0 0;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-control);
    background: var(--row-bg);
    border: 1px solid var(--hairline);
    color: var(--ink);
    white-space: normal;
  }
  .cmd code::before {
    content: "$ ";
    color: var(--ink-3);
  }
  .wait-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .wait-row .input {
    flex: 1 1 180px;
  }
  .hint:empty {
    display: none;
  }
</style>

<script>
  // Progressive enhancement: post the address without leaving the page; say something calm if
  // the network is not reachable yet.
  const form = document.querySelector<HTMLFormElement>("[data-waitlist]");
  const status = document.querySelector<HTMLElement>("[data-waitlist-status]");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = (form.elements.namedItem("email") as HTMLInputElement | null)?.value.trim() ?? "";
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!email || !status) return;
    status.classList.remove("error");
    status.textContent = "Joining…";
    if (button) button.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new URLSearchParams({ email }),
        headers: { accept: "application/json" },
        signal: AbortSignal.timeout(8000),
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = "You're on the list. We'll write when hosting opens.";
      form.reset();
    } catch {
      status.classList.add("error");
      status.textContent =
        "The waitlist is not reachable right now. Your address stays here; try again in a little while.";
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>
