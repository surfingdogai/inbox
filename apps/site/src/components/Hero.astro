---
const DEPLOY = "https://deploy.workers.cloudflare.com/?url=https://github.com/surfingdogai/inbox";
const LIVE = "https://inbox.surfingdog.ai/.well-known/agent-inbox.json";
---

<section class="hero wrap" aria-labelledby="hero-h">
  <div class="copy">
    <p class="eyebrow">Surfing Dog Inbox · open source</p>
    <h1 id="hero-h">Get the bookings, orders and messages. Skip the answering.</h1>
    <p class="sub">
      AI agents are about to send your business more requests than you can read. Surfing Dog gives you one inbox
      that takes them in, applies your rules and answers for you, so you get the work without the noise.
    </p>
    <div class="actions">
      <a class="btn btn-primary btn-lg" href={DEPLOY} rel="noopener">Deploy to Cloudflare</a>
      <a class="btn btn-secondary btn-lg" href={LIVE} rel="noopener">See a live instance</a>
    </div>
    <p class="position">
      <span class="rule rule-quote" aria-hidden="true"></span>
      <span>Not customer support. Automated AI relations: your rules, your availability, your AI answering.</span>
    </p>
  </div>
  <div class="art-box">
    <img
      class="hero-art day"
      src="/art/hero-day.png"
      width="1024"
      height="768"
      alt="A pixel-art dog surfing a glowing wave that carries envelopes, a calendar and a receipt, with three small robots on surfboards behind it"
      loading="eager"
      decoding="async"
    />
    <img
      class="hero-art night"
      src="/art/hero-night.png"
      width="1024"
      height="768"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 32px;
    align-items: center;
    padding-block: 44px 24px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 48px;
      padding-block: 72px 32px;
    }
  }
  h1 {
    margin: 10px 0 0;
    font-size: clamp(36px, 4.4vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.025em;
  }
  .sub {
    max-width: 50ch;
    margin: 18px 0 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }
  .position {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    max-width: 56ch;
    margin: 26px 0 0;
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
  }
  .position .rule {
    width: 28px;
  }
  .art-box {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .art-box {
      margin-inline: 0 auto;
    }
  }
  /* Each render sits on its theme's own ground; the edges dissolve into the page so no rectangle can show. */
  .hero-art {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: auto;
    mask-image: radial-gradient(ellipse 58% 58% at 50% 52%, #000 52%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 58% 58% at 50% 52%, #000 52%, transparent 100%);
  }
  .hero-art.night {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .hero-art.day {
      display: none;
    }
    :root:not([data-theme="light"]) .hero-art.night {
      display: block;
    }
  }
  :root[data-theme="dark"] .hero-art.day {
    display: none;
  }
  :root[data-theme="dark"] .hero-art.night {
    display: block;
  }
</style>
