---
/**
 * The Search product's opening, on /search under the page's own search box: what the directory is
 * in one line, the two next steps (check your business, get listed), a plain form that checks a site
 * with no script, and what is live versus being built. The small pill above the drawing reads the network itself: the API's own status and
 * the rules version in force, once at build time and again in the browser. If either cannot be
 * read it says "warming up" rather than guessing.
 */
import { stateOf } from "../lib/status";
import HeroSearch from "./HeroSearch.astro";
import StatusPill from "./StatusPill.astro";

const NETWORK = "https://network.surfingdog.ai";

async function readJson(url: string): Promise<Record<string, unknown> | null> {
  try {
    const res = await fetch(url, { headers: { accept: "application/json" }, signal: AbortSignal.timeout(4000) });
    return res.ok ? ((await res.json()) as Record<string, unknown>) : null;
  } catch {
    return null;
  }
}
const [stats, ranking] = await Promise.all([readJson(`${NETWORK}/v1/stats`), readJson(`${NETWORK}/v1/ranking`)]);
const apiOk = (stats?.status as { api?: unknown } | undefined)?.api === "ok";
const version = typeof ranking?.version === "number" ? ranking.version : null;
const live = apiOk && version !== null ? `network ok · rules v${version}` : "warming up";
---

<section class="hero wrap" id="about-search" aria-labelledby="hero-h">
  <div class="copy">
    <p class="eyebrow">Search · open network</p>
    <h2 class="hero-title" id="hero-h">Open doors to the agentic internet.</h2>
    <p class="hero-sub">An open directory your AI can search to find a business, then reach it directly.</p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/check">Check your business</a>
      <a class="btn btn-secondary btn-lg" href="#businesses">Get listed</a>
    </div>
    <form class="hero-check" method="post" action="/check">
      <label class="sr" for="hero-check-url">Your business's website</label>
      <input
        class="input check-url"
        id="hero-check-url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        autocapitalize="off"
        spellcheck="false"
        maxlength="2048"
        placeholder="yoursite.example"
        required
      />
      <button class="btn btn-secondary check-go" type="submit">Check</button>
    </form>
    <p class="check-note">
      See what an AI agent can do on your site, with a score by published rules.
    </p>
    <ul class="now">
      <li><StatusPill state={stateOf("checker")} /> <span>Check any business's website</span></li>
      <li><StatusPill state={stateOf("directory")} /> <span>Businesses with an inbox, ours or compatible</span></li>
      <li><StatusPill state={stateOf("crawler")} /> <span>A crawler for other agent doors</span></li>
    </ul>
  </div>
  <div class="art-box">
    <p class="live-row">
      <span class:list={["pill", "live", { ok: live !== "warming up" }]} data-live>
        <i aria-hidden="true"></i><span data-live-text>{live}</span>
      </span>
    </p>
    <HeroSearch />
  </div>
</section>

<style>
  /* Under the search page's own title, the display line steps down to a page title's size. */
  .hero .hero-title {
    font-size: var(--fs-page-title);
    line-height: var(--lh-title);
  }
  /* One line: the address and its button. It is plain HTML, so it works with no script at all. */
  .hero-check {
    display: flex;
    gap: var(--sp-2);
    max-width: 440px;
    margin: var(--sp-5) 0 0;
  }
  .check-url {
    flex: 1 1 auto;
    min-width: 0;
  }
  .check-go {
    flex: none;
  }
  .check-note {
    max-width: 440px;
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-fine);
    line-height: 1.5;
    color: var(--ink-3);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .now {
    display: grid;
    gap: var(--sp-2);
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-fine);
    color: var(--ink-2);
  }
  .now li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }
  .live-row {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 var(--sp-2);
  }
  .live-row .live {
    height: 20px;
    padding: 0 8px;
    gap: 6px;
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-3);
    opacity: 0.5;
  }
  .live.ok i {
    background: var(--c-success);
    opacity: 1;
  }
</style>

<script>
  // Keep the pill honest after the build: read the same two addresses again. A real answer
  // replaces the build-time text; no answer at all leaves it as built.
  const NETWORK = "https://network.surfingdog.ai";
  const pill = document.querySelector<HTMLElement>("[data-live]");
  const text = document.querySelector<HTMLElement>("[data-live-text]");
  const get = async (path: string): Promise<Record<string, unknown> | null> => {
    try {
      const res = await fetch(`${NETWORK}${path}`, {
        headers: { accept: "application/json" },
        signal: AbortSignal.timeout(6000),
      });
      return res.ok ? ((await res.json()) as Record<string, unknown>) : null;
    } catch {
      return null;
    }
  };
  if (pill && text) {
    void Promise.all([get("/v1/stats"), get("/v1/ranking")]).then(([stats, ranking]) => {
      // No answer at all (a preview host, a blocked request): keep what the build wrote.
      if (!stats && !ranking) return;
      const ok = (stats?.status as { api?: unknown } | undefined)?.api === "ok";
      const v = typeof ranking?.version === "number" ? ranking.version : null;
      const good = ok && v !== null;
      text.textContent = good ? `network ok · rules v${v}` : "warming up";
      pill.classList.toggle("ok", good);
    });
  }
</script>
