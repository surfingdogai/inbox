---
interface Props {
  /**
   * Set everywhere except the network page: adds the pointer to it and the long provenance
   * line, which that page states in full for itself.
   */
  more?: boolean;
}

const { more = false } = Astro.props;

const INSTANCE = "https://inbox.surfingdog.ai";
const NETWORK_STATS = "https://network.surfingdog.ai/v1/stats";
/** The seed business every fresh instance can load; not a name to show as ours. */
const DEMO_SEED_DOMAIN = "oficinamare.pt";

const tiles = [
  { key: "instances_online", label: "Inboxes online", sub: "checked in within 24 h" },
  { key: "businesses_listed", label: "Businesses listed", sub: "registered with the network" },
  { key: "activity_24h.bookings", label: "Bookings today", sub: "last 24 h, all inboxes" },
  { key: "activity_24h.orders", label: "Orders today", sub: "last 24 h, all inboxes" },
  { key: "activity_24h.quotes", label: "Quotes today", sub: "last 24 h, all inboxes" },
  { key: "activity_24h.messages", label: "Messages today", sub: "last 24 h, all inboxes" },
  { key: "receipts_issued", label: "Receipts issued", sub: "signed by inboxes, checked here" },
  { key: "reviews_published", label: "Reviews published", sub: "once reviews open" },
];

const doors = [
  { label: "Manifest", path: "/.well-known/agent-inbox.json" },
  { label: "OpenAPI", path: "/openapi.json" },
  { label: "MCP", path: "/mcp" },
];

const TYPE_LABELS: Record<string, { label: string; tint: string }> = {
  message: { label: "Message", tint: "message" },
  quote_request: { label: "Quote", tint: "quote" },
  booking: { label: "Booking", tint: "booking" },
  order: { label: "Order", tint: "order" },
  refund: { label: "Refund", tint: "refund" },
};

// The instance publishes no CORS headers, so its profile is read once, at build time. A short
// timeout and a fallback keep the build independent of the instance being up.
let name = "Surfing Dog";
let itemTypes = ["message", "quote_request", "booking", "order"];
try {
  const res = await fetch(`${INSTANCE}/v1/business`, { signal: AbortSignal.timeout(4000) });
  if (res.ok) {
    const profile = (await res.json()) as { name?: string; domain?: string; item_types?: string[] };
    if (profile.name && profile.domain !== DEMO_SEED_DOMAIN) name = profile.name;
    if (Array.isArray(profile.item_types) && profile.item_types.length > 0) itemTypes = profile.item_types;
  }
} catch {
  // Unreachable at build time: keep the defaults.
}
const types = itemTypes.map((t) => TYPE_LABELS[t] ?? { label: t, tint: "message" });

// The counts are read once at build time as well, so the page ships with real numbers rather
// than dashes: a share card and a reader with no JavaScript both get the figures, and the
// count-up has a value in the HTML to count to. The browser keeps them current after that.
// If the network cannot be reached the tiles stay at a dash and nothing counts.
const numbers = new Intl.NumberFormat("en-GB");
const read = (source: unknown, path: string): unknown =>
  path
    .split(".")
    .reduce<unknown>((v, k) => (v && typeof v === "object" ? (v as Record<string, unknown>)[k] : undefined), source);

let seeded: Record<string, number> = {};
try {
  const res = await fetch(NETWORK_STATS, {
    headers: { accept: "application/json" },
    signal: AbortSignal.timeout(4000),
  });
  if (res.ok) {
    const stats: unknown = await res.json();
    for (const t of tiles) {
      const value = read(stats, t.key);
      if (typeof value === "number" && Number.isFinite(value)) seeded[t.key] = value;
    }
  }
} catch {
  // Unreachable at build time: dashes, and the browser fills them in.
  seeded = {};
}
---

<section class="section" id="network" aria-labelledby="network-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Live</p>
        <h2 class="h-section" id="network-h">The network, right now</h2>
        {
          more ? (
            <p class="lede">
              Only inboxes whose owners joined the network report here, once an hour.
              <a class="link" href="/network/">What the network is for</a>
            </p>
          ) : null
        }
      </div>
      <span class="pill pill-lg" data-network-pill aria-live="polite">
        <i class="dot"></i>
        <span data-network-text>warming up</span>
      </span>
    </div>

    <div class="tiles" data-reveal="stagger">
      {
        tiles.map((t) => {
          // A tile with no number carries no data-to, so nothing counts up to a dash.
          const value = seeded[t.key];
          return (
            <div class="glass card tile">
              <p class="label">{t.label}</p>
              <p class="value u-count" data-stat={t.key} data-to={value === undefined ? undefined : String(value)}>
                {value === undefined ? "—" : numbers.format(value)}
              </p>
              <p class="sub">{t.sub}</p>
            </div>
          );
        })
      }
    </div>

    <div class="glass panel lift instance">
      <div class="inst-head">
        <div>
          <p class="eyebrow">Our inbox</p>
          <h3 class="h-sub">{name}</h3>
          <p class="card-text who">
            Try it here. Book a call, ask for a quote or send a message, yourself or through your agent.
          </p>
        </div>
        <a class="btn btn-secondary" href={INSTANCE} rel="noopener">Open our inbox</a>
      </div>
      <div class="types" aria-label="Item types accepted">
        {
          types.map((t) => (
            <span class:list={["pill", `tint-${t.tint}`]}>
              <i class:list={["dot", `dot-${t.tint}`]} />
              {t.label}
            </span>
          ))
        }
      </div>
      <dl class="doors mono">
        {
          doors.map((d) => (
            <div>
              <dt>{d.label}</dt>
              <dd>
                <a class="link" href={`${INSTANCE}${d.path}`} rel="noopener">
                  {`${INSTANCE}${d.path}`}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="fine">
      {
        more
          ? "Each joined inbox sends network.surfingdog.ai its version, its runtime and how many requests it got in the last 24 hours. Those counts carry no content, customer details or amounts. Receipts issued counts the signed receipts those inboxes share. Refreshes every minute."
          : "Refreshes every minute. What an inbox reports, and what it never reports, is set out below."
      }
    </p>
  </div>
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-row);
  }
  @media (min-width: 720px) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap-grid);
    }
  }
  .tile p {
    margin: 0;
  }
  .label {
    font-size: var(--fs-ui);
    font-weight: 600;
    line-height: var(--lh-ui);
    color: var(--ink-2);
  }
  .value {
    margin-top: var(--sp-1);
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
  }
  .sub {
    margin-top: var(--sp-1);
    font-size: var(--fs-fine);
    line-height: 1.45;
    color: var(--ink-3);
  }
  .instance {
    margin-top: var(--gap-grid);
  }
  .inst-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-6);
  }
  .inst-head .h-sub {
    margin: var(--sp-1) 0 0;
  }
  .who {
    margin-top: var(--sp-2);
  }
  .types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }
  .doors {
    display: grid;
    gap: var(--sp-2);
    margin: var(--sp-5) 0 0;
  }
  .doors > div {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: var(--sp-2);
    align-items: baseline;
  }
  .doors dt {
    font-weight: 600;
    color: var(--ink-3);
  }
  .doors dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  [data-network-pill].is-ok .dot {
    background: var(--c-success);
  }
  [data-network-pill].is-degraded .dot {
    background: var(--c-warning);
  }
</style>

<script>
  // Live numbers from the network, refreshed every minute. When it cannot be reached the tiles
  // show a dash and the pill says "warming up": never an error state on the front page.
  const STATS = "https://network.surfingdog.ai/v1/stats";
  const format = new Intl.NumberFormat("en-GB");
  const cells = Array.from(document.querySelectorAll<HTMLElement>("[data-stat]"));
  const pill = document.querySelector<HTMLElement>("[data-network-pill]");
  const text = document.querySelector<HTMLElement>("[data-network-text]");

  const read = (source: unknown, path: string): unknown =>
    path
      .split(".")
      .reduce<unknown>((v, k) => (v && typeof v === "object" ? (v as Record<string, unknown>)[k] : undefined), source);

  function state(kind: "ok" | "degraded" | "warming", label: string) {
    if (!pill || !text) return;
    pill.classList.toggle("is-ok", kind === "ok");
    pill.classList.toggle("is-degraded", kind === "degraded");
    text.textContent = label;
  }

  async function refresh() {
    try {
      const res = await fetch(STATS, {
        headers: { accept: "application/json" },
        cache: "no-store",
        signal: AbortSignal.timeout(8000),
      });
      if (!res.ok) throw new Error(String(res.status));
      const stats: unknown = await res.json();
      for (const cell of cells) {
        const value = read(stats, cell.dataset.stat ?? "");
        // The tile already carries a value from build time, which is what .u-count counts up
        // to. Keep both that target and the text it settles on in step with the live figure,
        // so a count that is running lands on the right number instead of the built one.
        if (typeof value === "number") {
          const text = format.format(value);
          cell.dataset.to = String(value);
          cell.dataset.countFinal = text;
          cell.textContent = text;
        } else {
          delete cell.dataset.to;
          delete cell.dataset.countFinal;
          cell.textContent = "—";
        }
      }
      const api = read(stats, "status.api");
      const lag = read(stats, "status.jobs_lag_seconds");
      const at = new Date().toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
      if (api === "ok" && !(typeof lag === "number" && lag > 600)) state("ok", `network ok · ${at}`);
      else state("degraded", `catching up · ${at}`);
    } catch {
      // Unreachable: a dash and a calm pill, and nothing to count up to.
      for (const cell of cells) {
        delete cell.dataset.to;
        delete cell.dataset.countFinal;
        cell.textContent = "—";
      }
      state("warming", "warming up");
    }
  }

  refresh();
  setInterval(refresh, 60_000);
</script>
