---
const INSTANCE = "https://inbox.surfingdog.ai";
/** The seed business every fresh instance can load; not a name to show as ours. */
const DEMO_SEED_DOMAIN = "oficinamare.pt";

const tiles = [
  { key: "instances_online", label: "Instances online", sub: "pinged in the last 24 h" },
  { key: "businesses_listed", label: "Businesses listed", sub: "verified in the directory" },
  { key: "activity_24h.bookings", label: "Bookings today", sub: "last 24 h, all instances" },
  { key: "activity_24h.orders", label: "Orders today", sub: "last 24 h, all instances" },
  { key: "activity_24h.quotes", label: "Quotes today", sub: "last 24 h, all instances" },
  { key: "activity_24h.messages", label: "Messages today", sub: "last 24 h, all instances" },
  { key: "receipts_issued", label: "Receipts issued", sub: "co-signed, all time" },
  { key: "reviews_published", label: "Reviews published", sub: "after reveal, all time" },
];

const doors = [
  { label: "Manifest", path: "/.well-known/agent-inbox.json" },
  { label: "OpenAPI", path: "/openapi.json" },
  { label: "MCP", path: "/mcp" },
];

const TYPE_LABELS: Record<string, { label: string; tint: string }> = {
  message: { label: "Message", tint: "message" },
  quote_request: { label: "Quote", tint: "quote" },
  booking: { label: "Booking", tint: "booking" },
  order: { label: "Order", tint: "order" },
  refund: { label: "Refund", tint: "refund" },
};

// The instance publishes no CORS headers, so its profile is read once, at build time. A short
// timeout and a fallback keep the build independent of the instance being up.
let name = "Surfing Dog";
let itemTypes = ["message", "quote_request", "booking", "order"];
try {
  const res = await fetch(`${INSTANCE}/v1/business`, { signal: AbortSignal.timeout(4000) });
  if (res.ok) {
    const profile = (await res.json()) as { name?: string; domain?: string; item_types?: string[] };
    if (profile.name && profile.domain !== DEMO_SEED_DOMAIN) name = profile.name;
    if (Array.isArray(profile.item_types) && profile.item_types.length > 0) itemTypes = profile.item_types;
  }
} catch {
  // Unreachable at build time: keep the defaults.
}
const types = itemTypes.map((t) => TYPE_LABELS[t] ?? { label: t, tint: "message" });
---

<section class="section" id="network" aria-labelledby="network-h">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Live</p>
        <h2 class="h-section" id="network-h">The network, right now</h2>
      </div>
      <span class="pill pill-lg" data-network-pill aria-live="polite">
        <i class="dot"></i>
        <span data-network-text>warming up</span>
      </span>
    </div>

    <div class="tiles">
      {
        tiles.map((t) => (
          <div class="glass tile">
            <p class="label">{t.label}</p>
            <p class="value tabular" data-stat={t.key}>
              —
            </p>
            <p class="sub">{t.sub}</p>
          </div>
        ))
      }
    </div>

    <div class="glass panel instance">
      <div class="inst-head">
        <div>
          <p class="eyebrow">Live instance</p>
          <h3>{name}</h3>
          <p class="card-text who">
            This is our own inbox. Surfing Dog runs on it: book a call, ask for a quote, or message us, as a person or
            through your agent.
          </p>
        </div>
        <a class="btn btn-secondary" href={INSTANCE} rel="noopener">Open the instance</a>
      </div>
      <div class="types" aria-label="Item types accepted">
        {
          types.map((t) => (
            <span class:list={["pill", `tint-${t.tint}`]}>
              <i class:list={["dot", `dot-${t.tint}`]} />
              {t.label}
            </span>
          ))
        }
      </div>
      <dl class="doors mono">
        {
          doors.map((d) => (
            <div>
              <dt>{d.label}</dt>
              <dd>
                <a class="link" href={`${INSTANCE}${d.path}`} rel="noopener">
                  {`${INSTANCE}${d.path}`}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <p class="fine">
      Counts come from instances that share anonymous activity counts with network.surfingdog.ai: a version, a runtime
      and the number of items in the last 24 hours. No content, no identities, no amounts. Refreshes every minute.
    </p>
  </div>
</section>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  @media (min-width: 720px) {
    .tiles {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }
  }
  .tile {
    padding: 20px 20px 18px;
    border-radius: var(--radius-panel);
  }
  .tile p {
    margin: 0;
  }
  .label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .value {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 34px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
  }
  .sub {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .instance {
    margin-top: 16px;
  }
  .inst-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px 24px;
  }
  .inst-head h3 {
    margin: 6px 0 0;
    font-size: 24px;
  }
  .who {
    max-width: 58ch;
    margin-top: 8px;
  }
  .types {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .doors {
    display: grid;
    gap: 8px;
    margin: 18px 0 0;
  }
  .doors > div {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 8px;
    align-items: baseline;
  }
  .doors dt {
    font-weight: 600;
    color: var(--ink-3);
  }
  .doors dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  [data-network-pill].is-ok .dot {
    background: var(--c-success);
  }
  [data-network-pill].is-degraded .dot {
    background: var(--c-warning);
  }
</style>

<script>
  // Live numbers from the network, refreshed every minute. When it cannot be reached the tiles
  // show a dash and the pill says "warming up": never an error state on the front page.
  const STATS = "https://network.surfingdog.ai/v1/stats";
  const format = new Intl.NumberFormat("en-GB");
  const cells = Array.from(document.querySelectorAll<HTMLElement>("[data-stat]"));
  const pill = document.querySelector<HTMLElement>("[data-network-pill]");
  const text = document.querySelector<HTMLElement>("[data-network-text]");

  const read = (source: unknown, path: string): unknown =>
    path
      .split(".")
      .reduce<unknown>((v, k) => (v && typeof v === "object" ? (v as Record<string, unknown>)[k] : undefined), source);

  function state(kind: "ok" | "degraded" | "warming", label: string) {
    if (!pill || !text) return;
    pill.classList.toggle("is-ok", kind === "ok");
    pill.classList.toggle("is-degraded", kind === "degraded");
    text.textContent = label;
  }

  async function refresh() {
    try {
      const res = await fetch(STATS, {
        headers: { accept: "application/json" },
        cache: "no-store",
        signal: AbortSignal.timeout(8000),
      });
      if (!res.ok) throw new Error(String(res.status));
      const stats: unknown = await res.json();
      for (const cell of cells) {
        const value = read(stats, cell.dataset.stat ?? "");
        cell.textContent = typeof value === "number" ? format.format(value) : "—";
      }
      const api = read(stats, "status.api");
      const lag = read(stats, "status.jobs_lag_seconds");
      const at = new Date().toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" });
      if (api === "ok" && !(typeof lag === "number" && lag > 600)) state("ok", `network ok · ${at}`);
      else state("degraded", `catching up · ${at}`);
    } catch {
      for (const cell of cells) cell.textContent = "—";
      state("warming", "warming up");
    }
  }

  refresh();
  setInterval(refresh, 60_000);
</script>
