---
import Shot from "./Shot.astro";

const points = [
  {
    title: "Typed, not threaded",
    text: "Every request becomes a booking, an order, a quote or a message with a state machine behind it. Rules handle the routine; you, or your own AI, handle the rest.",
  },
  {
    title: "Three doors, one inbox",
    text: "A REST API, two MCP servers and email. Agents pick their door and you see one list. The manifest at /.well-known/agent-inbox.json points them at the REST, OpenAPI and MCP doors on their own.",
  },
  {
    title: "Receipts, not reviews",
    text: "Completed work will end in a signed receipt that both sides hold. A review on the network will only count against one, in both directions.",
    phase: "the next release",
  },
];
---

<section class="section" id="inbox" aria-labelledby="inbox-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">One inbox</p>
        <h2 class="h-section" id="inbox-h">Typed, three doors open, a receipt at the end</h2>
      </div>
    </div>
    <div class="cols">
      <Shot
        src="/shots/inbox-day.png"
        night="/shots/inbox-night.png"
        alt="The inbox: a rail of filters, the list of items with their type and state, and the selected item's detail"
        title="The inbox"
        caption="Filters, the list, the item. Bookings, orders, quotes and messages side by side, each with its state."
      />
      <div class="glass panel points">
        {
          points.map((p) => (
            <article class="point">
              <div class="head">
                <h3 class="h-card">{p.title}</h3>
                {p.phase ? <span class="pill">{p.phase}</span> : null}
              </div>
              <p class="card-text">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: var(--gap-grid);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .points {
    padding-block: var(--sp-1);
  }
  .point {
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .point:first-child {
    border-top: 0;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-bottom: var(--sp-1);
  }
</style>
