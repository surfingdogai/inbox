---
import Shot from "./Shot.astro";

/** `phase` marks a point that is not shipped yet; every point below is live today. */
const points: { title: string; text: string; phase?: string }[] = [
  {
    title: "Each request has a type",
    text: "Every request is a booking, an order, a quote or a message, and it moves step by step until it's done.",
  },
  {
    title: "Many ways in, one list",
    text: "Agents reach you through a REST API, MCP or email, and it all lands in one list. Your own AI connects over a separate owner MCP.",
  },
  {
    title: "A signed receipt",
    text: "When a booking is confirmed or an order is paid, the inbox signs a receipt. The customer's agent can counter-sign it.",
  },
];
---

<section class="section" id="inbox" aria-labelledby="inbox-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">One inbox</p>
        <h2 class="h-section" id="inbox-h">Every request in one list</h2>
      </div>
    </div>
    <div class="cols">
      <Shot
        src="/shots/inbox-day.png"
        night="/shots/inbox-night.png"
        alt="The inbox: filters on the left, the list of requests with their type and state, and the one selected"
        title="The inbox"
        caption="Bookings, orders, quotes and messages in one list, each showing where it stands."
      />
      <div class="glass panel points">
        {
          points.map((p) => (
            <article class="point">
              <div class="head">
                <h3 class="h-card">{p.title}</h3>
                {p.phase ? <span class="pill">{p.phase}</span> : null}
              </div>
              <p class="card-text">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: var(--gap-grid);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .points {
    padding-block: var(--sp-1);
  }
  .point {
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .point:first-child {
    border-top: 0;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-bottom: var(--sp-1);
  }
</style>
