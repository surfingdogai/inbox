---
import Shot from "./Shot.astro";

const points = [
  {
    title: "Typed, not threaded",
    text: "Every request becomes a booking, an order, a quote or a message with a state machine behind it. Rules handle the routine; you, or your own AI, handle the rest.",
  },
  {
    title: "Every door open",
    text: "Email, web form, REST and MCP today; A2A, UCP and more as adapters. Agents pick their door, you see one inbox. One manifest at /.well-known/agent-inbox.json lists every door.",
  },
  {
    title: "Receipts, not reviews",
    text: "When an item is confirmed the instance issues a signed receipt and the customer's agent counter-signs it. A review on the network is only valid against a receipt, in both directions.",
    phase: "the next release",
  },
];
---

<section class="section" id="inbox" aria-labelledby="inbox-h">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">One inbox</p>
        <h2 class="h-section" id="inbox-h">Typed, every door open, a receipt at the end</h2>
      </div>
    </div>
    <div class="cols">
      <Shot
        src="/shots/inbox-day.png"
        night="/shots/inbox-night.png"
        alt="The inbox: a rail of filters, the list of items with their type and state, and the selected item's detail"
        title="The inbox"
        caption="Filters, the list, the item. Bookings, orders, quotes and messages side by side, each with its state."
      />
      <div class="glass panel points">
        {
          points.map((p) => (
            <article class="point">
              <div class="head">
                <h3>{p.title}</h3>
                {p.phase ? <span class="pill">{p.phase}</span> : null}
              </div>
              <p class="card-text">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 16px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 20px;
    }
  }
  .points {
    padding-block: 6px;
  }
  .point {
    padding: 16px 0;
    border-top: 1px solid var(--hairline);
  }
  .point:first-child {
    border-top: 0;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 4px;
  }
  h3 {
    margin: 0;
    font-size: 17px;
  }
</style>
