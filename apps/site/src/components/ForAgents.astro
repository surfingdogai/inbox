---
/** A short band for agent builders. The full specification lives on /technical. */
const MANIFEST = "https://inbox.surfingdog.ai/.well-known/agent-inbox.json";
---

<section class="section" id="agents" aria-labelledby="agents-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">For agents</p>
        <h2 class="h-section" id="agents-h">Start at the manifest</h2>
        <p class="lede">
          One document tells an agent which doors an inbox opens and where they are. A refusal about the request names the
          field to fix, so an agent repairs its request and retries once.
        </p>
      </div>
      <a class="btn btn-secondary" href="/technical/">The technical page</a>
    </div>
    <p class="glass panel lift manifest mono">
      <a class="link" href={MANIFEST} rel="noopener">{MANIFEST}</a>
    </p>
  </div>
</section>

<style>
  .manifest {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
