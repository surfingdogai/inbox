       sun sets before the moon returns, so the two are never drawn on top of
       each other. */
    day=ramp(t,T.day,T.day+.4);v=ramp(t,T.exit+.35,T.exit+.7);
    op(moon,cl(1-day+v));mv(moon,0,5*day*(1-v));
    day=ramp(t,T.day+.35,T.day+.8);v=ramp(t,T.exit,T.exit+.35);
    op(sun,day*(1-v));mv(sun,0,5*(1-day)+5*v);
    /* measured from STILL, so the rays the markup draws are the rays the
       first live frame draws */
    rays.style.transform="rotate("+((t-STILL)*9).toFixed(1)+"deg)";
    up=t>=T.wake&&t<T.exit+.3;
    op(awake,up?1:0);op(asleep,up?0:1);
    op(zz,cl((1-ramp(t,T.wake-.35,T.wake+.05))+ramp(t,T.exit+.3,T.exit+.7)));
    /* four whole bobs a loop, so the z's are where they started when the loop wraps */
    mv(zz,0,-2.4*Math.sin(t*ZB));
  }

  var timers=[],fired={};
  function flash(el,c,ms){el.classList.add(c);timers.push(setTimeout(function(){el.classList.remove(c);},ms));}
  function cue(t,live){
    function at(key,when,el,c){if(t<when||fired[key])return;fired[key]=true;if(live)flash(el,c,820);}
    B.forEach(function(b,k){at("b"+k,b.t,agents[b.a],"wake");});
    at("door",T.card+.9,door,"open");
    IT.forEach(function(it,n){
      at("c"+n,it.L,agents[it.a],"wake");
      at("r"+n,it.L+TRAVEL+.4,rule,"pulse");
      if(it.auto)at("h"+n,T.yes+BACK,agents[it.a],"wake");
    });
    at("give",T.give+GIVE,given,"land");
    at("wake",T.wake,owner,"wake");
  }
  function settle(){
    timers.forEach(clearTimeout);timers.length=0;
    agents.forEach(function(a){a.classList.remove("wake");});
    door.classList.remove("open");given.classList.remove("land");owner.classList.remove("wake");
    rule.classList.remove("pulse");
  }

  /* Chips and the rule strip are measured, never guessed, so a wider fallback
     font cannot push a word out of its pill. The drawn widths are floors and
     fit() only raises, so measuring again cannot ratchet anything wider. */
  var FLOOR=W.slice(),S0=[],S1=[];
  /* The length along a line at which it reaches x. Every line runs left to
     right, so x only grows along it and halving the interval finds it. */
  function atX(ln,len,x){
    var lo=0,hi=len,m,j;
    for(j=0;j<22;j++){m=(lo+hi)/2;if(ln.getPointAtLength(m).x<x)lo=m;else hi=m;}
    return (lo+hi)/2;
  }
  /* Each chip's walk: its back edge clr() clear of the assistants, its front
     edge clr() short of the jambs. Rerun whenever a pill or the step changes. */
  function stops(){
    var c=clr(CS);
    IT.forEach(function(it,n){
      var ln=lines[it.a],len=NL[it.a],hw=W[n]*CS/2;
      S1[n]=atX(ln,len,JAMB-c-hw);
      S0[n]=Math.min(atX(ln,len,AGX+c+hw),S1[n]);
    });
  }
  stops();
  function fit(){
    var cs=parseFloat(getComputedStyle(svg).getPropertyValue("--sfl-cs"));
    if(cs>0)CS=cs;
    var ds=parseFloat(getComputedStyle(svg).getPropertyValue("--sfl-ds"));
    if(ds>0)DS=ds;
    labels.forEach(function(lb,k){
      var b,c=lb.parentNode,w,h;
      try{b=lb.getBBox();}catch(err){return;}
      if(!b||!b.width)return;
      w=Math.max(FLOOR[k],Math.ceil(b.width+28));h=w/2;W[k]=w;
      c.querySelectorAll("rect").forEach(function(r){r.setAttribute("x",-h);r.setAttribute("width",w);});
      c.querySelector(".dot").setAttribute("cx",-h+10);
      lb.setAttribute("x",-h+18);
    });
    var rb;
    try{rb=ruleTx.getBBox();}catch(err){rb=null;}
    if(rb&&rb.width){
      var rw=Math.max(104,Math.ceil(rb.width+24));
      ruleBg.setAttribute("width",rw);
      /* With no pill (the narrow step) the stylesheet seats the beat just after
         the words instead, so the markup and the first live frame agree. */
      beat.setAttribute("cx",RX+rw+14);
    }
    stops();
  }

  /* The markup already is render(STILL): the clock starts there so the live
     piece continues from what is painted, never snapping to an empty stage. */
  render(STILL);
  cue(STILL,false);
  fit();
  if("ResizeObserver" in window)new ResizeObserver(fit).observe(fig);
  try{
    if(document.fonts&&document.fonts.ready&&document.fonts.ready.then)
      document.fonts.ready.then(fit,function(){});
  }catch(err){}

  var clock=STILL,last=0,raf=0,run=false,seen=true,wasP=STILL,
      mq=matchMedia("(prefers-reduced-motion:reduce)");

  function frame(now){
    if(!run)return;
    /* Clamped both ways. A long stall slows the piece rather than teleporting
       it; and the first rAF timestamp can fall before the performance.now()
       that sync() took, which would step the clock back past wasP, read as a
       wrap, re-arm every cue and flash all the halos at mount. */
    clock+=Math.max(0,Math.min((now-last)/1000,.05));
    last=now;
    var ph=clock%LOOP;
    if(ph<wasP)fired={};                    /* a new pass re-arms the one-shots */
    wasP=ph;
    render(ph);cue(ph,true);
    raf=requestAnimationFrame(frame);
  }
  function sync(){
    if(fig.classList.contains("sfl-still"))return;
    var want=seen&&!document.hidden;
    if(want===run)return;
    run=want;
    if(run){fig.classList.remove("sfl-paused");settle();last=performance.now();raf=requestAnimationFrame(frame);}
    else{cancelAnimationFrame(raf);fig.classList.add("sfl-paused");}
  }

  /* One frame, all four beats' outcome: the door, the typed rows, the yeses
     home, the quote with the owner in the morning. */
  function still(){
    fig.classList.add("sfl-still");
    run=false;cancelAnimationFrame(raf);
    settle();render(STILL);
  }

  if(mq.matches){still();return;}
  if("IntersectionObserver" in window){
    new IntersectionObserver(function(es){seen=es[0].isIntersecting;sync();},{threshold:.01}).observe(fig);
  }
  document.addEventListener("visibilitychange",sync);
  /* The preference can be turned on after load; both paths end in the same frame. */
  function onMq(){if(mq.matches&&!fig.classList.contains("sfl-still"))still();}
  if(mq.addEventListener)mq.addEventListener("change",onMq);
  else if(mq.addListener)mq.addListener(onMq);
  sync();
}

function mountAll(){
  document.querySelectorAll(".sfl").forEach(function(f){
    try{mount(f);}catch(err){if(window.console&&console.warn)console.warn("cover flood",err);}
  });
}
mountAll();
document.addEventListener("astro:page-load",mountAll);   /* harmless today; correct the day a router lands */
})();
</script>
