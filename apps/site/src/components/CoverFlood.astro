.sfl .sfl-row .bg{fill:var(--sfl-row)}
.sfl .sfl-row .bar{fill:var(--tc)}
.sfl .sfl-row .lb{font-size:10.4px;font-weight:600;fill:var(--ti)}
.sfl .sfl-row .st{font-size:9px;fill:var(--sfl-sun-i)}
.sfl .sfl-tick{fill:none;stroke:var(--sfl-palm-i);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
