  .sfl:not([data-sfl="on"]) .sfl-given .dot{cx:-23px}
  .sfl:not([data-sfl="on"]) .sfl-given .lb{transform:translate(-4px,1.2px)}
  .sfl .sfl-line,.sfl .sfl-card-edge{stroke-width:2}
  .sfl .sfl-glint{stroke-width:3.6}
  .sfl .sfl-agent rect,.sfl .sfl-agent line,.sfl .sfl-owner .face,.sfl .sfl-owner .counter,
  .sfl .sfl-dev,.sfl .sfl-dev-l,.sfl .sfl-scrawl,.sfl .sfl-rings path,.sfl .sfl-moon,
  .sfl .sfl-asleep path{stroke-width:2.1}
  .sfl .sfl-sun .rays{stroke-width:2.2}
  .sfl .sfl-tick{stroke-width:2.8}
  .sfl .sfl-door .jamb{stroke-width:3}
  .sfl .sfl-link{stroke-width:2.6;stroke-dasharray:2.5 7.5}
}

/* Off screen or on a hidden tab the clock stops and sfl-paused stops the CSS
   keyframes with it. !important because the rules that start them use the
   animation shorthand, which resets play-state and is more specific. */
.sfl.sfl-still,.sfl.sfl-still *{animation:none!important;transition:none!important}
.sfl.sfl-paused *{animation-play-state:paused!important}
@media (prefers-reduced-motion:reduce){.sfl *{animation:none!important;transition:none!important}}
