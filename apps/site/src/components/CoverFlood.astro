<style is:global>
/* Every selector starts with .sfl and every keyframe is sfl-*, so nothing leaks.
   .sfl is also the query container the width steps match. Colours are
   properties: host token first, brand literal only as the fallback, carried
   through light-dark() because the tokens package sets color-scheme in all
   three theme cases — the same single block CoverReceipts uses. */
.sfl{
  --sfl-ground:var(--ground,light-dark(#f6f5ff,#0d0e26));
  --sfl-ink2:var(--ink-2,light-dark(#3f4472,#b9bce0));
  --sfl-ink3:var(--ink-3,light-dark(#565a86,#9a9dc4));
  --sfl-hair:var(--hairline,light-dark(rgba(20,22,60,.08),rgba(255,255,255,.10)));
  --sfl-glass:var(--glass-bg,light-dark(rgba(255,255,255,.32),rgba(255,255,255,.07)));
  --sfl-row:var(--row-bg,light-dark(rgba(255,255,255,.24),rgba(255,255,255,.05)));
  --sfl-booking:var(--c-booking,#ff6fa8);  --sfl-booking-i:var(--c-booking-ink,light-dark(#b02a6b,#ff8fbc));
  --sfl-order:var(--c-order,#ff9650);      --sfl-order-i:var(--c-order-ink,light-dark(#9c4409,#ffb27c));
  --sfl-quote:var(--c-quote,#8a6bff);      --sfl-quote-i:var(--c-quote-ink,light-dark(#5a3fd0,#ab95ff));
  --sfl-message:var(--c-message,#25cfe0);  --sfl-message-i:var(--c-message-ink,light-dark(#0b6a75,#63e2ee));
  --sfl-palm:var(--c-success,#2fd3a5);     --sfl-palm-i:var(--c-success-ink,light-dark(#147a5c,#72e6c3));
  --sfl-sun:var(--c-warning,#ffcf5c);      --sfl-sun-i:var(--c-warning-ink,light-dark(#866000,#ffda80));
  --sfl-flam:var(--flamingo,#ff6fa8);
  --sfl-violet:var(--violet,#8a6bff);
  --sfl-lagoon:var(--lagoon,#25cfe0);
  --sfl-tang:var(--tangerine,#ff9650);
  --sfl-ease:var(--ease-out-soft,cubic-bezier(.2,.8,.2,1));
  display:block;margin:0;width:100%;aspect-ratio:640/360;container-type:inline-size;
}
/* One pair of properties carries an item's type wherever it goes: on the line,
   in its row, and in the hand of the owner. */
.sfl .t-booking{--tc:var(--sfl-booking);--ti:var(--sfl-booking-i)}
.sfl .t-order  {--tc:var(--sfl-order);  --ti:var(--sfl-order-i)}
.sfl .t-quote  {--tc:var(--sfl-quote);  --ti:var(--sfl-quote-i)}
.sfl .t-message{--tc:var(--sfl-message);--ti:var(--sfl-message-i)}

.sfl svg{display:block;width:100%;height:auto;overflow:hidden;--sfl-cs:1;--sfl-ds:1}
/* Travelling pieces scale as one unit at the narrow steps — pill and word
   together — so a word can never outgrow its pill. Each is drawn centred on
   its own origin, so the fill-box centre is the point that travels. */
.sfl .sc,.sfl .sd{transform-box:fill-box;transform-origin:50% 50%}
.sfl .sc{transform:scale(var(--sfl-cs))}
.sfl .sd{transform:scale(var(--sfl-ds))}
.sfl text{font-family:var(--font-sans,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif);fill:var(--sfl-ink2)}
.sfl .sfl-cap{font-size:11px;letter-spacing:.11em}
.sfl .sfl-title{font-family:var(--font-display,ui-sans-serif,system-ui,sans-serif);font-size:13.5px;font-weight:600;letter-spacing:-.01em}
.sfl .sfl-hair{stroke:var(--sfl-hair);stroke-width:1}
.sfl .sfl-cut{fill:var(--sfl-ground)}
.sfl .sfl-guide{fill:none;stroke:none}   /* geometry the bubbles travel, never ink */

/* the assistants: drawn in ink, identity in one tinted antenna, as in the hero */
.sfl .sfl-agent rect,.sfl .sfl-agent line{fill:none;stroke:var(--sfl-ink2);stroke-opacity:.55;stroke-width:1.2}
.sfl .sfl-agent .tint{fill:var(--ag);fill-opacity:.08;stroke:none}
.sfl .sfl-agent .eye{fill:var(--sfl-ink2);fill-opacity:.5}
.sfl .sfl-agent .ant{fill:var(--ag)}
.sfl .sfl-agent .halo,.sfl .sfl-door .halo,.sfl .sfl-owner .halo{fill:none;stroke-opacity:0;stroke-width:1.2;transform-box:fill-box;transform-origin:50% 50%}
.sfl .sfl-agent .halo{stroke:var(--ag)}
.sfl .sfl-agent.wake .halo{animation:sfl-halo .64s var(--sfl-ease)}
@keyframes sfl-halo{0%{stroke-opacity:.5;transform:scale(.84)}100%{stroke-opacity:0;transform:scale(1.28)}}

/* the old ways in: a phone and a contact form, quiet ink, nothing alarming */
.sfl .sfl-old{opacity:0}
.sfl .sfl-dev{fill:var(--sfl-glass);stroke:var(--sfl-ink3);stroke-opacity:.5;stroke-width:1.2}
