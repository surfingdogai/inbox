.sfl .sfl-dev-d{fill:var(--sfl-ink3);fill-opacity:.35}
.sfl .sfl-phone,.sfl .sfl-devs{transform-box:fill-box;transform-origin:50% 50%}
.sfl .sfl-miss{fill:var(--sfl-sun)}
.sfl .sfl-rings path{fill:none;stroke:var(--sfl-ink3);stroke-opacity:.55;stroke-width:1.2;stroke-linecap:round}
