  .sfl .sfl-rule text{font-size:13px}
  .sfl .sfl-row .lb{font-size:15px}
  .sfl .sfl-row .st{font-size:12.5px}
  .sfl .sfl-line,.sfl .sfl-card-edge{stroke-width:1.5}
  .sfl .sfl-glint{stroke-width:2.8}
  .sfl .sfl-agent rect,.sfl .sfl-agent line,.sfl .sfl-owner .face,.sfl .sfl-owner .counter,
  .sfl .sfl-dev,.sfl .sfl-dev-l,.sfl .sfl-scrawl,.sfl .sfl-rings path,.sfl .sfl-moon{stroke-width:1.6}
  .sfl .sfl-tick{stroke-width:2.1}
  .sfl .sfl-link{stroke-width:1.9;stroke-dasharray:2 6}
}
@container (max-width:400px){
  .sfl svg{--sfl-cs:1.6;--sfl-ds:1.35}
  .sfl .sfl-cap{font-size:21px}
  .sfl .sfl-title{font-size:23px}
  .sfl .sfl-row .lb{font-size:22px;transform:translateY(2.4px)}
  .sfl .sfl-row .st,.sfl .sfl-zz{display:none}
  /* at this size the strip's pill would pinch its words, so the words stand
     alone on the rows' left edge and the beat keeps its place after them */
  .sfl .sfl-rule rect{display:none}
  .sfl .sfl-rule text{font-size:21px;transform:translateX(-12px)}
  .sfl .sfl-rule .sfl-beat{cx:348px}   /* just after the words, with room for a wider fallback font */
  /* The quote in the owner's hand is part of the finished picture, so its word
     reads at the rows' size; fit() widens its pill to match. The chips still
     in flight keep the smaller word, because a wider pill would leave them no
     room to travel, and the row each one becomes lands at full size. */
  .sfl .sfl-given .lb{font-size:13px;transform:translateY(1.2px)}
