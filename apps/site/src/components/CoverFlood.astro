   when it left the item for a person */
.sfl .sfl-rule rect{fill:none;stroke:var(--sfl-ink3);stroke-opacity:.30;stroke-width:1;transition:stroke-opacity .3s var(--sfl-ease)}
.sfl .sfl-rule text{font-size:9.8px}
.sfl .sfl-rule.lit rect{stroke-opacity:.6}
