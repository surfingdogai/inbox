---
/**
 * The live counts: how many businesses the crawler has checked, how many are agent-ready, and of
 * those how many take messages, bookings, orders and payment or have a catalogue. Read in the
 * browser from GET /v1/stats on this same address (its "directory" block, counted at most every ten
 * minutes by the network). Aggregates only: the block never names a business.
 *
 * At rest, before the answer or without one, the page shows dashes and says where the numbers come
 * from; it never prints a number it did not read (nor zeros the network says it could not take).
 * The numbers count up once, gently, and not at all under reduced motion. The counting is hidden
 * from screen readers: a separate live region says the final numbers once.
 */
---

<div class="counts" data-counts>
  <p class="c-main">
    <span class="c-pair"><b class="c-n tabular" data-n="checked">–</b> businesses checked</span>
    <span class="c-dot" aria-hidden="true">·</span>
    <span class="c-pair"><b class="c-n tabular" data-n="agent_ready">–</b> agent-ready</span>
  </p>
  <ul class="c-caps" data-caps aria-label="Of the agent-ready businesses" hidden></ul>
  <p class="c-note" data-note>Live counts from the network.</p>
  <p class="sr" aria-live="polite" data-said></p>
</div>

<style>
  .counts {
    display: grid;
    justify-items: center;
    gap: var(--sp-2);
    text-align: center;
  }
  .c-main {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-1) var(--sp-3);
    margin: 0;
    font-size: var(--fs-ui);
    color: var(--ink-2);
  }
  .c-pair {
    white-space: nowrap;
  }
  .c-n {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-h-card);
    color: var(--ink);
  }
  .c-dot {
    color: var(--ink-3);
  }
  /* On a phone the two counts stack, so the dot between them would hang at a line's end. */
  @media (max-width: 420px) {
    .c-dot {
      display: none;
    }
  }
  .c-caps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-1) var(--sp-4);
    max-width: 560px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-fine);
    color: var(--ink-3);
  }
  .c-caps :global(li) {
    white-space: nowrap;
  }
  .c-caps :global(b) {
    font-weight: 600;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .c-note {
    margin: 0;
    font-size: var(--fs-fine);
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }
  /* The block arrives softly rather than snapping in. */
  .counts.is-in .c-caps,
  .counts.is-in .c-note {
    animation: counts-in var(--dur-slow) var(--ease) both;
  }
  @keyframes counts-in {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .counts.is-in .c-caps,
    .counts.is-in .c-note {
      animation: none;
    }
  }
</style>

<script>
  import { ago, countRows, readDirectory } from "../lib/ask";

  const root = document.querySelector<HTMLElement>("[data-counts]");
  const fmt = new Intl.NumberFormat("en");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Count up to n, once; the final text is exact. */
  const count = (el: HTMLElement, n: number) => {
    if (still || n < 3) {
      el.textContent = fmt.format(n);
      return;
    }
    const start = performance.now();
    const ms = 900;
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / ms);
      el.textContent = fmt.format(Math.round(n * (1 - (1 - t) ** 3)));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  async function paint(): Promise<void> {
    if (!root) return;
    const note = root.querySelector<HTMLElement>("[data-note]");
    const said = root.querySelector<HTMLElement>("[data-said]");
    const caps = root.querySelector<HTMLElement>("[data-caps]");
    let stats: unknown = null;
    try {
      const res = await fetch("/v1/stats", { headers: { accept: "application/json" }, signal: AbortSignal.timeout(8000) });
      if (res.ok) stats = await res.json();
    } catch {
      stats = null;
    }
    const d = readDirectory(stats);
    if (!d) {
      // Nothing to show is said plainly; the dashes stay dashes.
      // No block yet: the network has not published counts. A block it could not fill is no answer.
      const noBlock = !!stats && typeof stats === "object" && !("directory" in stats);
      if (note) note.textContent = noBlock ? "Counts appear here once the crawler publishes them." : "The counts are not answering just now.";
      return;
    }
    // The animated numbers are for the eye; a screen reader hears the final ones, once.
    root.querySelector(".c-main")?.setAttribute("aria-hidden", "true");
    root.querySelector("[data-caps]")?.setAttribute("aria-hidden", "true");
    if (said) {
      const rows = countRows(d).map((r) => `${fmt.format(r.n)} ${r.label}`);
      said.textContent =
        `${fmt.format(d.checked)} businesses checked, ${fmt.format(d.agent_ready)} agent-ready.` +
        (rows.length ? ` Of those, ${rows.join(", ")}.` : "");
    }
    for (const el of Array.from(root.querySelectorAll<HTMLElement>("[data-n]"))) {
      count(el, el.dataset.n === "checked" ? d.checked : d.agent_ready);
    }
    if (caps) {
      caps.replaceChildren(
        ...countRows(d).map((r) => {
          const li = document.createElement("li");
          const b = document.createElement("b");
          li.append(b, ` ${r.label}`);
          count(b, r.n);
          return li;
        }),
      );
      caps.hidden = false;
    }
    if (note) {
      const t = document.createElement("time");
      t.dateTime = d.as_of;
      t.title = new Date(d.as_of).toLocaleString();
      t.textContent = ago(d.as_of);
      note.replaceChildren("Of the agent-ready businesses · updated ", t);
    }
    root.classList.add("is-in");
  }
  void paint();
</script>
