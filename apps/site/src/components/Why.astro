---
/** Why a business wants this, in its own words: it wants the work, there will be a lot of it, it has no time to answer. */
const reasons = [
  {
    title: "You want the work.",
    body: "Bookings, orders, quotes and messages come in from people and their agents, with the details already filled in.",
  },
  {
    title: "There will be a lot of it.",
    body: "Agents ask at any hour, and can ask several businesses at once. A normal mailbox can't keep up.",
  },
  {
    title: "You have no time to answer.",
    body: "Your rules and your own AI answer within the limits you set. You see what needs a person.",
  },
];
---

<section class="section why" aria-labelledby="why-h" data-reveal>
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">Why</p>
        <h2 class="h-section" id="why-h">Work from agents needs its own inbox.</h2>
      </div>
    </div>
    <ul class="grid-cards reasons" data-reveal="stagger">
      {
        reasons.map((r, i) => (
          <li class="glass card reason">
            <span class="num tabular" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="h-card">{r.title}</h3>
            <p class="card-text">{r.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="more">
      <a class="link" href="/how-it-works/">Follow one request from start to finish</a>
    </p>
  </div>
</section>

<style>
  .reasons {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .reasons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .num {
    display: block;
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: 0.09em;
    color: var(--ink-3);
  }
  .reason .h-card {
    margin-top: var(--sp-2);
  }
  .reason .card-text {
    margin-top: var(--sp-2);
  }
  .more {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-card);
  }
</style>
