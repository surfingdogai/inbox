<script>
  /* A small clock per drawing. It never draws anything: it only says which
     step of the pass the drawing is at, and CSS does the rest. */
  const pad = (v: string | undefined, d: number) => {
    const n = Number(v);
    return Number.isFinite(n) && v !== undefined && v !== "" ? n : d;
  };

  function bbox(t: SVGGraphicsElement): DOMRect | null {
    try {
      const b = t.getBBox();
      return b?.width ? b : null;
    } catch {
      return null;
    }
  }

  /* A pill holds its word: [pad][mark][word][pad], anchored left (l), right (r)
     or on a centre (c), or just after another pill (data-after). */
  function fitPill(g: SVGGElement, svg: SVGSVGElement) {
    const rect = g.querySelector<SVGRectElement>(":scope > rect");
    const text = g.querySelector<SVGTextElement>(":scope > text");
    const ic = g.querySelector<SVGGElement>(":scope > .ic");
    if (!rect || !text || getComputedStyle(text).display === "none") return;
    const b = bbox(text);
    if (!b) return;
    const P = pad(g.dataset.pad, 8);
    const icr = ic ? pad(g.dataset.icr, 3.5) : 0;
    const icw = ic ? icr * 2 + 4 : 0;
    const W = Math.ceil(P + icw + b.width + P);
    const mode = g.dataset.fit;
    let x0: number;
    if (mode === "r") {
      x0 = pad(g.dataset.r, 0) - W;
      text.setAttribute("x", String(pad(g.dataset.r, 0) - P));
    } else {
      if (mode === "c") x0 = pad(g.dataset.cx, 0) - W / 2;
      else {
        x0 = pad(g.dataset.x, 0);
        const after = g.dataset.after ? svg.querySelector<SVGGElement>(`.${g.dataset.after} > rect`) : null;
        if (after) x0 = pad(after.getAttribute("x") ?? "", 0) + pad(after.getAttribute("width") ?? "", 0) + 6;
      }
      text.setAttribute("x", String(x0 + P + icw));
    }
    rect.setAttribute("x", String(x0));
    rect.setAttribute("width", String(W));
    if (ic) ic.setAttribute("transform", `translate(${(x0 + P + icr).toFixed(1)},${pad(g.dataset.cy, 0)})`);
  }

  function mount(fig: HTMLElement) {
    if (fig.dataset.saOn === "on") return;
    fig.dataset.saOn = "on";
    const svg = fig.querySelector("svg");
    if (!svg) return;
    const steps = (fig.dataset.steps ?? "").split(",").map(Number).filter(Number.isFinite);
    const LOOP = pad(fig.dataset.loop, 10);
    const OUT = pad(fig.dataset.out, LOOP - 1.5);
    const START = pad(fig.dataset.start, OUT - 1.5);

    /* ---- words are measured, never guessed ------------------------------ */
    const pills = Array.from(svg.querySelectorAll<SVGGElement>("[data-fit]"));
    const fit = () => {
      for (const g of pills) fitPill(g, svg);
    };
    let narrow: boolean | null = null;
    let measured = false;
    const gauge = () => {
      const w = fig.clientWidth;
      const nw = w > 0 && w <= 420;
      if (nw === narrow && measured) return;
      narrow = nw;
      if (w > 0) {
        fit();
        measured = true;
      }
    };
    gauge();
    if ("ResizeObserver" in window) new ResizeObserver(gauge).observe(fig);
    document.fonts?.ready.then(fit, () => {});

    const mq = matchMedia("(prefers-reduced-motion: reduce)");
    const K = steps.map((_, i) => `k${i}`);
    const F = steps.map((_, i) => `f${i}`);
    const timers: number[] = [];
    let clock = START;
    let prev = -1;
    let last = 0;
    let raf = 0;
    let run = false;
    let seen = false;
    let armed = false;
    /* A drawing that is already on the first screen waits, at rest, for the
       visitor's first scroll: on arrival the hero is the one thing moving. */
    let moved = window.scrollY > 0;

    function flash(cls: string) {
      fig.classList.remove(cls);
      void fig.getBoundingClientRect();
      fig.classList.add(cls);
      timers.push(window.setTimeout(() => fig.classList.remove(cls), 900));
    }
    function apply(ph: number, live: boolean) {
      if (prev >= 0 && ph < prev) {
        /* the wrap: back to the start, unseen */
        fig.classList.add("nt");
        fig.classList.remove("out", ...K);
        void fig.getBoundingClientRect();
        fig.classList.remove("nt");
      }
      steps.forEach((t, i) => {
        const on = ph >= t;
        const k = K[i] ?? "";
        if (on && live && !fig.classList.contains(k) && prev >= 0) flash(F[i] ?? "");
        fig.classList.toggle(k, on);
      });
      fig.classList.toggle("out", ph >= OUT);
      prev = ph;
    }
    function frame(now: number) {
      if (!run) return;
      clock += Math.min((now - last) / 1000, 0.05);
      last = now;
      apply(clock % LOOP, true);
      raf = requestAnimationFrame(frame);
    }
    function clear() {
      for (const t of timers) clearTimeout(t);
      timers.length = 0;
      fig.classList.remove(...F);
    }
    function sync() {
      if (mq.matches) return;
      const go = seen && !document.hidden && moved;
      if (go && !armed) {
        /* armed at the resting frame: every step is already on, so nothing moves */
        armed = true;
        apply(START, false);
        fig.classList.add("go");
      }
      if (go === run) return;
      run = go;
      if (run) {
        fig.classList.remove("paused");
        clear();
        prev = -1;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      } else {
        cancelAnimationFrame(raf);
        fig.classList.add("paused");
      }
    }
    /* Reduced motion, now or later: the resting picture, which is the drawing itself. */
    function rest() {
      run = false;
      cancelAnimationFrame(raf);
      clear();
      fig.classList.remove("go", "out", "nt", "paused", ...K);
      armed = false;
    }
    if (mq.matches) return;
    if (!moved) {
      const wake = () => {
        moved = true;
        sync();
      };
      window.addEventListener("scroll", wake, { once: true, passive: true });
    }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (es) => {
          seen = es[0]?.isIntersecting ?? false;
          sync();
        },
        { threshold: 0.2 },
      ).observe(fig);
    }
    document.addEventListener("visibilitychange", sync);
    mq.addEventListener("change", () => {
      if (mq.matches) rest();
      else sync();
    });
  }

  function mountAll() {
    for (const f of document.querySelectorAll<HTMLElement>(".sst")) {
      try {
        mount(f);
      } catch (err) {
        console.warn("step art", err);
      }
    }
  }
  mountAll();
  document.addEventListener("astro:page-load", mountAll);
</script>
