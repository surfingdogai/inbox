---
import "@fontsource-variable/manrope";
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/site.css";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description: string;
  /** Public path of the social image; defaults to the site card. */
  image?: string;
  /** What the social image shows, for readers who cannot see it. */
  imageAlt?: string;
  type?: "website" | "article";
  /** Structured data for the page (schema.org), written as JSON-LD. */
  ld?: Record<string, unknown> | readonly Record<string, unknown>[];
  /** The home page's one-line footer instead of the full map. */
  minimalFooter?: boolean;
}

const CARD_ALTS: Record<string, string> = {
  "/art/og-network-v1.png": "Surfing Dog: open doors to the agentic internet. An open directory your AI can search.",
  "/art/og-inbox-v1.png": "Surfing Dog Inbox: get AI bookings, orders and messages.",
};
const {
  title,
  description,
  image = "/art/og-network-v1.png",
  type = "website",
  ld,
  minimalFooter = false,
} = Astro.props;
const imageAlt = Astro.props.imageAlt ?? CARD_ALTS[image] ?? title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <!-- The striped half sun, the same mark as the one in the bar. Browsers that
         understand SVG take this one; the rest fall back to the rasters. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f5ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0e26" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Surfing Dog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <script is:inline>
      // Apply a saved theme before first paint. Same key as the docs (Starlight).
      // The choice is also kept in the sd_theme cookie, for the pages this domain serves from the
      // network (the checker, results, leaderboards), which carry no script and read it instead.
      // Nav.astro writes both when the theme is switched; this catches a choice made in the docs.
      (() => {
        try {
          const t = localStorage.getItem("starlight-theme");
          const want = t === "light" || t === "dark" ? t : "";
          if (want) document.documentElement.setAttribute("data-theme", want);
          const has = (document.cookie.match(/(?:^|; )sd_theme=([^;]*)/) || [])[1] || "";
          if (has !== want) {
            const h = location.hostname;
            const rest = `; Path=/; SameSite=Lax${h === "surfingdog.ai" || h.endsWith(".surfingdog.ai") ? "; Domain=surfingdog.ai" : ""}${location.protocol === "https:" ? "; Secure" : ""}`;
            document.cookie = want ? `sd_theme=${want}; Max-Age=31536000${rest}` : `sd_theme=; Max-Age=0${rest}`;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <div class="sky sky-fixed" aria-hidden="true"><i class="f1"></i><i class="f2"></i><i class="f3"></i><i class="f4"></i></div>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer minimal={minimalFooter} />
    <!-- Motion: reveals, the brand line and the counters. Every resting state is the
         visible one, so a page without this script is simply a finished page. -->
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
