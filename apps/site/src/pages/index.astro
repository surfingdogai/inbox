---
import FairOrder from "../components/FairOrder.astro";
import ForBusinesses from "../components/ForBusinesses.astro";
import Hero from "../components/Hero.astro";
import OpenNetwork from "../components/OpenNetwork.astro";
import Status from "../components/Status.astro";
import WhatAiSees from "../components/WhatAiSees.astro";
import Layout from "../layouts/Layout.astro";

/**
 * The home page is the network: an open directory that AI assistants search. The inbox has its own
 * page at /inbox. Live counts stay off this page until the directory lists more than our own
 * inbox; they live on /network.
 */
const TAGLINE = "Supporting businesses on the agentic internet.";
const site = Astro.site?.toString() ?? "https://surfingdog.ai/";
const org = `${site}#org`;
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": org,
    name: "Surfing Dog",
    legalName: "Surfing Dog Lda",
    url: site,
    logo: new URL("/icon-512.png", site).toString(),
    email: "hello@surfingdog.ai",
    sameAs: ["https://github.com/surfingdogai"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Surfing Dog",
    url: site,
    description: `${TAGLINE} An open directory AI assistants search to find businesses and reach them directly.`,
    publisher: { "@id": org },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site}#network`,
    name: "Surfing Dog Network",
    url: "https://network.surfingdog.ai",
    serviceType: "Directory of businesses that AI agents can reach",
    description:
      "An open directory AI assistants search over MCP, REST or llms.txt. Today it lists businesses that run a verified inbox. The order comes from signed receipts of kept promises and cannot be bought.",
    provider: { "@id": org },
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR", description: "Listing is free" },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Surfing Dog Inbox",
    description:
      "An open-source inbox that gives a business a door AI agents can use: bookings, orders, quote requests and messages arrive over MCP or REST, and the business's rules answer them or pass them to a person.",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: new URL("/inbox/", site).toString(),
    downloadUrl: "https://github.com/surfingdogai/inbox",
    license: "https://www.gnu.org/licenses/agpl-3.0.html",
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
    publisher: { "@id": org },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: "Surfing Dog network protocol and SDK",
    codeRepository: "https://github.com/surfingdogai/inbox",
    license: "https://opensource.org/licenses/MIT",
    programmingLanguage: "TypeScript",
    publisher: { "@id": org },
  },
];
---

<Layout
  title="Surfing Dog · Be found by people's AIs"
  description={`${TAGLINE} An open directory AI assistants search to find businesses and reach them directly. Ranked by kept promises, never by payment. Open protocol, open-source inbox.`}
  image="/art/og-network-v1.png"
  ld={ld}
>
  <Hero />
  <WhatAiSees />
  <FairOrder />
  <ForBusinesses />
  <OpenNetwork />
  <Status />
</Layout>
