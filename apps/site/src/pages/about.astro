---
// What Surfing Dog is, in about a minute: the directory, the inbox (the business's own), the
// checker and its score, how an agent connects to Search (#connect: the address GET /mcp points a
// browser to, with the transport, tools, limits and examples that return businesses today), what is
// free, and that nobody can pay for order or score. Kept short on purpose; the FAQ and the docs carry
// the detail. The Organization node reuses the home page's @id, so search engines read one
// organisation, not two.
import Layout from "../layouts/Layout.astro";

const site = Astro.site?.toString() ?? "https://surfingdog.ai/";
const org = `${site}#org`;
const ld = [
  { "@context": "https://schema.org", "@type": "Organization", "@id": org, name: "Surfing Dog", url: site },
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "What is Surfing Dog",
    url: new URL("/about/", site).toString(),
    about: { "@id": org },
    publisher: { "@id": org },
  },
];

const MCP = "https://surfingdog.ai/mcp";

// The tools as tools/list gives them, in three kinds: those that read, the check, and the two a
// business's own AI writes its listing with.
const tools = [
  {
    kind: "Read",
    names: ["search_businesses", "get_business", "list_categories", "list_attributes"],
    note: "Find businesses, read one listing, and the categories and attributes a search can ask for. They change nothing.",
  },
  {
    kind: "Check",
    names: ["check_business"],
    note: "Reads a business's website and says what an agent can do there. The result is public at /b/<domain>.",
  },
  {
    kind: "Write",
    names: ["register_business", "update_business"],
    note: "For a business's own AI: put the business in the directory, or change its listing, with proof the domain is its own.",
  },
];

// Asks tried on the live directory before they were written here, each returning businesses.
const examples = [
  {
    call: 'search_businesses {"query": "coffee roasters", "accepts": ["order"]}',
    note: "coffee roasters an agent can order from",
  },
  { call: 'search_businesses {"query": "florist"}', note: "florists" },
  {
    call: 'search_businesses {"query": "coffee singapore"}',
    note: "a town in the words finds a business whose site names it",
  },
  // A business in the directory whose check is done and public (/b/kokoroaster.com), the same site the
  // agent card's example checks. Surfing Dog's own domain is refused by the check, so it is never the example.
  { call: 'check_business {"url": "kokoroaster.com"}', note: "what an agent can do on a business's website" },
];

const doors = [
  { name: "A2A", at: "/a2a", doc: "/.well-known/agent-card.json", docLabel: "agent card" },
  { name: "REST", at: "/v1/businesses", doc: "https://network.surfingdog.ai/openapi.json", docLabel: "OpenAPI" },
];
---

<Layout
  title="What is Surfing Dog"
  description="A public directory of businesses AI agents can reach through their own doors, and a checker that shows how far an agent can go with any business's website."
  ld={ld}
>
  <section class="wrap wrap-read section is-head" aria-labelledby="about-h">
    <p class="eyebrow">About</p>
    <h1 class="h-page" id="about-h">What is Surfing Dog</h1>
    <p class="lede">
      A public directory of businesses that AI agents can reach through doors the businesses published, and a checker
      that shows how far an agent can go with any business's website.
    </p>
  </section>

  <section class="section section-tight" aria-label="In short">
    <div class="wrap wrap-read prose">
      <h2>The directory</h2>
      <p>
        Each business is listed with its agent doors (an agent inbox, MCP, A2A, an API, UCP or ACP), what each door
        takes, and a source and date on every fact. A person's AI finds a business here, then talks to it at its own
        doors. The directory takes nothing in between.
      </p>
      <h2>The inbox</h2>
      <p>
        One door a business can open is <a href="/inbox/">Surfing Dog Inbox</a>: open-source software it runs itself,
        on its own subdomain, on its Cloudflare account or its own server. Agents and people write to the business
        there, directly; Surfing Dog is not in the middle, and the business can leave whenever it likes, with its data.
        Joining the network is a separate choice: it lists the business and records the receipts its inbox signs, never
        its messages.
      </p>
      <h2>The checker and the agentic score</h2>
      <p>
        Paste a website at <a href="/check">/check</a>, or ask an AI to call <code>check_business</code>. We read what
        the site publishes for agents and answer: can an agent message, book, order, sign up, cancel or negotiate there, and
        through which door? The <a href="/v1/score-rules">agentic score</a> sums it up by published rules, counting
        what applies to that kind of business. It is not a certification.
      </p>
      <h2 id="connect">Connect an agent to Search</h2>
      <p>
        Add Surfing Dog Search to an MCP client as a remote server. There is no sign-in and no key, and everyone gets
        the same answers. Search takes no bookings or orders; each result lists the business's own doors.
      </p>
      <dl class="connect">
        <div>
          <dt>Address</dt>
          <dd><code>{MCP}</code></dd>
        </div>
        <div>
          <dt>Transport</dt>
          <dd>
            Streamable HTTP. Each JSON-RPC message is one POST with one JSON answer: no session and no stream. Opened in
            a browser, the address answers 405 with a link here.
          </dd>
        </div>
        {
          tools.map((t) => (
            <div>
              <dt>{t.kind}</dt>
              <dd>{t.names.map((n, i) => <>{i > 0 ? ", " : ""}<code>{n}</code></>)}. {t.note}</dd>
            </div>
          ))
        }
        <div>
          <dt>Limits</dt>
          <dd>
            From one address (an IPv6 /64 counts as one): 600 requests a minute, in bursts of 200. Calls of
            <code>check_business</code>, <code>register_business</code> and <code>update_business</code> also count
            against 60 a minute, in bursts of 30. A request is at most 16 KB, and a page at most 20 businesses. When
            many searches arrive at once, a search may answer that the directory is busy: try again in a few seconds.
          </dd>
        </div>
        <div>
          <dt>More for reporters</dt>
          <dd>
            Agents that sign their reports of how doors answered read more: 1,800 a minute per key, 6,000 per
            platform (<a href="/report.md">how</a>).
          </dd>
        </div>
        <div>
          <dt>Cards</dt>
          <dd>
            <a href="/.well-known/mcp/server-card.json">server card</a>,
            <a href="/.well-known/ai-catalog.json">AI catalog</a>, <a href="/llms.txt">llms.txt</a>
          </dd>
        </div>
        <div>
          <dt>Other doors</dt>
          <dd>{doors.map((d, i) => <>{i > 0 ? "; " : ""}{d.name} at <code>{d.at}</code> (<a href={d.doc}>{d.docLabel}</a>)</>)}</dd>
        </div>
      </dl>
      <p>
        To try it: every word of a query must match, so a few words find more than a sentence. A country filter
        finds few businesses yet; a town among the words often finds more.
      </p>
      <ul class="connect-try">
        {
          examples.map((e) => (
            <li>
              <code>{e.call}</code> <span class="note">{e.note}</span>
            </li>
          ))
        }
      </ul>
      <h2>Free, and not for sale</h2>
      <p>
        Being listed, found, searched and checked is free, the inbox is free to run yourself, and the protocol is open
        source. Nobody can pay for a place
        in the directory's order, or for a score. Questions? Read the <a href="/faq/">FAQ</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* The connect section: label and value on one row, a hairline between rows; stacked on a phone. */
  .connect {
    display: grid;
    margin: 0;
    font-size: var(--fs-ui);
    line-height: 1.55;
  }
  .connect > div {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: var(--sp-1) var(--sp-4);
    padding: var(--sp-2) 0;
    border-top: 1px solid var(--hairline);
  }
  .connect > div:first-child {
    border-top: 0;
  }
  @media (max-width: 560px) {
    .connect > div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  .connect dt {
    font-weight: 600;
    color: var(--ink-3);
  }
  .connect dd {
    margin: 0;
    min-width: 0;
    color: var(--ink-2);
  }
  .connect code,
  .connect-try code {
    overflow-wrap: anywhere;
  }
  .connect-try {
    font-size: var(--fs-ui);
  }
  .connect-try .note {
    color: var(--ink-3);
  }
</style>
