---
// The directory, members first. A member runs an inbox that verified its own domain and reports
// in: nobody is a member because they filled in a form, and nobody can make a business that is not
// theirs one, because that takes serving a manifest at the domain itself. After the members come the
// businesses our crawler found with a door for agents on their own website: they are not members,
// run no inbox with us, and each says what we found and when (its card's found note).
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Directory · Surfing Dog"
  description="Businesses running Surfing Dog Inbox, which proved they own their domain, and businesses our crawler found with a door for agents on their own website, each with what we found and when."
>
  <section class="wrap wrap-read section is-head" id="directory" aria-labelledby="directory-h">
    <p class="eyebrow">Directory</p>
    <h1 class="h-page" id="directory-h">Who agents can reach</h1>
    <p class="lede">
      Members run their own inbox and proved they own their domain. After them come businesses our crawler found
      with a door for agents on their own website; they are not members, and each says what we found and when.
    </p>
  </section>

  <section class="section" id="listed" aria-labelledby="listed-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Members</p>
          <h2 class="h-section" id="listed-h">Inboxes on the network</h2>
          <p class="lede">
            Each runs its own inbox at its own domain, which it proved is its own. Businesses that are answering come
            first; among them a record of kept promises sets the order, and the rest are shuffled once a day, by
            <a class="link" href="/network/#ranking">published rules</a>.
          </p>
          <p class="fine">Filters narrow the list, never reorder it.</p>
        </div>
      </div>

      <div data-dir aria-live="polite">
        <div class="skeleton sk-line"></div>
      </div>

      <template data-entry-template>
        <div class="listing row-glass">
          <div class="who">
            <b data-name></b>
            <span class="s" data-where></span>
          </div>
          <div class="meta">
            <span class="pill pill-xs" data-online></span>
            <span class="s" data-takes></span>
            <span class="s" data-receipts></span>
          </div>
          <p class="rec" data-record hidden>
            <span class="rec-meter" data-record-meter aria-hidden="true" hidden><i></i></span>
            <span data-record-text></span>
            <a class="link" data-record-link></a>
          </p>
          <div class="links">
            <a class="link" data-site rel="noopener">Their page</a>
            <a class="link" data-manifest rel="noopener">Manifest</a>
          </div>
        </div>
      </template>
      <p class="fine rec-note" data-record-note hidden></p>

      <template data-none-template>
        <div class="state">
          <h3>No member is listed right now</h3>
          <p>
            Businesses appear here once their inbox joins the network.
          </p>
        </div>
      </template>
    </div>
  </section>

  <section class="section" id="found" aria-labelledby="found-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Found by our crawler</p>
          <h2 class="h-section" id="found-h">Doors we found on businesses' own websites</h2>
          <p class="lede">
            These are not members and run no inbox with us. Each shows the doors for agents we read on its website,
            and the day we last checked. <a class="link" href="/search/">Search them all</a>.
          </p>
        </div>
      </div>
      <div data-found aria-live="polite">
        <div class="skeleton sk-line"></div>
      </div>
    </div>
  </section>

  <section class="section" id="join" aria-labelledby="join-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Joining</p>
          <h2 class="h-section" id="join-h">How to get listed</h2>
        </div>
      </div>
      <ul class="checks">
        <li><b>Get an inbox</b> on your own domain: we host it, or run it on your own server or on Cloudflare.</li>
        <li>
          <b>Join the network.</b> A hosted inbox is on it from the day it goes live; one you run yourself asks during
          setup.
        </li>
        <li>
          <b>Your inbox proves the domain is yours</b> by serving its manifest. Nothing to apply for.
        </li>
        <li>
          <b>It reports every hour</b> with its version, runtime and how many bookings, orders, quotes and messages
          came in over the last 24 hours. It also sends the receipts it signs, which name customers only by a code the
          network can't trace back to a person. <a class="link" href="/privacy/">What leaves, exactly</a>.
        </li>
      </ul>
      <p class="hint">
        Stop reporting and your entry shows as quiet. If your manifest stays down for two or three days, you drop off
        the list.
      </p>
      <div class="rowx">
        <a class="btn btn-primary" href="/install/">Get one running</a>
        <a class="btn btn-secondary" href="/network/">What the network is for</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .listing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--sp-2) var(--sp-4);
    align-items: center;
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--radius-md);
  }
  .listing + .listing {
    margin-top: var(--sp-2);
  }
  .listing .who {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .listing .s {
    color: var(--ink-2);
    font-size: var(--fs-fine);
  }
  .listing .meta {
    display: flex;
    gap: var(--sp-2);
    align-items: center;
    justify-self: end;
  }
  .listing .rec {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    gap: var(--sp-1) var(--sp-3);
    align-items: center;
    margin: 0;
    font-size: var(--fs-fine);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .listing .rec[hidden],
  .rec-meter[hidden],
  .rec-note[hidden] {
    display: none;
  }
  /* Kept against broken, never red: kept is the success tone from the left, broken is ink at half. */
  .rec-meter {
    display: inline-flex;
    width: 96px;
    height: 3px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--ink-2) 45%, transparent);
  }
  .rec-meter i {
    height: 100%;
    background: var(--c-success);
  }
  .rec-note {
    margin-top: var(--sp-3);
  }
  .listing .links {
    display: flex;
    grid-column: 1 / -1;
    gap: var(--sp-4);
    font-size: var(--fs-fine);
  }
  @media (max-width: 620px) {
    .listing {
      grid-template-columns: minmax(0, 1fr);
    }
    .listing .meta {
      justify-self: start;
    }
  }
</style>

<script>
  import { type RecordView, recordNote, recordView } from "../lib/record";

  const NETWORK = "https://network.surfingdog.ai";
  const host = document.querySelector<HTMLElement>("[data-dir]");
  const foundHost = document.querySelector<HTMLElement>("[data-found]");
  const tpl = document.querySelector<HTMLTemplateElement>("[data-entry-template]");
  const none = document.querySelector<HTMLTemplateElement>("[data-none-template]");

  const WORDS: Record<string, string> = {
    booking: "bookings",
    order: "orders",
    quote_request: "quotes",
    message: "messages",
    refund: "refunds",
  };
  const DOORS: Record<string, string> = {
    inbox: "an agent inbox",
    mcp: "an MCP server",
    a2a: "an A2A agent",
    openapi: "an OpenAPI description",
    api: "an API",
    ucp: "a UCP profile",
    acp: "an ACP profile",
    nlweb: "NLWeb",
  };
  type Door = { type?: string; level?: string; status?: string };

  /** What we found on a found business's website: its live doors, each with its level. */
  const foundDoors = (doors: Door[]): string =>
    doors
      .filter((d) => d.status === "live" && d.type)
      .map((d) => {
        const t = String(d.type);
        const name = t.startsWith("platform:") ? `${t.slice("platform:".length)}'s door` : (DOORS[t] ?? t);
        return d.level ? `${name}, ${d.level}` : name;
      })
      .join(" · ");

  const page = async (query: string): Promise<Array<Record<string, unknown>>> => {
    const res = await fetch(`${NETWORK}/v1/businesses?${query}`, { headers: { accept: "application/json" } });
    const data = (await res.json()) as { businesses?: Array<Record<string, unknown>> };
    return data.businesses ?? [];
  };

  function entry(b: Record<string, unknown>, records: RecordView[]): DocumentFragment | null {
    if (!tpl) return null;
    const node = tpl.content.cloneNode(true) as DocumentFragment;
    const domain = String(b.domain ?? "");
    const set = (sel: string, text: string) => {
      const el = node.querySelector<HTMLElement>(sel);
      if (el) el.textContent = text;
    };
    set("[data-name]", String(b.name || domain));
    const where = [b.city, b.country].filter(Boolean).join(", ");
    set("[data-where]", where || domain);
    if (b.source === "member") {
      set("[data-online]", b.online === true ? "Answering" : "Quiet");
      const types = Array.isArray(b.item_types) ? (b.item_types as string[]) : [];
      set("[data-takes]", types.length ? `Takes ${types.map((t) => WORDS[t] ?? t).join(", ")}` : "");
      const receipts = (b.receipts ?? {}) as { issued?: number; acknowledged?: number };
      const issued = Number(receipts.issued ?? 0);
      const acked = Number(receipts.acknowledged ?? 0);
      set(
        "[data-receipts]",
        issued > 0 ? `${issued} receipt${issued === 1 ? "" : "s"}${acked > 0 ? `, ${acked} counter-signed` : ""}` : "",
      );
      const rec = recordView(b);
      const recEl = node.querySelector<HTMLElement>("[data-record]");
      if (rec && recEl) {
        set("[data-record-text]", rec.text);
        const link = node.querySelector<HTMLAnchorElement>("[data-record-link]");
        if (link) {
          link.textContent = rec.link;
          link.href = rec.href;
        }
        const meter = node.querySelector<HTMLElement>("[data-record-meter]");
        if (meter && rec.kept !== undefined) {
          const kept = Math.round(rec.kept * 1000) / 10;
          meter.querySelector("i")?.style.setProperty("width", `${kept}%`);
          meter.hidden = false;
        }
        records.push(rec);
        recEl.hidden = false;
      }
    } else {
      // Found on its own website: no pill and no record; what we found, and when, in the card's own
      // words.
      node.querySelector("[data-online]")?.remove();
      const doors = foundDoors(Array.isArray(b.doors) ? (b.doors as Door[]) : []);
      set("[data-takes]", doors ? `Found: ${doors}` : "");
      const found = (b.found ?? {}) as { note?: string };
      const note = found.note ? String(found.note) : "found on its own website · not a member";
      set("[data-receipts]", note.charAt(0).toUpperCase() + note.slice(1));
    }
    const site = node.querySelector<HTMLAnchorElement>("[data-site]");
    if (site) site.href = `https://${domain}`;
    // A manifest is an inbox's: linked only when the card names one.
    const manifest = node.querySelector<HTMLAnchorElement>("[data-manifest]");
    if (manifest) {
      if (typeof b.manifest_url === "string" && b.manifest_url) manifest.href = b.manifest_url;
      else manifest.remove();
    }
    return node;
  }

  async function paint(): Promise<void> {
    if (!host || !tpl || !none) return;
    try {
      const members = await page("source=member&limit=100");
      host.replaceChildren();
      const records: RecordView[] = [];
      if (members.length === 0) host.appendChild(none.content.cloneNode(true));
      for (const b of members) {
        const node = entry(b, records);
        if (node) host.appendChild(node);
      }
      // Said once, under the list: whose word a count is when the customer's side did not confirm it.
      const note = document.querySelector<HTMLElement>("[data-record-note]");
      if (note) {
        note.textContent = recordNote(records);
        note.hidden = note.textContent === "";
      }
    } catch {
      host.replaceChildren();
      const p = document.createElement("p");
      p.className = "hint";
      p.textContent = "The directory is not answering just now.";
      host.appendChild(p);
    }
    if (!foundHost) return;
    try {
      // Found by our crawler alone: a business that registered itself proved its domain, and is not
      // what this section says it is.
      const found = await page("source=found&limit=50");
      foundHost.replaceChildren();
      for (const b of found) {
        const node = entry(b, []);
        if (node) foundHost.appendChild(node);
      }
      if (found.length === 0) {
        const p = document.createElement("p");
        p.className = "hint";
        p.textContent = "Nothing to show just now.";
        foundHost.appendChild(p);
      }
    } catch {
      foundHost.replaceChildren();
    }
  }
  void paint();
</script>
