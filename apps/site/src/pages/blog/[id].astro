---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Art from "../../components/Art.astro";
import { coverAnims } from "../../components/covers";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const Anim = post.data.coverAnim ? coverAnims[post.data.coverAnim] : undefined;
const url = new URL(`/blog/${post.id}/`, Astro.site).toString();
const image = post.data.og ?? post.data.cover ?? "/art/og-network-v1.png";
/** What search engines and assistants read: the post as an article, and where it sits on the site. */
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString().slice(0, 10),
    author: { "@type": "Organization", name: post.data.author, url: Astro.site?.toString() },
    publisher: {
      "@type": "Organization",
      name: "Surfing Dog Lda",
      logo: { "@type": "ImageObject", url: new URL("/icon-512.png", Astro.site).toString() },
    },
    image: new URL(image, Astro.site).toString(),
    mainEntityOfPage: url,
    url,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Blog", item: new URL("/blog/", Astro.site).toString() },
      { "@type": "ListItem", position: 2, name: post.data.title, item: url },
    ],
  },
];
const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={`${post.data.title} · Surfing Dog`}
  description={post.data.description}
  image={image}
  type="article"
  ld={ld}
>
  <article class="wrap post">
    <div class="glass-strong post-card">
    <header class="head">
      <p class="eyebrow"><a href="/blog/">Blog</a></p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        By {post.data.author} · <time datetime={post.data.date.toISOString()}>{date}</time>
      </p>
    </header>
    {
      /* The animated cover takes the place of the still one on the page. The social card is
         post.data.og, because a social card cannot run a script. */
      Anim ? (
        <div class="cover">
          <Anim />
        </div>
      ) : post.data.cover ? (
        <div class="cover">
          <Art src={post.data.cover} alt={post.data.coverAlt ?? ""} frame loading="eager" ratio="16 / 9" />
        </div>
      ) : null
    }
    <div class="prose">
      <Content />
    </div>
    </div>
  </article>
</Layout>

<style>
  .post {
    padding-block: var(--sp-8) var(--section-y);
  }
  .post-card {
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(24px, 4.5vw, 56px) clamp(20px, 5vw, 64px) clamp(32px, 5vw, 64px);
    border-radius: var(--radius-card);
  }
  .head {
    max-width: var(--measure);
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover,
  .eyebrow a:focus-visible {
    text-decoration: underline;
  }
  h1 {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-page-title);
    line-height: var(--lh-title);
  }
  .meta {
    margin: var(--sp-3) 0 0;
    color: var(--ink-2);
    font-size: var(--fs-ui);
    font-variant-numeric: tabular-nums;
  }
  .cover :global(.art) {
    width: auto;
    max-width: 100%;
    max-height: 460px;
    margin-inline: auto;
  }
  .cover {
    max-width: 820px;
    margin: var(--sp-7) 0 var(--sp-8);
  }
  .cover + .prose,
  .head + .prose {
    margin-top: var(--sp-7);
  }
</style>
