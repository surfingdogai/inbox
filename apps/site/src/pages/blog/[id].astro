---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Art from "../../components/Art.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={`${post.data.title} · Surfing Dog`}
  description={post.data.description}
  image={post.data.cover ?? "/art/og.png"}
  type="article"
>
  <article class="wrap post">
    <div class="glass-strong post-card">
    <header class="head">
      <p class="eyebrow"><a href="/blog/">Blog</a></p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        By {post.data.author} · <time datetime={post.data.date.toISOString()}>{date}</time>
      </p>
    </header>
    {
      post.data.cover ? (
        <div class="cover">
          <Art src={post.data.cover} alt={post.data.coverAlt ?? ""} frame loading="eager" ratio="16 / 9" />
        </div>
      ) : null
    }
    <div class="prose">
      <Content />
    </div>
    </div>
  </article>
</Layout>

<style>
  .post {
    padding-block: 36px 72px;
  }
  .post-card {
    max-width: 880px;
    margin-inline: auto;
    padding: clamp(24px, 4.5vw, 56px) clamp(20px, 5vw, 64px) clamp(32px, 5vw, 64px);
    border-radius: var(--radius-panel);
  }
  .head {
    max-width: 66ch;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    text-decoration: underline;
  }
  h1 {
    margin: 10px 0 0;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .meta {
    margin: 14px 0 0;
    color: var(--ink-2);
    font-size: 15px;
    font-variant-numeric: tabular-nums;
  }
  .cover :global(.art) {
    width: auto;
    max-width: 100%;
    max-height: 460px;
    margin-inline: auto;
  }
  .cover {
    max-width: 820px;
    margin: 28px 0 36px;
  }
  .cover + .prose,
  .head + .prose {
    margin-top: 32px;
  }
</style>
