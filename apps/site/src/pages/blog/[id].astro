---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Art from "../../components/Art.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={`${post.data.title} · Surfing Dog`}
  description={post.data.description}
  image={post.data.cover ?? "/art/og.png"}
  type="article"
>
  <article class="wrap post">
    <header class="head">
      <p class="eyebrow"><a href="/blog/">Blog</a></p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        By {post.data.author} · <time datetime={post.data.date.toISOString()}>{date}</time>
      </p>
    </header>
    {
      post.data.cover ? (
        <div class="cover">
          <Art src={post.data.cover} alt={post.data.coverAlt ?? ""} frame loading="eager" ratio="16 / 9" />
        </div>
      ) : null
    }
    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    padding-block: 44px 72px;
  }
  .head {
    max-width: 68ch;
  }
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .eyebrow a:hover {
    text-decoration: underline;
  }
  h1 {
    margin: 8px 0 0;
    font-size: clamp(30px, 4.2vw, 44px);
    line-height: 1.1;
  }
  .meta {
    margin: 12px 0 0;
    color: var(--ink-3);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .cover {
    max-width: 820px;
    margin: 28px 0 32px;
  }
</style>
