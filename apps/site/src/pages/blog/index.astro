---
import { getCollection } from "astro:content";
import Art from "../../components/Art.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const when = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Layout title="Blog · Surfing Dog" description="Notes from building Surfing Dog Inbox: what is live, what is next, and why." type="website">
  <section class="wrap section">
    <p class="eyebrow">Blog</p>
    <h1 class="h-section">Notes from the water</h1>
    <ul class="posts">
      {
        posts.map((post) => (
          <li class="glass post">
            {post.data.cover ? (
              <a class="cover" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
                <Art src={post.data.cover} alt="" ratio="16 / 9" />
              </a>
            ) : null}
            <div class="text">
              <p class="meta">
                <time datetime={post.data.date.toISOString()}>{when(post.data.date)}</time> · {post.data.author}
              </p>
              <h2>
                <a class="title" href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="desc">{post.data.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .posts {
    display: grid;
    gap: 16px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .post {
    display: grid;
    gap: 16px;
    padding: 14px;
    border-radius: var(--radius-sheet);
  }
  @media (min-width: 720px) {
    .post {
      grid-template-columns: 300px minmax(0, 1fr);
      gap: 22px;
      align-items: center;
    }
  }
  .cover {
    display: block;
    border-radius: 12px;
    overflow: hidden;
  }
  .text {
    padding: 4px 6px 8px;
  }
  .meta {
    margin: 0;
    font-size: 13px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  h2 {
    margin: 6px 0 0;
    font-size: 24px;
  }
  .title {
    color: var(--ink);
    text-decoration: none;
  }
  .title:hover {
    text-decoration: underline;
    text-decoration-color: var(--violet);
    text-underline-offset: 3px;
  }
  .desc {
    margin: 8px 0 0;
    color: var(--ink-2);
    line-height: 1.55;
  }
</style>
