---
import { getCollection } from "astro:content";
import Art from "../../components/Art.astro";
import CoverReceipts from "../../components/CoverReceipts.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const when = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<Layout title="Blog · Surfing Dog" description="Notes from building Surfing Dog Inbox, the open-source inbox where AI agents reach a business." type="website">
  <section class="wrap section" aria-labelledby="blog-h">
    <p class="eyebrow">Blog</p>
    <h1 class="h-page" id="blog-h">Notes from the water</h1>
    <p class="lede">What we've shipped, and what we're building next.</p>
    <ul class="posts" data-reveal="stagger">
      {
        posts.map((post) => (
          <li class="glass lift post">
            {/* A post with an animated cover shows THAT cover here, not a still of something
                else: the index was showing pixel art beside the post's own moving artwork. */}
            {post.data.coverAnim === "receipts" ? (
              <a class="cover is-anim" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
                <CoverReceipts />
              </a>
            ) : post.data.cover ? (
              <a class="cover" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
                <Art src={post.data.cover} alt="" ratio="16 / 9" />
              </a>
            ) : null}
            <div class="text">
              <p class="meta">
                <time datetime={post.data.date.toISOString()}>{when(post.data.date)}</time> · {post.data.author}
              </p>
              <h2 class="h-sub">
                <a class="title" href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h2>
              <p class="desc">{post.data.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .posts {
    display: grid;
    gap: var(--gap-grid);
    margin: var(--sp-7) 0 0;
    padding: 0;
    list-style: none;
  }
  .post {
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-3);
    border-radius: var(--radius-card);
  }
  @media (min-width: 720px) {
    .post {
      grid-template-columns: 224px minmax(0, 1fr);
      gap: var(--sp-6);
      align-items: center;
    }
  }
  /* Covers arrive at whatever size and shape the art happens to be, so the card fixes the box
     and fits the art inside it. Without this a square 1024px tile filled the column and became
     the loudest thing on the page. */
  .cover {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: var(--sp-3);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-control);
    background: var(--row-bg);
    overflow: hidden;
  }
  /* The animation is its own composed frame, so the card stops framing it again — but it still
     has to sit in the same 16/10 box as a still cover, or one card in the list is three times
     the height of the other. The figure is scaled to fit rather than allowed its own size. */
  .cover.is-anim {
    padding: 0;
    border: 0;
    background: transparent;
  }
  .cover.is-anim :global(figure) {
    display: block;
    width: 100%;
    max-height: 100%;
    margin: 0;
  }
  .cover.is-anim :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 100%;
  }
  .cover :global(.art) {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .text {
    padding: var(--sp-1) var(--sp-2) var(--sp-2);
  }
  .meta {
    margin: 0;
    font-size: var(--fs-fine);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .post .h-sub {
    margin: var(--sp-1) 0 0;
  }
  .title {
    color: var(--ink);
    text-decoration: none;
  }
  .title:hover,
  .title:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--violet);
    text-underline-offset: 3px;
  }
  .desc {
    margin: var(--sp-2) 0 0;
    max-width: var(--measure-card);
    font-size: var(--fs-card);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }
</style>
