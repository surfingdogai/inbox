---
// apps/site/src/pages/technical.astro
// Everything a developer needs in one place, so the rest of the navigation can stay about the business.
import Layout from "../layouts/Layout.astro";

const REPO = "https://github.com/surfingdogai/inbox";
const DEPLOY = "https://deploy.workers.cloudflare.com/?url=https://github.com/surfingdogai/inbox";
const INSTANCE = "https://inbox.surfingdog.ai";

/** `phase` marks a door that is named in the schema but not built yet. */
const doors: { k: string; v: string; note: string; phase?: string }[] = [
  {
    k: "Discovery",
    v: "GET /.well-known/agent-inbox.json",
    note: "Names the instance, its item types, trust tiers and doors. Email is not listed.",
  },
  {
    k: "REST",
    v: "GET /openapi.json · /v1/*",
    note: "55 operations: 11 public, 44 under /v1/owner. Built from the same schemas as the MCP tools.",
  },
  {
    k: "MCP public",
    v: "POST /mcp",
    note: "11 tools for a customer's agent, no sign-in. acknowledge_receipt counter-signs a receipt.",
  },
  {
    k: "MCP owner",
    v: "POST /mcp/owner",
    note: "34 tools for the owner and their AI. OAuth 2.1 with PKCE, or an owner API key.",
  },
  {
    k: "Email in",
    v: "POST /v1/email/inbound",
    note: "Raw MIME. Off until you set an inbound secret in Settings and send it in X-Inbox-Email-Secret. Emails become messages or replies, not bookings yet.",
  },
  {
    k: "Web form",
    v: "channel: form",
    phase: "Being built",
    note: "For people with no agent. Reserved in the schema, not built yet.",
  },
  {
    k: "Idempotency",
    v: "Idempotency-Key · idempotency_key",
    note: "A repeated request with the same key gets the same answer: 200 with Idempotent-Replayed: true, never a second booking.",
  },
  {
    k: "Access tokens",
    v: "access_token · x-access-token",
    note: "Given to a caller with no key, so they can read, cancel or follow up on their item later.",
  },
  {
    k: "Errors",
    v: "application/problem+json",
    note: "A code, a message, and fields[{path, problem, message}] for each bad field.",
  },
];

const urls = [
  {
    href: `${INSTANCE}/.well-known/agent-inbox.json`,
    link: true,
    note: "The manifest. Start here.",
  },
  {
    href: `${INSTANCE}/openapi.json`,
    link: true,
    note: "OpenAPI 3.1 for every REST operation.",
  },
  {
    href: `${INSTANCE}/mcp`,
    link: false,
    note: "The public MCP server. POST only, so use an MCP client.",
  },
];

const ways = [
  {
    title: "Let your AI do it",
    text: "Give one line to Claude, Codex or Grok. It sets up the server, your subdomain and email in.",
    href: "/install/",
    label: "Get the line",
    external: false,
  },
  {
    title: "Cloudflare Workers",
    text: "One click on your own account. D1, R2 and a queue are created for you.",
    href: DEPLOY,
    label: "Deploy to Cloudflare",
    external: true,
  },
  {
    title: "Your own server",
    text: "Node 22.16, 24 or 26. Clone, install, build, run.",
    href: "/docs/quickstart/#your-own-server",
    label: "Read the quickstart",
    external: false,
  },
  {
    title: "Hosted by us",
    text: "We will run it for you, one database per business. Not open yet.",
    href: "/#run",
    label: "Join the waitlist",
    external: false,
  },
];
---

<Layout
  title="Technical · Surfing Dog"
  description="Surfing Dog Inbox for developers: the REST and MCP endpoints, how to run it on Cloudflare or your own machine, and how to contribute."
>
  <section class="wrap wrap-read section is-head" id="technical" aria-labelledby="technical-h">
    <p class="eyebrow">Technical</p>
    <h1 class="h-page" id="technical-h">For developers and agent builders</h1>
    <p class="lede">The endpoints an agent calls, and how to run your own inbox.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/docs/">Read the docs</a>
      <a class="btn btn-secondary" href={REPO} rel="noopener">GitHub</a>
      <a class="btn btn-secondary" href={DEPLOY} rel="noopener">Deploy to Cloudflare</a>
      <a class="btn btn-secondary" href="/install/">Let your AI install it</a>
    </div>
    <p class="fine">For the plain version, read <a class="link" href="/how-it-works/">How it works</a>.</p>
  </section>

  <section class="section" id="what" aria-labelledby="what-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">What it is</p>
          <h2 class="h-section" id="what-h">One repository, two runtimes</h2>
          <p class="lede">The same TypeScript code runs on Cloudflare Workers and on Node. CI tests both.</p>
        </div>
      </div>

      <ul class="grid-cards cards" data-reveal="stagger">
        <li class="glass card">
          <h3 class="h-card">Open source</h3>
          <p class="card-text">
            Six packages, the inbox app, an email gateway and this website. Decision records in docs/adr explain the
            design.
          </p>
        </li>
        <li class="glass card">
          <h3 class="h-card">Run it where you like</h3>
          <p class="card-text">
            Workers with D1, queues and cron, or Node with one SQLite file. Each instance serves one business.
          </p>
        </li>
        <li class="glass card">
          <h3 class="h-card">Licences</h3>
          <p class="card-text">
            AGPL-3.0-only for the server, the apps and the UI. MIT for the spec and the SDK, which verifies webhooks.
          </p>
        </li>
      </ul>

    </div>
  </section>

  <section class="section" id="doors" aria-labelledby="doors-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">The doors</p>
          <h2 class="h-section" id="doors-h">Three doors today, a web form next</h2>
          <p class="lede">All of this works today unless marked.</p>
        </div>
        <a class="btn btn-secondary" href="/docs/api/">Read the API docs</a>
      </div>

      <dl class="glass spec mono">
        {
          doors.map((d) => (
            <div class="row-spec">
              <dt>{d.k}</dt>
              <dd>
                <span class="dd-head">
                  <code>{d.v}</code>
                  {d.phase ? <span class="pill">{d.phase}</span> : null}
                </span>
                <span class="note">{d.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" id="try" aria-labelledby="try-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Try it</p>
          <h2 class="h-section" id="try-h">Try the live instance</h2>
          <p class="lede">inbox.surfingdog.ai is our own instance. Its public doors need no key.</p>
        </div>
      </div>

      <ul class="glass panel urls">
        {
          urls.map((u) => (
            <li class="url">
              <span class="url-head">
                {u.link ? (
                  <a class="mono u" href={u.href} rel="noopener">
                    {u.href}
                  </a>
                ) : (
                  <span class="mono u">{u.href}</span>
                )}
                <button class="btn btn-secondary btn-sm" type="button" data-copy={u.href} hidden>
                  Copy
                </button>
              </span>
              <span class="url-note">{u.note}</span>
            </li>
          ))
        }
      </ul>

      <div class="glass panel call">
        <h3 class="h-card">One call to start with</h3>
        <pre class="cmd mono"><code>curl {INSTANCE}/v1/business</code><button
            class="btn btn-secondary btn-sm"
            type="button"
            data-copy={`curl ${INSTANCE}/v1/business`}
            hidden>Copy</button></pre>
        <p class="card-text">
          Returns the business name, domain, timezone, currency, languages and item types. No key needed, cached for
          five minutes.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="run-it" aria-labelledby="run-it-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Run it</p>
          <h2 class="h-section" id="run-it-h">Four ways to set it up</h2>
          <p class="lede">Same software each way.</p>
        </div>
      </div>

      <ul class="grid-cards cards" data-reveal="stagger">
        {
          ways.map((w) => (
            <li class="glass card lift way">
              <h3 class="h-card">{w.title}</h3>
              <p class="card-text">{w.text}</p>
              <span class="foot">
                <a class="btn btn-secondary" href={w.href} rel={w.external ? "noopener" : undefined}>
                  {w.label}
                </a>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="connect" aria-labelledby="connect-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Connect your AI</p>
          <h2 class="h-section" id="connect-h">Let your own AI run the inbox</h2>
          <p class="lede">Claude, ChatGPT or any Streamable HTTP client can work the inbox for you.</p>
        </div>
        <a class="btn btn-secondary" href="/docs/connect-your-ai/">How to connect</a>
      </div>

      <div class="glass panel connect">
        <p class="endpoint mono"><code>POST /mcp/owner</code></p>
        <p class="card-text">
          Each instance is its own OAuth server. Clients use OAuth 2.1 with PKCE and a Client ID Metadata Document, so
          nothing is registered by hand. Dynamic registration and owner API keys work too.
        </p>
        <p class="card-text">
          34 tools cover items, replies, the catalogue, opening hours, rules, webhooks and settings. Eight scopes, shown
          on the consent screen in plain words, limit what a client can do.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="contribute" aria-labelledby="contribute-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Contribute</p>
          <h2 class="h-section" id="contribute-h">Help build it</h2>
          <p class="lede">Read the decision records before you change the architecture.</p>
        </div>
      </div>

      <ul class="grid-cards cards" data-reveal="stagger">
        <li class="glass card lift">
          <h3 class="h-card">The code</h3>
          <p class="card-text">Every change must pass the tests on Node and on workerd.</p>
          <span class="foot">
            <a class="btn btn-secondary" href={REPO} rel="noopener">Open the repository</a>
          </span>
        </li>
        <li class="glass card lift">
          <h3 class="h-card">How to work on it</h3>
          <p class="card-text">The toolchain and the rules of the repository.</p>
          <span class="foot">
            <a class="btn btn-secondary" href="/docs/contributing/">Read contributing</a>
          </span>
        </li>
        <li class="glass card lift">
          <h3 class="h-card">Ask for something</h3>
          <p class="card-text">Say what you need, and vote on what others have asked for.</p>
          <span class="foot">
            <a class="btn btn-secondary" href="/requests/">Feature requests</a>
          </span>
        </li>
      </ul>

      <p class="fine">
        If you run a modified copy as a service, the AGPL requires you to make its source available. The spec and the SDK
        are MIT and carry no such duty.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* The page header: .h-page and .lede carry the type; the section stops at --header-pb. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin-top: var(--sp-6);
  }

  .cards {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card {
    display: flex;
    flex-direction: column;
  }
  .card .card-text {
    margin-top: var(--sp-2);
  }
  .foot {
    display: block;
    margin-top: auto;
    padding-top: var(--sp-5);
  }

  .tile p {
    margin: 0;
  }
  .label {
    font-size: var(--fs-ui);
    font-weight: 600;
    line-height: var(--lh-ui);
    color: var(--ink-2);
  }
  .value {
    margin-top: var(--sp-1);
    font-family: var(--font-display);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--ink);
  }
  .sub {
    margin-top: var(--sp-1);
    font-size: var(--fs-fine);
    line-height: 1.45;
    color: var(--ink-3);
  }

  /* The specification table, the same shape as the one on the network page. */
  .spec {
    display: grid;
    gap: 0;
    margin: 0;
    padding: var(--sp-1) var(--sp-5);
    border-radius: var(--radius-card);
  }
  .row-spec {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: var(--sp-1) var(--sp-4);
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--hairline);
  }
  .row-spec:first-child {
    border-top: 0;
  }
  @media (max-width: 560px) {
    .row-spec {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
  dt {
    font-weight: 600;
    color: var(--ink-3);
  }
  dd {
    display: grid;
    gap: var(--sp-1);
    margin: 0;
    min-width: 0;
  }
  .dd-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    min-width: 0;
  }
  .spec code {
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  /* Small text on a narrow measure, never the widest line on the page. */
  .note {
    max-width: var(--measure-tight);
    font-family: var(--font-sans);
    font-size: var(--fs-ui);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .urls {
    margin: 0;
    padding-block: var(--sp-1);
    list-style: none;
  }
  .url {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .url:first-child {
    border-top: 0;
  }
  .url-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    min-width: 0;
  }
  .u {
    min-width: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .url-note {
    max-width: var(--measure-tight);
    font-size: var(--fs-ui);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .call {
    margin-top: var(--gap-grid);
  }
  .cmd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    margin: var(--sp-3) 0;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-control);
    background: var(--row-bg);
    border: 1px solid var(--hairline);
    color: var(--ink);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .cmd code::before {
    content: "$ ";
    color: var(--ink-3);
  }

  .endpoint {
    margin: 0 0 var(--sp-3);
  }
  .connect .card-text + .card-text {
    margin-top: var(--sp-3);
  }
</style>

<script>
  // Progressive enhancement: the URLs are already readable and selectable, so the copy button only
  // appears where the clipboard is actually available.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-copy]"));
  if (navigator.clipboard) {
    for (const button of buttons) {
      button.hidden = false;
      button.addEventListener("click", async () => {
        const value = button.dataset.copy;
        if (!value) return;
        const label = button.textContent ?? "Copy";
        try {
          await navigator.clipboard.writeText(value);
          button.textContent = "Copied";
        } catch {
          button.textContent = "Press to select";
        }
        window.setTimeout(() => {
          button.textContent = label;
        }, 1600);
      });
    }
  }
</script>
