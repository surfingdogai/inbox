---
// Support: where to write, about what, and the answers people need first. The page the MCP
// directories link to for help with Surfing Dog's server (ADR-025). Few words; each address is for
// one thing.
import Layout from "../layouts/Layout.astro";
import { CARRY_PROMISE, HOSTED_KEEPS, MCP_URL, SUPPORT } from "../lib/gateway";

const ld = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Surfing Dog support",
  url: new URL("/support/", Astro.site).toString(),
  mainEntity: {
    "@type": "Organization",
    name: "Surfing Dog",
    url: "https://surfingdog.ai",
    contactPoint: [
      { "@type": "ContactPoint", contactType: "customer support", email: SUPPORT.email },
      { "@type": "ContactPoint", contactType: "privacy", email: SUPPORT.privacy },
      { "@type": "ContactPoint", contactType: "abuse", email: SUPPORT.abuse },
    ],
  },
};
const topics: { q: string; a: string }[] = [
  {
    q: "Adding Surfing Dog to your assistant",
    a: `The address is ${MCP_URL}, with no sign-in. Each assistant's steps are on the <a class="link" href="/assistants/">assistants page</a>, and how the server works in <a class="link" href="/docs/mcp/">the docs</a>.`,
  },
  {
    q: "A request you sent through your assistant",
    a: "It went straight to the business's own inbox, and the business can answer you by email. We keep only a record that it was delivered, so we cannot see it or change it. To follow it up, reply to the business's email, or ask your assistant: it has the link to the request.",
  },
  {
    q: "Your business",
    a: `To stop people's assistants reaching you through Surfing Dog, switch off Requests from AI assistants in your inbox, under Settings → Networks; your inbox still takes requests sent to it directly. To correct or remove your listing, ask your own AI to update it on Surfing Dog, or <a class="link" href="mailto:${SUPPORT.email}">write to us</a>.`,
  },
  {
    q: "Something that should not be listed, or a request that was misused",
    a: `Write to <a class="link" href="mailto:${SUPPORT.abuse}">${SUPPORT.abuse}</a>, with the business's domain and what happened.`,
  },
  {
    q: "Your data",
    a: `What we keep, and for how long, is on the <a class="link" href="/privacy/">privacy page</a>. To see or delete what we hold about you, write to <a class="link" href="mailto:${SUPPORT.privacy}">${SUPPORT.privacy}</a>.`,
  },
];
---

<Layout
  title="Support · Surfing Dog"
  description="Help with Surfing Dog: adding it to your AI assistant, a request you sent to a business, your listing, and your data."
  ld={ld}
>
  <section class="wrap wrap-read section is-head" aria-labelledby="support-h">
    <p class="eyebrow">Support</p>
    <h1 class="h-page" id="support-h">How can we help?</h1>
    <p class="lede">
      Write to <a class="link" href={`mailto:${SUPPORT.email}`}>{SUPPORT.email}</a>. We answer by email.
    </p>
  </section>

  <section class="wrap wrap-read section section-tight" aria-label="Topics">
    <dl class="topics" data-reveal="stagger">
      {
        topics.map((t) => (
          <div class="topic">
            <dt>{t.q}</dt>
            <dd set:html={t.a} />
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap wrap-read section" aria-labelledby="promise-h">
    <h2 class="h-section" id="promise-h">What we promise</h2>
    <p>{CARRY_PROMISE}</p>
    <p class="fine">{HOSTED_KEEPS} Surfing Dog Lda.</p>
  </section>
</Layout>

<style>
  .topics {
    margin: 0;
    border-top: 1px solid var(--hairline);
  }
  .topic {
    padding: 14px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .topic dt {
    font-weight: 500;
  }
  .topic dd {
    margin: 4px 0 0;
    color: var(--ink-2);
    font-size: var(--fs-ui);
    line-height: 1.6;
  }
  .wrap-read.section p + p {
    margin-top: var(--sp-3);
  }
</style>
