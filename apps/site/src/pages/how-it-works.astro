---
// apps/site/src/pages/how-it-works.astro
// The page for a business owner who is not technical: what arrives, what the rules do with it,
// who answers, why it is safer, why it is worth doing now, and what to do next.
import Shot from "../components/Shot.astro";
import Layout from "../layouts/Layout.astro";

const contents = [
  { href: "#arrives", label: "What arrives" },
  { href: "#rules", label: "Your rules" },
  { href: "#your-ai", label: "Your AI" },
  { href: "#safer", label: "Safety" },
  { href: "#prepare", label: "Why now" },
  { href: "#use", label: "Get started" },
];

/** The four public item types, with the states their machines actually hold. */
const types = [
  {
    label: "Message",
    tint: "message",
    states: "open, answered, closed, spam",
  },
  {
    label: "Quote request",
    tint: "quote",
    states: "received, needs info, quoted, accepted, declined, expired",
  },
  {
    label: "Booking",
    tint: "booking",
    states:
      "requested, needs info, proposed, confirmed, completed, no show, cancelled by the customer, cancelled by the business, declined, expired",
  },
  {
    label: "Order",
    tint: "order",
    states:
      "received, needs info, accepted, awaiting payment, paid, fulfilling, fulfilled, completed, declined, cancelled",
  },
];

/** Two of the six shipped preset rules, exactly as the app reads them back in English. */
const rules = [
  {
    preset: "Appointments",
    sentence:
      "When a new item arrives and it is a booking and it is not a test and (the total is under 50.00 or there is no total) and the slot is free and it is inside opening hours: confirm it. Stop there.",
  },
  {
    preset: "Shop",
    sentence:
      "When a new item arrives and it is an order and the total is over 200.00: flag it for a person and set priority 2. Stop there.",
  },
];

const reasons = [
  {
    title: "You already use it",
    text: "It may already know your business and the way you talk to customers. A new one would start from scratch.",
  },
  {
    title: "Your customers stay yours",
    text: "Their details live in your own database, and the inbox only sends them where you tell it to.",
  },
];

const safety = [
  {
    title: "Requests have a fixed shape",
    text: "An agent can only send a booking, an order, a quote request or a message. If a detail is missing, the reply says which one.",
  },
  {
    title: "No double bookings",
    text: "If two agents want your last Saturday slot at once, one gets it. If a connection drops and an agent retries with the same key, it gets the first answer back.",
  },
  {
    title: "The history is never rewritten",
    text: "Every change is logged, with who made it and any reason given. Nothing in the log is edited later.",
  },
  {
    title: "Rules can check who is asking",
    text: "A rule can confirm callers with a verified account and pass anonymous ones to you.",
  },
  {
    title: "Your data stays with you",
    text: "It lives in one database on your Cloudflare account or your own server. If you join a network, it gets hourly counts and receipts, never names or messages.",
  },
  {
    title: "Receipts are signed by you",
    text: "When a booking is confirmed or an order is paid, your inbox signs a receipt. The customer's agent can counter-sign it.",
  },
];

/** The order an owner actually does it in. Where to host it is one decision inside the first. */
const steps = [
  {
    title: "Pick where it runs",
    text: "Deploy to your own Cloudflare account in one click, or run it on your own server. We will also host it for you once that opens.",
    href: "/#run",
    cta: "See the three ways",
  },
  {
    title: "Write down the business",
    text: "Add your hours, services, prices and limits. For a bike shop or a bakery, that takes an afternoon.",
    href: "/docs/quickstart/",
    cta: "Read the quickstart",
  },
  {
    title: "Connect your AI",
    text: "Point Claude or ChatGPT at your inbox and let it handle a day of practice requests in test mode first.",
    href: "/docs/connect-your-ai/",
    cta: "How to connect",
  },
];
---

<Layout
  title="How it works · Surfing Dog"
  description="What happens, step by step, when a customer or their AI agent asks your business for something."
>
  <section class="wrap wrap-read section is-head" aria-labelledby="page-h">
    <p class="eyebrow">How it works</p>
    <h1 class="h-page" id="page-h">What happens to a request</h1>
    <p class="lede">
      Customers ask your business for things, and more and more often their AI agents do the
      asking. Here is what happens to each request.
    </p>
    <nav class="contents" aria-label="On this page">
      {contents.map((c) => <a class="btn btn-secondary btn-sm" href={c.href}>{c.label}</a>)}
    </nav>
  </section>

  <section class="section" id="arrives" aria-labelledby="arrives-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Step one</p>
          <h2 class="h-section" id="arrives-h">What arrives</h2>
          <p class="lede">
            Every request becomes an item with a type and a state, before anyone has read it.
          </p>
        </div>
      </div>

      <div class="says">
        <p>
          Say someone wants their bike serviced on Saturday. Their agent can book it with you
          directly. Claude and ChatGPT use MCP, and other software uses the REST
          API. Email works too, for messages and replies. A web form is on the way.
          <span class="pill">Being built</span>
        </p>
        <p>
          Each request lands as one of four types, with its own set of states, so the inbox always
          knows where it stands. Refunds are a fifth type, handled inside the app.
        </p>
      </div>

      <div class="cols">
        <Shot
          src="/shots/item-day.png"
          alt="A quote request open in the inbox, with the customer, the quote lines, the next step as a button and the conversation below"
          title="One item"
          caption="The request, its state and its history."
        />
        <div class="glass panel points">
          {
            types.map((t) => (
              <article class="point">
                <span class:list={["pill", `tint-${t.tint}`]}>
                  <i class:list={["dot", `dot-${t.tint}`]} />
                  {t.label}
                </span>
                <p class="card-text states">{t.states}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="rules" aria-labelledby="rules-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Step two</p>
          <h2 class="h-section" id="rules-h">Your rules run first</h2>
          <p class="lede">
            Write down how your business works once. Simple rules then handle the routine without
            you.
          </p>
        </div>
      </div>

      <div class="says">
        <p>
          Start with your hours, services and prices, and the order size above which you want to
          decide yourself. Then switch on a few rules. Six come ready-made for appointments, trades
          and shops.
        </p>
        <p>
          Rules don't use AI, so the same request always gets the same answer. The reason goes in
          the item's history. You can try a rule on a request you already have before you switch
          it on.
        </p>
      </div>

      <div class="cols">
        <Shot
          src="/shots/rules-detail.png"
          alt="The rules screen, each rule written as one plain sentence with a switch beside it"
          title="Rules in plain English"
          caption="Each rule is one sentence you can switch off or edit."
        />
        <div class="glass panel points">
          {
            rules.map((r) => (
              <article class="point">
                <span class="pill">{r.preset}</span>
                <p class="card-text quote">{r.sentence}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="your-ai" aria-labelledby="your-ai-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Step three</p>
          <h2 class="h-section" id="your-ai-h">Your own AI answers</h2>
          <p class="lede">
            Connect the AI you already use. It works like a member of staff, with the same
            limits.
          </p>
        </div>
      </div>

      <div class="cols">
        <Shot
          src="/shots/settings-detail.png"
          alt="The settings screen with the business name, domain, time zone, currency and languages"
          title="The settings your AI works inside"
          caption="Your AI follows the same settings you do."
        />
        <div class="glass panel points">
          <article class="point">
            <h3 class="h-card">It signs in as staff</h3>
            <p class="card-text">
              Connect Claude, ChatGPT or any AI that speaks MCP. It signs in with your account
              and can answer customers or suggest another time.
            </p>
          </article>
          <article class="point">
            <h3 class="h-card">It answers inside your rules</h3>
            <p class="card-text">
              It can only take the steps a person could, and everything it does is logged.
            </p>
          </article>
          <article class="point">
            <h3 class="h-card">You watch it first</h3>
            <p class="card-text">
              In test mode, requests from agents are practice ones. Let it handle a day of them
              before it meets a real customer.
            </p>
          </article>
        </div>
      </div>

      <h3 class="h-sub sub-h">Why use your own AI</h3>
      <ul class="grid-cards cards" data-reveal="stagger">
        {
          reasons.map((r) => (
            <li class="glass card">
              <h4 class="h-card">{r.title}</h4>
              <p class="card-text">{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="safer" aria-labelledby="safer-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Safety</p>
          <h2 class="h-section" id="safer-h">Safer than a shared mailbox</h2>
          <p class="lede">
            These protections are built into the inbox, so they hold even when an agent misbehaves.
          </p>
        </div>
      </div>
      <div class="glass panel points wide">
        {
          safety.map((s) => (
            <article class="point">
              <h3 class="h-card">{s.title}</h3>
              <p class="card-text">{s.text}</p>
            </article>
          ))
        }
      </div>
      <p class="fine">
        All of this works today. Checking an agent's own signature is still to come.
      </p>
    </div>
  </section>

  <section class="section" id="prepare" aria-labelledby="prepare-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Why now</p>
          <h2 class="h-section" id="prepare-h">Why prepare now</h2>
          <p class="lede">
            People already ask their AI to book and buy things. Those requests will reach
            you, ready or not.
          </p>
        </div>
      </div>

      <div class="says">
        <p>
          Say someone asks their AI for a dentist with a free slot on Thursday.
        </p>
      </div>

      <div class="grid-cards cards two" data-reveal="stagger">
        <div class="glass card">
          <h3 class="h-card">Unprepared</h3>
          <p class="card-text">
            The request sits in a mailbox behind forty others. Or the agent finds no way to
            ask, and books the dentist down the road.
          </p>
        </div>
        <div class="glass card">
          <h3 class="h-card">Prepared</h3>
          <p class="card-text">
            Your inbox shows the agent your free times and how to book. Your rules confirm the
            slot, and you only see what needs you.
          </p>
        </div>
      </div>

      <div class="says">
        <p>
          Nothing locks you in. The software is open source and the data is yours to take with you.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="use" aria-labelledby="use-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Get started</p>
          <h2 class="h-section" id="use-h">Three steps, in this order</h2>
          <p class="lede">Most of it is writing down what you already know.</p>
        </div>
      </div>

      <ol class="grid-cards cards three" data-reveal="stagger">
        {
          steps.map((w) => (
            <li class="glass card lift way">
              <h3 class="h-card">{w.title}</h3>
              <p class="card-text">{w.text}</p>
              <p class="foot">
                <a class="btn btn-secondary btn-sm" href={w.href}>
                  {w.cta}
                </a>
              </p>
            </li>
          ))
        }
      </ol>

      <div class="glass panel cta">
        <p class="position">
          <span class="u-line" aria-hidden="true"></span>
          <span>You can start small and add more as you go.</span>
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/#run">Get your inbox</a>
          <a class="btn btn-secondary" href="/network/">See the network</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Page header: the h1 and the lede come from .h-page and .lede; the head section
     stops at --header-pb so the next section's top padding does the work. */
  .contents {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
  }

  /* Reading paragraphs: one measure, one size, spaced by gap like everything else. */
  .says {
    display: grid;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .says p {
    max-width: var(--measure);
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }
  .says .pill {
    margin-left: var(--sp-1);
  }

  .cols {
    display: grid;
    gap: var(--gap-grid);
    align-items: start;
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  .points {
    padding-block: var(--sp-1);
  }
  .point {
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .point:first-child {
    border-top: 0;
  }
  .point .h-card {
    margin-bottom: var(--sp-1);
  }
  .point .states,
  .point .quote {
    margin-top: var(--sp-2);
  }
  .point .quote {
    color: var(--ink);
  }
  /* The safety list runs the page width, so it reads in two columns when there is room. */
  @media (min-width: 900px) {
    .wide {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-7);
      padding: var(--sp-1) var(--sp-6);
    }
    .wide .point:nth-child(2) {
      border-top: 0;
    }
  }

  .sub-h {
    margin: var(--sp-7) 0 0;
  }
  .cards {
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cards.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card .card-text {
    margin-top: var(--sp-2);
  }
  .cards.two,
  .cards.three {
    margin-top: var(--sp-6);
  }
  .way {
    display: flex;
    flex-direction: column;
  }
  .way .foot {
    margin: auto 0 0;
    padding-top: var(--sp-5);
  }

  .cta {
    margin-top: var(--sp-6);
  }
  .position {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: center;
    max-width: 54ch;
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: var(--lh-ui);
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin-top: var(--sp-5);
  }
</style>
