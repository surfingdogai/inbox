---
// apps/site/src/pages/network.astro
// The network, explained for a busy owner or an agent developer in about a minute: what it is,
// how joining works, how reputation will work (decided, not built yet), what leaves an inbox, and
// that anyone can run one. LiveMetrics carries the live numbers, so the fetch, the fallback and the
// refresh live in one place. Its note says what an instance reports "is set out below", so it has
// to sit above the "What leaves your inbox" section. The top is a two-column hero like the home
// page's: the words on the left, NetworkFlow on the right in the same .art-box, stacked on a phone
// with the drawing after the words.
import LiveMetrics from "../components/LiveMetrics.astro";
import NetworkFlow from "../components/NetworkFlow.astro";
import Layout from "../layouts/Layout.astro";

const contents = [
  { href: "#how", label: "How it works" },
  { href: "#reputation", label: "Reputation" },
  { href: "#network", label: "Live numbers" },
  { href: "#shared", label: "What leaves your inbox" },
  { href: "#open", label: "Launch your own" },
  { href: "#join", label: "Join" },
];

const steps = [
  {
    title: "Switch it on",
    text: "Flip the switch in your inbox's Settings. The network checks the address is really yours by reading your inbox's public profile there. Then you're listed.",
  },
  {
    title: "Get found by agents",
    text: "Agents search the directory by what you do, where you are, and what you take: bookings, orders, quotes or messages. Your listing shows the languages you answer in and how to reach you.",
  },
  {
    title: "Build a record",
    text: "When a booking is confirmed or an order is paid, your inbox makes a receipt: a signed note of that promise. Each one goes to the network and is counted on your listing. Reputation will be built on them.",
  },
];

const principles = [
  {
    title: "For businesses",
    text: "A promise will count when it's kept (the booking happened, the order arrived), and a broken one will count too. Businesses will be ranked by how reliably they keep them. A small shop that always delivers can rank above a big one that sometimes doesn't.",
  },
  {
    title: "For customers",
    text: "Each person will have one reputation, and it goes with them whichever agent they use. No sign-up: the first time they book, the inbox will get their key (a secret that proves it's them) from the network and pass it to their agent. Each business will reward good customers its own way, like instant confirmation or no deposit.",
  },
  {
    title: "Both ways",
    text: "A good customer's word will count more when judging a business. A good business's word will count more when judging a customer. Recent months will weigh most, and nothing will ever be forgotten.",
  },
];

const visibility = [
  { k: "A business's reputation", v: "Public, in the directory." },
  { k: "A customer's reputation", v: "Seen by a business only when the customer's agent shows it." },
];

const shared = [
  {
    k: "Every hour",
    v: "How many bookings, orders, quotes and messages arrived in the last day, plus your software version and what it runs on. Counts only.",
  },
  {
    k: "Every receipt",
    v: "Which promise it was (a booking confirmed or an order paid), when, and your reference for it. The customer is a code the network can't turn back into a person. When known: the amount, how an order was paid, and the customer's agent's signature.",
  },
  {
    k: "Never",
    v: "Messages, names, email addresses, phone numbers, postal addresses, what was ordered, payment references.",
  },
];
---

<Layout
  title="The network · Surfing Dog"
  description="A directory of inboxes that AI agents can search. Join with one switch. Nobody can buy a place, and reputation will come from promises kept."
>
  <section class="wrap section is-head top" aria-labelledby="page-h">
    <div class="copy">
      <p class="eyebrow">The network</p>
      <h1 class="h-page" id="page-h">Where AI agents find your business</h1>
      <p class="lede">
        The network is a directory of inboxes. When someone asks an assistant like ChatGPT, Claude or Gemini to book or
        order something, the assistant can search here for a business that does it. You join with one switch, and it's
        off until you turn it on.
      </p>
      <nav class="contents" aria-label="On this page">
        {contents.map((c) => <a class="btn btn-secondary btn-sm" href={c.href}>{c.label}</a>)}
      </nav>
    </div>
    <div class="art-box">
      <NetworkFlow />
    </div>
  </section>

  <section class="section" id="how" aria-labelledby="how-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 class="h-section" id="how-h">Three steps, one switch</h2>
          <p class="lede">Join, and agents can find you. Every booking confirmed and order paid goes on your record.</p>
        </div>
      </div>

      <ol class="grid-cards cards three" data-reveal="stagger">
        {
          steps.map((s, i) => (
            <li class="glass card">
              <p class="eyebrow">Step {i + 1}</p>
              <h3 class="h-card">{s.title}</h3>
              <p class="card-text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="reputation" aria-labelledby="reputation-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Reputation</p>
          <h2 class="h-section" id="reputation-h">Earned by keeping promises</h2>
          <p class="lede">We're building it now. This is how it will work.</p>
        </div>
        <span class="pill">Being built</span>
      </div>

      <ul class="grid-cards cards three" data-reveal="stagger">
        {
          principles.map((p) => (
            <li class="glass card">
              <h3 class="h-card">{p.title}</h3>
              <p class="card-text">{p.text}</p>
            </li>
          ))
        }
      </ul>

      <dl class="glass spec" aria-label="Who will see reputation">
        {
          visibility.map((n) => (
            <div class="row-spec">
              <dt>{n.k}</dt>
              <dd>{n.v}</dd>
            </div>
          ))
        }
      </dl>

      <div class="glass panel order" id="ranking">
        <h3 class="h-card">Nobody can buy a place</h3>
        <p class="card-text">
          Not now, and not later. Until 9 October 2026 the order is neutral: verified businesses newest first, or
          nearest first when an agent searches near a place.
        </p>
        <p class="card-text">
          <b>Then new rules start.</b> Businesses whose inbox is online come first. Among them, those with a good
          record of kept promises are ranked by it, and the rest are shuffled once a day. Records will count once
          inboxes report kept and broken promises, and we're still building that.
          <a class="link" href="https://github.com/surfingdogai/inbox/blob/main/docs/adr/017-reputation-and-ranking.md" rel="noopener">Read the full rules</a>.
        </p>
        <p class="card-text">
          Every rule will be published on this page and at network.surfingdog.ai/v1/ranking, with a version number,
          before it counts.
        </p>
        <p class="more">
          <a class="link" href="https://network.surfingdog.ai/v1/ranking" rel="noopener">Today's rules, as agents read them</a>
        </p>
      </div>
    </div>
  </section>

  <LiveMetrics />

  <section class="section" id="shared" aria-labelledby="shared-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Privacy</p>
          <h2 class="h-section" id="shared-h">What leaves your inbox</h2>
          <p class="lede">
            Two things, and only once you switch the network on. Your customers' messages and personal details stay
            with you.
          </p>
        </div>
      </div>

      <dl class="glass spec">
        {
          shared.map((n) => (
            <div class="row-spec">
              <dt>{n.k}</dt>
              <dd>{n.v}</dd>
            </div>
          ))
        }
      </dl>

      <p class="fine">
        The network keeps the counts for 90 days, each receipt for 540 days, and each business's totals for good.
        Switch it off and nothing more is sent.
      </p>
      <p class="more">
        <a class="link" href="/privacy/">Every detail, on the privacy page</a>
      </p>
    </div>
  </section>

  <section class="section" id="open" aria-labelledby="open-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Open</p>
          <h2 class="h-section" id="open-h">Launch your own network</h2>
          <p class="lede">Anyone can run one: a trade body, a city, a franchise, a marketplace.</p>
        </div>
      </div>

      <div class="says">
        <p>
          Your inbox makes just three kinds of web request to a network: one to register, an hourly ping, and one to
          send receipts. Any directory that answers them works, and you choose which in Settings. surfingdog.ai runs the
          first one.
        </p>
        <p>
          The protocol is open, and the reputation rules will be published with it, so any network can rank the same
          way or its own way.
        </p>
        <p>
          Soon an inbox will join several networks at once: it will report to each, and show what each one says about a
          customer.
        </p>
      </div>

      <p class="more">
        <a class="link" href="/docs/concepts/#networks">How networks work, in the docs</a>
      </p>
    </div>
  </section>

  <section class="section" id="join" aria-labelledby="join-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Get started</p>
          <h2 class="h-section" id="join-h">Join the network</h2>
          <p class="lede">One switch in your inbox's Settings.</p>
        </div>
      </div>

      <div class="says">
        <p>
          Open Settings, and under <b>Network</b>, switch on <b>Join the directory</b>. Your inbox needs a public https address so
          the network can check it's yours. The rest happens on its own.
        </p>
      </div>

      <div class="glass panel cta">
        <p class="position">
          <span class="u-line" aria-hidden="true"></span>
          <span>No inbox yet? Set one up first. Joining is one switch after that.</span>
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/install/">Get your inbox</a>
          <a class="btn btn-secondary" href="/docs/concepts/#networks">How joining works</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The same two columns as the home page's hero, on the same tokens: the words
     take 1.15 parts and the drawing 1, both starting at the top. Below 900px it
     is one column and the drawing follows the words. */
  .top {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  @media (min-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--sp-8);
    }
  }

  .contents {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
  }

  .says {
    display: grid;
    gap: var(--sp-4);
  }
  .says p {
    max-width: var(--measure);
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }

  .more {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-card);
  }

  .cards {
    margin: var(--sp-6) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .cards.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card .eyebrow + .h-card {
    margin-top: var(--sp-1);
  }
  .card .card-text {
    margin-top: var(--sp-2);
  }

  .spec {
    display: grid;
    gap: 0;
    margin: 0;
    padding: var(--sp-1) var(--sp-5);
    border-radius: var(--radius-card);
  }
  .row-spec {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--sp-1) var(--sp-4);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .row-spec:first-child {
    border-top: 0;
  }
  @media (max-width: 660px) {
    .row-spec {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
  .spec dt {
    font-size: var(--fs-card);
    font-weight: 600;
    color: var(--ink);
  }
  .spec dd {
    margin: 0;
    min-width: 0;
    max-width: var(--measure-card);
    font-size: var(--fs-card);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }

  /* The ranking note is linked from the directory page, so its anchor lands below the sticky nav. */
  .order {
    scroll-margin-top: 88px;
  }
  .order .card-text {
    margin-top: var(--sp-3);
  }

  .cta {
    margin-top: var(--sp-6);
  }
  .position {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: center;
    max-width: 54ch;
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: var(--lh-ui);
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin-top: var(--sp-5);
  }
</style>
