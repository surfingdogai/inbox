---
// apps/site/src/pages/network.astro
// The network, explained for a busy owner or an agent developer in about a minute: what it is,
// how joining works, how the track record works (promises kept, broken or still open; live for businesses, paused for customers),
// what a door's history shows (#door-history, which result pages link to), what leaves an inbox, and
// that anyone can run one. LiveMetrics carries the live numbers, so the fetch, the fallback and the
// refresh live in one place. Its note says what an instance reports "is set out below", so it has
// to sit above the "What leaves your inbox" section. The top is a two-column hero like the home
// page's: the words on the left, NetworkFlow on the right in the same .art-box, stacked on a phone
// with the drawing after the words.
import LiveMetrics from "../components/LiveMetrics.astro";
import NetworkFlow from "../components/NetworkFlow.astro";
import Layout from "../layouts/Layout.astro";
import { DOOR_SHARE_SHOWN, doorHistoryShows } from "../lib/door-history";
import { type RulesLine, rulesFallback, rulesLine } from "../lib/rules";

// The rules in force, read from the network when the site is built, as the trust page reads them; a build that
// cannot read them says what was published when this was written (src/lib/rules.ts).
let rules: RulesLine = rulesFallback();
try {
  const res = await fetch("https://network.surfingdog.ai/v1/ranking", {
    headers: { accept: "application/json" },
    signal: AbortSignal.timeout(4000),
  });
  if (res.ok) rules = rulesLine(await res.json()) ?? rules;
} catch {
  // Keep the fallback.
}

const contents = [
  { href: "#how", label: "How it works" },
  { href: "#reputation", label: "Track record" },
  { href: "#network", label: "Live numbers" },
  { href: "#shared", label: "What leaves your inbox" },
  { href: "#open", label: "Launch your own" },
  { href: "#join", label: "Join" },
];

const steps = [
  {
    title: "Join",
    text: "A hosted inbox joins the day it goes live; one you run yourself has it switched on at setup. The network checks the address is really yours by reading your inbox's public profile there. Then you're listed.",
  },
  {
    title: "Get found by agents",
    text: "Agents search the directory by what you do, where you are, and what you take: bookings, orders, quotes or messages. Your listing shows the languages you answer in and how to reach you.",
  },
  {
    title: "Build a record",
    text: "When a booking is confirmed or an order is paid, your inbox makes a receipt: a signed note of that promise. Each one goes to the network and is counted on your listing. Your record is built from them.",
  },
];

const principles = [
  {
    title: "For businesses",
    text: "A promise counts when it closes: the booking happened, the order arrived, or it didn't. Your inbox reports each outcome for you, signed. Your score counts only what you can't make up in your favour: kept promises your customers confirmed, and promises broken, left open or closed late. It is estimated cautiously, so a small shop that always delivers can rank above a big one that sometimes doesn't.",
  },
  {
    title: "For customers",
    text: "Each person will have one record, and it goes with them whichever agent they use. No sign-up: the first time they book, the inbox gets their key (a secret that proves it's them) from the network and passes it to their agent. Keys are issued today, but scoring is paused until its privacy safeguards are finished, so nobody has a record yet. Then each business will reward good customers its own way, like instant confirmation or no deposit.",
  },
  {
    title: "Both ways",
    text: "A kept promise counts once the network can check that the customer's agent signed it, through a platform key it recognises or a customer whose record is established; neither exists yet, so today every kept promise is the business's own word, shown as its counts and never scored. Recent months weigh most, and nothing is ever forgotten. Once customer records start, a good customer's word will count more when judging a business, and a good business's when judging a customer.",
  },
];

const visibility = [
  {
    k: "A business's record",
    v: "Public, on its listing: a count of how its promises ended, from its first receipt; its promises kept, broken and still open, counted each night under a published version of the rules, as its own word, with no score, until at least 3 different customers have confirmed its kept promises, and its score from then on; and its track record (those counts, over which dates) once at least 5 promises have closed.",
  },
  {
    k: "A customer's record",
    v: "Not scored yet. Once it is, a business sees it only when the customer's agent shows it.",
  },
];

const shared = [
  {
    k: "Every hour",
    v: "How many bookings, orders, quotes and messages arrived in the last day, plus your software version and what it runs on. Counts only.",
  },
  {
    k: "Every receipt",
    v: "Which promise it was (a booking confirmed, an order accepted or paid) and how it ended, when, and your reference for it. The customer is a code the network can't turn back into a person; when their assistant presented a pass, it also names that presentation, so the outcome counts for them. When known: the amount, how an order was paid, and the customer's agent's signature.",
  },
  {
    k: "A new customer's email",
    v: "With their first booking or order, so the network can give them a key; your inbox emails it to them. The network keeps a coded form of the address, never the address. You can switch this off.",
  },
  {
    k: "A pass an agent carries",
    v: "Only to the network that issued it, with the customer's email, so the network can tell you how that customer keeps their bookings.",
  },
  {
    k: "Never",
    v: "Messages, names, phone numbers, postal addresses, what was ordered, payment references.",
  },
];
---

<Layout
  title="An open directory AI assistants can search · Surfing Dog"
  description="A directory of businesses that AI agents can search. A hosted inbox joins the day it goes live, one you run yourself asks during setup, and the network records the receipts your inbox signs, never your messages. Nobody can buy a place: the order comes from promises kept."
>
  <section class="wrap section is-head top" aria-labelledby="page-h">
    <div class="copy">
      <p class="eyebrow">The network</p>
      <h1 class="h-page" id="page-h">Where AI agents find your business</h1>
      <p class="lede">
        The network is a directory of businesses. When someone asks an assistant like ChatGPT, Claude or Gemini to book
        or order something, the assistant can search here for a business that does it, then deals with that business
        directly. A hosted inbox joins network.surfingdog.ai the day it goes live; one you run yourself asks during
        setup. Switch any network off in Settings → Networks. The network records the receipts your inbox signs, never
        your messages.
      </p>
      <nav class="contents" aria-label="On this page">
        {contents.map((c) => <a class="btn btn-secondary btn-sm" href={c.href}>{c.label}</a>)}
      </nav>
    </div>
    <div class="art-box">
      <NetworkFlow />
    </div>
  </section>

  <section class="section" id="how" aria-labelledby="how-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 class="h-section" id="how-h">Three steps</h2>
          <p class="lede">Join, and you are listed where agents search. Each booking and order, and whether it was kept, goes on your record.</p>
        </div>
      </div>

      <ol class="grid-cards cards three" data-reveal="stagger">
        {
          steps.map((s, i) => (
            <li class="glass card">
              <p class="eyebrow">Step {i + 1}</p>
              <h3 class="h-card">{s.title}</h3>
              <p class="card-text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="reputation" aria-labelledby="reputation-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Track record</p>
          <h2 class="h-section" id="reputation-h">Earned by keeping promises</h2>
          <p class="lede">Customer records are paused until their privacy safeguards are finished.</p>
        </div>
        <span class="pill">Live for businesses</span>
      </div>

      <ul class="grid-cards cards three" data-reveal="stagger">
        {
          principles.map((p) => (
            <li class="glass card">
              <h3 class="h-card">{p.title}</h3>
              <p class="card-text">{p.text}</p>
            </li>
          ))
        }
      </ul>

      <dl class="glass spec" aria-label="Who sees a record">
        {
          visibility.map((n) => (
            <div class="row-spec">
              <dt>{n.k}</dt>
              <dd>{n.v}</dd>
            </div>
          ))
        }
      </dl>

      <div class="glass panel order" id="ranking">
        <h3 class="h-card">Nobody can buy a place</h3>
        <p class="card-text">
          Not now, and not later.
        </p>
        <p class="card-text">
          <b>{rules.now}</b> A search's words come first: the businesses they match best go ahead. Then businesses
          whose inbox has answered for 30 days without a break, then those with other live agent doors, by what an AI
          can do through them. Within each, a business whose record of kept promises reaches 0.40, confirmed by at least
          3 different customers, is ranked by it, and the rest are shuffled once a day. Every 5th place goes to a
          newcomer whose inbox answers. Near a place, the same order applies inside the distance the agent asks for.
          Inboxes report kept and broken promises as they close, and the network scores every record each night.
          <a class="link" href="https://github.com/surfingdogai/inbox/blob/main/docs/adr/017-reputation-and-ranking.md" rel="noopener">Read the full rules</a>.
        </p>
        <p class="card-text">
          Every rule is published at network.surfingdog.ai/v1/ranking, with a version number, before it counts.
        </p>
        <p class="more">
          <a class="link" href="https://network.surfingdog.ai/v1/ranking" rel="noopener">Today's rules, as agents read them</a>
        </p>
      </div>

      <div class="glass panel order" id="door-history">
        <h3 class="h-card">Door history</h3>
        <p class="card-text">
          The network reads the doors businesses publish for AI agents: members' and claimed listings' every day,
          the rest when it crawls. It keeps a line a day per door of what its own reads found, for good. No agent's
          report goes into it, and a site that opts out at <a class="link" href="/bot">surfingdog.ai/bot</a> has it
          deleted at once.
        </p>
        <p class="card-text">{doorHistoryShows(DOOR_SHARE_SHOWN)}</p>
        <p class="more">
          <a class="link" href="https://github.com/surfingdogai/inbox/blob/main/docs/adr/020-door-history.md" rel="noopener"
            >The full rule (ADR-020)</a
          >
        </p>
      </div>
    </div>
  </section>

  <LiveMetrics />

  <section class="section" id="shared" aria-labelledby="shared-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Privacy</p>
          <h2 class="h-section" id="shared-h">What leaves your inbox</h2>
          <p class="lede">
            Only once you switch the network on. Your customers' messages, names and what they ordered stay with you;
            an email address goes only to give a new customer a key, or with a pass their assistant presents.
          </p>
        </div>
      </div>

      <dl class="glass spec">
        {
          shared.map((n) => (
            <div class="row-spec">
              <dt>{n.k}</dt>
              <dd>{n.v}</dd>
            </div>
          ))
        }
      </dl>

      <p class="fine">
        The network keeps the hourly counts for 90 days, and every receipt for good, so a record is never lost.
        Switch it off and nothing more is sent.
      </p>
      <p class="more">
        <a class="link" href="/privacy/">Every detail, on the privacy page</a>
      </p>
    </div>
  </section>

  <section class="section" id="open" aria-labelledby="open-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Open</p>
          <h2 class="h-section" id="open-h">Launch your own network</h2>
          <p class="lede">Anyone can run one: a trade body, a city, a franchise, a marketplace.</p>
        </div>
      </div>

      <div class="says">
        <p>
          Your inbox makes just three kinds of web request to a network: one to register, an hourly ping, and one to
          send receipts. Any directory that answers them works, and you choose which in Settings. We run one at
          network.surfingdog.ai.
        </p>
        <p>
          The protocol is open, and the ranking rules are published with it, so any network can rank the same way
          or its own way.
        </p>
        <p>
          To start one, the
          <a class="link" href="https://github.com/surfingdogai/inbox/tree/main/examples/network" rel="noopener">example network</a>
          is Node and one SQLite file: it verifies inboxes, lists them and keeps their receipts.
          <a class="link" href="https://github.com/surfingdogai/inbox/tree/main/packages/network-check" rel="noopener">network-check</a>
          tells you whether yours follows the protocol before anyone joins it.
        </p>
        <p>
          An inbox can join several networks at once, in Settings → Networks: it reports to each, and shows your record
          at each one.
        </p>
      </div>

      <p class="more">
        <a class="link" href="/docs/concepts/#networks">How networks work, in the docs</a>
      </p>
    </div>
  </section>

  <section class="section" id="join" aria-labelledby="join-h" data-reveal>
    <div class="wrap wrap-read">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Get started</p>
          <h2 class="h-section" id="join-h">Join the network</h2>
          <p class="lede">On from the start.</p>
        </div>
      </div>

      <div class="says">
        <p>
          A hosted inbox joins the day it goes live. One you run yourself offers it at the end of setup; later it is the
          switch beside <b>network.surfingdog.ai</b> in <b>Settings → Networks</b>. Your inbox needs a public https address
          so the network can check it's yours. The rest happens on its own.
        </p>
      </div>

      <div class="glass panel cta">
        <p class="position">
          <span class="u-line" aria-hidden="true"></span>
          <span>No inbox yet? Get one: it joins from the start.</span>
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/install/">Get your inbox</a>
          <a class="btn btn-secondary" href="/docs/concepts/#networks">How joining works</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* The same two columns as the home page's hero, on the same tokens: the words
     take 1.15 parts and the drawing 1, both starting at the top. Below 900px it
     is one column and the drawing follows the words. */
  .top {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  @media (min-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--sp-8);
    }
  }

  .contents {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
  }

  .says {
    display: grid;
    gap: var(--sp-4);
  }
  .says p {
    max-width: var(--measure);
    margin: 0;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }

  .more {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-card);
  }

  .cards {
    margin: var(--sp-6) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .cards.three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .card .eyebrow + .h-card {
    margin-top: var(--sp-1);
  }
  .card .card-text {
    margin-top: var(--sp-2);
  }

  .spec {
    display: grid;
    gap: 0;
    margin: 0;
    padding: var(--sp-1) var(--sp-5);
    border-radius: var(--radius-card);
  }
  .row-spec {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--sp-1) var(--sp-4);
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--hairline);
  }
  .row-spec:first-child {
    border-top: 0;
  }
  @media (max-width: 660px) {
    .row-spec {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
  .spec dt {
    font-size: var(--fs-card);
    font-weight: 600;
    color: var(--ink);
  }
  .spec dd {
    margin: 0;
    min-width: 0;
    max-width: var(--measure-card);
    font-size: var(--fs-card);
    line-height: var(--lh-body);
    color: var(--ink-2);
  }

  /* The ranking note is linked from the directory page, and the door history note from result pages, so
     their anchors land below the sticky nav. */
  .order {
    scroll-margin-top: 88px;
  }
  .order .card-text {
    margin-top: var(--sp-3);
  }

  .cta {
    margin-top: var(--sp-6);
  }
  .position {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: center;
    max-width: 54ch;
    margin: 0;
    font-size: var(--fs-body);
    font-weight: 600;
    line-height: var(--lh-ui);
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin-top: var(--sp-5);
  }
</style>
