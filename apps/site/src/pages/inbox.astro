---
/**
 * The inbox's own product page. These sections were the home page before the home page became the
 * network; the waitlist form for the hosted inbox lives here, at /inbox/#run.
 */
import ForAgents from "../components/ForAgents.astro";
import Inbox from "../components/Inbox.astro";
import InboxHero from "../components/InboxHero.astro";
import Rules from "../components/Rules.astro";
import Run from "../components/Run.astro";
import UseCases from "../components/UseCases.astro";
import Why from "../components/Why.astro";
import Layout from "../layouts/Layout.astro";

const site = Astro.site?.toString() ?? "https://surfingdog.ai/";
const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Surfing Dog Inbox",
  description:
    "An open-source inbox a business runs itself, at its own address, on its own Cloudflare account or server: people and AI agents send bookings, orders, quote requests and messages straight to the business over MCP, REST or email, and the business's rules answer them or pass them to a person. Surfing Dog is not in the middle.",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: new URL("/inbox/", site).toString(),
  downloadUrl: "https://github.com/surfingdogai/inbox",
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  publisher: { "@id": `${site}#org` },
};
---

<Layout
  title="Surfing Dog Inbox · Get AI bookings, orders and messages."
  description="Your own open-source inbox, at your own address, for the bookings, orders and messages that AI agents send your business. They come straight to you; your rules answer the routine ones, and you see the rest."
  image="/art/og-inbox-v1.png"
  ld={ld}
>
  <InboxHero />
  <Why />
  <Rules />
  <UseCases />
  <Inbox />
  <Run />
  <ForAgents />
</Layout>
